---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/sections/Hero.astro";
import Problem from "@/components/sections/Problem.astro";
import NodeTypes from "@/components/sections/NodeTypes.astro";
import MoreFeatures from "@/components/sections/MoreFeatures.astro";
import Audience from "@/components/sections/Audience.astro";
import UseCasesTeaser from "@/components/sections/UseCasesTeaser.astro";
import Faq from "@/components/sections/Faq.astro";
import FinalCta from "@/components/sections/FinalCta.astro";
import StickyFeatureScroll from "@/components/sections/StickyFeatureScroll.astro";
import InlineCta from "@/components/ui/InlineCta.astro";
import { featureSteps } from "@/data/features";

// The landing page, in the order it argues: the promise and the canvas,
// what our tools turned us into, the gestures Nolënor gives back, the
// materials, the depth, a person at work, who it is for, the questions and
// the close.
//
// Each section draws its own seam (a hairline, a change of paper, or just
// air) so the page does not part every chapter the same way. The two quiet
// one-liners sit between hairlines of their own and carry no button:
// asking four times with a button would be nagging, and this page's whole
// argument is that it doesn't push you.
//
// Anchors: #features, #nodes, #who-its-for and #faq are the four ids
// src/data/nav.ts points at. Moving or renaming a section here means
// updating that file.
---

<Layout>
  <Hero />
  <Problem />
  <StickyFeatureScroll id="features" steps={featureSteps} />
  <InlineCta text="Reading about a canvas only goes so far." action="Open a canvas" />
  <NodeTypes />
  <MoreFeatures />
  <InlineCta
    text="All of this is free while we're in beta."
    action="Try it for free"
  />
  <UseCasesTeaser />
  <Audience />
  <Faq />
  <FinalCta />
</Layout>
