---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/sections/Hero.astro";
import ProblemFraming from "@/components/sections/ProblemFraming.astro";
import Capabilities from "@/components/sections/Capabilities.astro";
import FeatureScrollSection from "@/components/sections/FeatureScrollSection.astro";
import HowItWorks from "@/components/sections/HowItWorks.astro";
import FeatureGrid from "@/components/sections/FeatureGrid.astro";
import Faq from "@/components/sections/Faq.astro";
import FinalCta from "@/components/sections/FinalCta.astro";
import MediaFrame from "@/components/ui/MediaFrame.astro";
import CodeBlock from "@/components/ui/CodeBlock.astro";

const mcpConfigSnippet = `{
  "mcpServers": {
    "nolenor": {
      "url": "https://app.nolenor.com/mcp",
      "headers": {
        "Authorization": "Bearer nlnr_your_api_token"
      }
    }
  }
}`;
---

<Layout>
  <Hero />
  <ProblemFraming />
  <Capabilities />

  <div id="features" class="scroll-mt-20">
    <FeatureScrollSection
      eyebrow="The canvas"
      title="One canvas. Nothing hidden."
      description="Documents, tables, images, PDFs, embeds, KPIs, audio — 11 node types living side by side, always in view. Drag, resize, color-code, connect. Pop any node into its own window when you need to focus, without ever losing sight of the rest."
      bullets={[
        "11 built-in node types",
        "Infinite pan & zoom canvas",
        "Windows for focused, expanded views",
        "Cmd+K search across everything, PDF pages included",
      ]}
    >
      <!--
        MEDIA: feature-canvas-nodes — 16:10, 6-10s.
        Slow pan/zoom across a busy canvas showing 4-5 node types side by
        side (Blocknote, Image, Table, Value/KPI, PDF), then one node
        dragged into an expanded window. See MEDIA_BRIEF.md.
      -->
      <MediaFrame
        id="feature-canvas-nodes"
        aspectRatio="16/10"
        alt="Canvas view with several node types arranged together, one expanding into a focused window"
      />
    </FeatureScrollSection>

    <FeatureScrollSection
      eyebrow="Meet Nolë"
      title="Watch every step. Not just the answer."
      description="Every tool call and reasoning step streams inline, in real time — you see exactly what Nolë is doing, not just what it decided. @mention any node to pull it into context, and watch sub-agents work in parallel on other nodes without ever blocking you."
      bullets={[
        "Transparent tool-call & reasoning trace",
        "@mention nodes as context",
        "Parallel sub-agent delegation, never blocking",
        "Pick your model, see the cost per thread",
      ]}
      reverse
    >
      <!--
        MEDIA: feature-nole-agent — 16:10, 8-12s.
        Chat panel: @mention two nodes, send a message, tool-call chips
        appear one by one, then a sub-agent indicator shows work
        happening on another node in the background. See MEDIA_BRIEF.md.
      -->
      <MediaFrame
        id="feature-nole-agent"
        aspectRatio="16/10"
        alt="Nolë chat panel streaming a response with visible tool calls and a background sub-agent indicator"
      />
    </FeatureScrollSection>

    <FeatureScrollSection
      eyebrow="Beyond text"
      title="Don't describe the dashboard. Watch it get built."
      description="Nolë doesn't just talk about a chart — it writes and runs one, live, on your canvas, wired to your data. Break it, and you'll watch Nolë catch its own error and fix the code — no bug report required."
      bullets={[
        "Live interactive apps generated on your canvas",
        "Wired directly to your other nodes' data",
        "Self-healing: errors caught and fixed, visibly",
        "Built-in charting",
      ]}
      featured
    >
      <!--
        MEDIA: feature-mini-apps — 16:9, 10-15s. Highest "wow" clip.
        An App node generates a live chart from connected data; show a
        brief error state; the self-healing loop fixes it without user
        action. See MEDIA_BRIEF.md.
      -->
      <MediaFrame
        id="feature-mini-apps"
        aspectRatio="16/9"
        alt="An AI-generated mini-app rendering a live chart on the canvas, recovering automatically from an error"
      />
    </FeatureScrollSection>

    <FeatureScrollSection
      eyebrow="Nothing is ever lost"
      title="Every change, visible. Every reason, traceable."
      description="Every edit — yours or Nolë's — is checkpointed automatically. Restore any node to any prior state in one click. And when you're wondering why something changed, jump straight to the exact conversation that made the edit."
      bullets={[
        "Automatic checkpointing on every edit",
        "One-click restore, fully undoable",
        "Jump from any node to the AI conversation that changed it",
        "Versions survive deletion — a built-in safety net",
      ]}
      reverse
    >
      <!--
        MEDIA: feature-version-history — 16:10, 6-10s.
        Open a node's version history, click through 2-3 prior versions,
        then "jump to conversation" into the AI thread that made a
        change. See MEDIA_BRIEF.md.
      -->
      <MediaFrame
        id="feature-version-history"
        aspectRatio="16/10"
        alt="Version history panel for a node, restoring a prior version and jumping to the conversation that created it"
      />
    </FeatureScrollSection>

    <FeatureScrollSection
      eyebrow="Built for teams"
      title="Real-time — and everyone sees it."
      description="Share a canvas by email with viewer, editor, or owner access, and every change appears live for everyone — no refresh, no merge conflicts, nothing happening off-screen. Need to show your work to the world? Flip a canvas public and share a link, no invite required."
      bullets={[
        "Real-time multiplayer, native",
        "Three permission tiers: viewer, editor, owner",
        "Public, read-only share links",
        "Revoke access anytime",
      ]}
    >
      <!--
        MEDIA: feature-collaboration — 16:10, 6-10s.
        Share modal: add a collaborator as "editor"; a second live edit
        appears on the canvas; toggle a canvas public and copy the link.
        See MEDIA_BRIEF.md.
      -->
      <MediaFrame
        id="feature-collaboration"
        aspectRatio="16/10"
        alt="Sharing modal granting editor access, with a second collaborator's edit appearing live on the canvas"
      />
    </FeatureScrollSection>

    <FeatureScrollSection
      eyebrow="Your data, your control"
      title="Nothing locked in a black box."
      description="Export a single canvas or everything you own, any time — as clean Markdown, lossless JSON, and human-readable summaries, zipped and built right in your browser. No support ticket, no waiting on a data export job, nothing hidden behind a paywall."
      bullets={[
        "One-click export, single canvas or full account",
        "Markdown + JSON, lossless structure",
        "Built client-side — nothing sits on a server",
        "No lock-in, ever",
      ]}
      reverse
    >
      <!--
        MEDIA: feature-export — 16:10, 6-10s.
        Open the export panel, choose "export this canvas," show the
        client-side zip progress, then the resulting folder structure
        (README.md, canvas.json, nodes/*.md). See MEDIA_BRIEF.md.
      -->
      <MediaFrame
        id="feature-export"
        aspectRatio="16/10"
        alt="Export panel building a zip client-side, then the resulting folder of Markdown and JSON files"
      />
    </FeatureScrollSection>

    <FeatureScrollSection
      eyebrow="For developers"
      title="Open the hood. Nolenor speaks MCP."
      description="Connect Claude Code, Claude Desktop, or any MCP client straight to your workspace. List canvases, read and search nodes, create and edit content — governed by scoped, revocable API tokens you control."
      bullets={[
        "Native MCP server, stateless streamable HTTP",
        "Scoped read/write API tokens",
        "Every internal agent tool exposed, one source of truth",
        "Revoke access in one click",
      ]}
    >
      <CodeBlock code={mcpConfigSnippet} filename="claude_desktop_config.json" />
    </FeatureScrollSection>
  </div>

  <HowItWorks />
  <FeatureGrid />
  <Faq />
  <FinalCta />
</Layout>
