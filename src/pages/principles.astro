---
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/ui/Container.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import { GITHUB_REPO_URL, SITE_NAME } from "@/lib/constants";

/*
 * "How we build Nolënor": the manifesto turned into decisions.
 *
 * The audit of Capacities' site on the Nolënor canvas recommends a short
 * principles page made only of principles that are really held, each one
 * checkable. So every principle here comes with its proof: a thing the
 * product does today (verified in the app repo), never a promise. The
 * positioning note's own rule applies: never announce what isn't ready.
 *
 * The second half is "what Nolënor isn't", taken from the positioning
 * note's "Ce qu'on n'est pas". Shapes, not brands: no competitor is named.
 */

const principles = [
  {
    title: "The canvas is the interface.",
    body: "A thought has a shape. Pages inside pages and a scrolling chat both flatten it. We give it a space where things can sit side by side, be linked, and be pointed at.",
    proof: "Every kind of content is a node on the same canvas: documents, tables, PDFs, images, audio, video, links, apps.",
  },
  {
    title: "It works without AI.",
    body: "The carpenter's test: if the AI goes off, you can still do the work. Nolënor has to be a good place to think on its own, before it's a good place to think with an agent.",
    proof: "Documents, tables, links, files: everything you put on the canvas can be created, edited, linked and searched by hand.",
  },
  {
    title: "You choose what the apprentice sees.",
    body: "Context is the most important thing you give an agent, so it should be a gesture, not a paragraph. You show; it looks where you point.",
    proof: "Nolë doesn't read the whole canvas by default. You mention a node with @, or Alt-click a node or a spot to hand it over.",
  },
  {
    title: "The work is shown, not reported.",
    body: "An agent that disappears and comes back with a result asks you to trust it. One you can watch lets you steer it before it builds the cathedral.",
    proof: "Each step and each tool call streams live, and what Nolë makes lands as nodes on the canvas, next to yours.",
  },
  {
    title: "Every change can be traced and undone.",
    body: "Staying in touch with the work means knowing who touched what. That matters most when one of the hands isn't yours.",
    proof: "Each node keeps its versions, with Nolë's edits set apart from yours, and any earlier version restores in one click.",
  },
  {
    title: "Your thinking leaves with you.",
    body: "A tool you can't leave isn't a tool, it's a dependency. Your work has to stay readable outside of Nolënor.",
    proof: "Export in open formats (Markdown, JSON, CSV), canvases open to other assistants over MCP, and the source code is public.",
  },
  {
    title: "Do less, but do it right.",
    body: "Craft is knowing what you won't do. That goes for the product as much as for the work: we'd rather ship a few things that hold than a wall of buttons.",
    proof: "If this site says Nolënor does something, it does it today. What isn't ready yet is marked as such.",
  },
];

const notThis = [
  {
    title: "Not another chat box.",
    body: "The chat is a fine way to ask a question and a poor place to work. In Nolënor the conversation serves the canvas, not the other way round.",
  },
  {
    title: "Not an agent factory.",
    body: "No army of agents churning out work for you to review in the morning. Nolë works on what you show it, and everything it does stays on the canvas where you can read it.",
  },
  {
    title: "Not a filing cabinet.",
    body: "We won't make you decide where something goes before you know what it is. Set it down; search and links find it again.",
  },
  {
    title: "Not a whiteboard you throw away.",
    body: "A canvas for work that lasts: real documents, real data, history on every node. Not a pretty board that dies after the meeting.",
  },
  {
    title: "Not for everyone.",
    body: "It's for people with a craft who want to widen it, not hand it off. If you're looking for AI to do the job in your place, other tools will suit you better.",
  },
];
---

<Layout
  title={`Principles — ${SITE_NAME}`}
  description="How we build Nolënor: seven principles, each with the proof that it's held in the product today, and what Nolënor deliberately isn't."
>
  <section class="pt-14 pb-14 sm:pt-24 sm:pb-20">
    <Container class="flex flex-col items-center gap-6 text-center">
      <SectionLabel>Principles</SectionLabel>
      <h1 class="max-w-3xl font-serif text-4xl leading-[1.15] text-balance text-foreground sm:text-5xl lg:text-6xl">
        How we build Nolënor.
      </h1>
      <p class="max-w-2xl text-lg text-pretty text-muted-foreground">
        The <a href="/manifesto" class="font-semibold text-brand underline-offset-4 hover:underline">manifesto</a>{" "}
        says what we believe. These are the decisions that follow from it, each
        with the proof that it holds in the product today.
      </p>
    </Container>
  </section>

  <hr class="border-border" />

  <Container class="py-16 sm:py-24">
    <ol class="mx-auto flex max-w-4xl flex-col">
      {
        principles.map((principle, index) => (
          <li
            class="grid gap-x-10 gap-y-4 border-b border-border py-10 first:pt-0 last:border-b-0 md:grid-cols-[4rem_minmax(0,1fr)_minmax(0,0.85fr)]"
            data-reveal
          >
            <span class="font-serif text-3xl leading-none text-brand/50">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div class="flex flex-col gap-3">
              <h2 class="text-[1.75rem] text-balance text-foreground">{principle.title}</h2>
              <p class="text-base leading-[1.7] text-pretty text-muted-foreground">{principle.body}</p>
            </div>
            <div class="proof self-start rounded-xl px-4 py-3.5 md:mt-1.5">
              <p class="mb-1.5 flex items-center gap-1.5 text-xs font-bold tracking-wide text-brand uppercase">
                <Icon name="lucide:check" class="h-3.5 w-3.5" />
                In the product
              </p>
              <p class="text-[0.92rem] leading-relaxed text-pretty text-foreground/85">{principle.proof}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Container>

  <hr class="border-border" />

  <section class="py-16 sm:py-24">
    <Container>
      <div class="mx-auto flex max-w-2xl flex-col items-center gap-4 text-center">
        <SectionLabel>What it isn't</SectionLabel>
        <h2 class="text-balance text-foreground">Saying no is part of the craft.</h2>
        <p class="text-lg text-pretty text-muted-foreground">
          A precise tool for precise people. Here's what Nolënor deliberately
          isn't, so you can tell quickly whether it's for you.
        </p>
      </div>

      <dl class="mx-auto mt-12 flex max-w-5xl flex-wrap justify-center gap-4">
        {
          notThis.map((item) => (
            <div class="flex w-full flex-col gap-2 rounded-2xl border border-border bg-surface p-6 sm:w-[calc(50%-0.5rem)] lg:w-[calc(33.333%-0.667rem)]" data-reveal>
              <dt class="font-serif text-xl text-foreground">{item.title}</dt>
              <dd class="text-[0.95rem] leading-relaxed text-pretty text-muted-foreground">{item.body}</dd>
            </div>
          ))
        }
      </dl>
    </Container>
  </section>

  <section class="pb-20 sm:pb-28">
    <Container>
      <div class="mx-auto flex max-w-2xl flex-col items-center gap-4 text-center">
        <p class="font-serif text-2xl leading-snug text-balance text-foreground sm:text-3xl">
          Think we're not living up to one of these? Tell us.
        </p>
        <p class="text-pretty text-muted-foreground">
          Principles are only worth something if someone can hold us to them.
        </p>
        <a
          href={`${GITHUB_REPO_URL}/issues`}
          class="group mt-2 inline-flex items-center gap-1.5 font-semibold text-brand underline-offset-4 hover:underline"
          rel="noopener noreferrer"
        >
          Open an issue on GitHub
          <Icon name="lucide:arrow-right" class="h-4 w-4 transition-transform duration-200 motion-safe:group-hover:translate-x-0.5" />
        </a>
      </div>
    </Container>
  </section>
</Layout>

<style>
  .proof {
    background: color-mix(in srgb, var(--brand) 8%, #ffffff);
  }
</style>
