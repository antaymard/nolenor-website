---
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/ui/Container.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import CodeBlock from "@/components/ui/CodeBlock.astro";
import {
  mcpReadTools,
  mcpWriteTools,
  nodeDataFields,
  apiErrors,
} from "@/data/developers";
import {
  APP_API_TOKENS_URL,
  GITHUB_REPO_URL,
  MCP_ENDPOINT,
  REST_API_BASE,
  SITE_NAME,
} from "@/lib/constants";

/*
 * Developers: connecting an AI tool over MCP, and calling the REST API.
 *
 * Same one-page shape as /help, for the same reason: there isn't enough
 * surface yet to justify a docs site, and everything a developer needs
 * before the first call fits on one scroll. Order is the order of need —
 * a token first, since both paths start there, then MCP (what most
 * readers came for), then the REST API.
 */

const toc = [
  { id: "token", label: "Get a token" },
  { id: "mcp", label: "Connect over MCP" },
  { id: "tools", label: "MCP tools" },
  { id: "rest", label: "REST API" },
  { id: "errors", label: "Errors" },
];

const claudeCodeCommand = `claude mcp add --transport http nolenor \\
  ${MCP_ENDPOINT} \\
  --header "Authorization: Bearer nlnr_..." \\
  --scope user`;

const mcpJsonConfig = `{
  "mcpServers": {
    "nolenor": {
      "type": "http",
      "url": "${MCP_ENDPOINT}",
      "headers": { "Authorization": "Bearer nlnr_..." }
    }
  }
}`;

const claudeDesktopConfig = `URL      ${MCP_ENDPOINT}
Header   x-api-key: nlnr_...`;

const idReference = `canvasId:k17abc...|nodeIds:n1a2b3,n4c5d6`;

const curlGet = `curl "${REST_API_BASE}/node-datas?canvasId=k17abc...&nodeIds=n1a2b3,n4c5d6" \\
  -H "Authorization: Bearer $NOLENOR_TOKEN"`;

const curlPost = `curl -X POST "${REST_API_BASE}/node-datas" \\
  -H "Authorization: Bearer $NOLENOR_TOKEN" \\
  -H "Content-Type: application/json" \\
  -d '{ "canvasId": "k17abc...", "nodeIds": ["n1a2b3", "n4c5d6"] }'`;

const fetchExample = `const res = await fetch("${REST_API_BASE}/node-datas", {
  method: "POST",
  headers: {
    Authorization: \`Bearer \${process.env.NOLENOR_TOKEN}\`,
    "Content-Type": "application/json",
  },
  body: JSON.stringify({ canvasId: "k17abc...", nodeIds: ["n1a2b3"] }),
});
if (!res.ok) throw new Error((await res.json()).error.message);
const { nodeDatas, notFound } = await res.json();`;

const responseExample = `{
  "nodeDatas": [
    {
      "nodeId": "n1a2b3",
      "nodeDataId": "j57xyz...",
      "type": "blocknote",
      "values": { "...": "..." },
      "updatedAt": 1760781234567
    }
  ],
  "notFound": ["n4c5d6"]
}`;

const errorExample = `{ "error": { "code": "bad_request", "message": "Missing canvasId." } }`;
---

<Layout
  title={`Developers — ${SITE_NAME}`}
  description="Connect Claude, Cursor or any MCP client to your Nolënor canvases, and read their content over the REST API."
>
  <section class="pt-14 pb-14 sm:pt-24 sm:pb-20">
    <Container class="flex flex-col items-center gap-6 text-center">
      <SectionLabel>Developers</SectionLabel>
      <h1 class="max-w-3xl font-serif text-4xl leading-[1.15] text-balance text-foreground sm:text-5xl lg:text-6xl">
        Your canvases, from any tool.
      </h1>
      <p class="max-w-2xl text-lg text-pretty text-muted-foreground">
        Plug Claude, Cursor or any MCP client into your canvases so it reads
        and edits them like Nolë does. Or call the REST API from your own
        scripts. One token, your rights, nothing more.
      </p>

      <nav aria-label="Page sections" class="mt-2 flex flex-wrap justify-center gap-2">
        {
          toc.map((item, index) => (
            <a
              href={`#${item.id}`}
              class="group inline-flex items-center gap-2 rounded-full border border-border bg-surface/70 px-4 py-2 text-sm font-medium text-foreground/80 transition-colors hover:border-brand/40 hover:text-foreground focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
            >
              <span class="font-serif text-brand">{String(index + 1).padStart(2, "0")}</span>
              {item.label}
            </a>
          ))
        }
      </nav>
    </Container>
  </section>

  <section class="pb-16 sm:pb-20">
    <Container class="grid gap-4 md:grid-cols-2">
      <a
        href="#mcp"
        class="flex flex-col gap-3 rounded-2xl border border-border bg-surface p-6 transition-colors duration-200 hover:border-brand/30"
        data-reveal
      >
        <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-muted text-brand">
          <Icon name="lucide:plug" class="h-5 w-5" />
        </span>
        <h2 class="font-sans text-lg font-bold text-foreground">MCP server</h2>
        <p class="text-pretty text-muted-foreground">
          For AI assistants. List, read, search and edit blocks, with the same
          tools Nolë uses. Changes show up live on the canvas.
        </p>
        <code class="mt-auto w-fit rounded-md bg-muted px-2 py-1 text-xs text-foreground/80">POST /mcp</code>
      </a>
      <a
        href="#rest"
        class="flex flex-col gap-3 rounded-2xl border border-border bg-surface p-6 transition-colors duration-200 hover:border-brand/30"
        data-reveal
      >
        <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-muted text-brand">
          <Icon name="lucide:braces" class="h-5 w-5" />
        </span>
        <h2 class="font-sans text-lg font-bold text-foreground">REST API</h2>
        <p class="text-pretty text-muted-foreground">
          For your own code. Plain HTTP and JSON, versioned under{" "}
          <code class="text-sm">/api/v1</code>. Read-only for now: it returns
          the content of the blocks you ask for.
        </p>
        <code class="mt-auto w-fit rounded-md bg-muted px-2 py-1 text-xs text-foreground/80">GET /api/v1/node-datas</code>
      </a>
    </Container>
  </section>

  <hr class="border-border" />

  <Container class="grid gap-12 lg:grid-cols-[11rem_minmax(0,1fr)] lg:gap-16">
    <aside class="hidden lg:block">
      <div class="sticky top-28 py-20">
        <nav aria-label="On this page" data-help-toc>
          <p class="mb-3 text-xs font-semibold tracking-wide text-muted-foreground uppercase">
            On this page
          </p>
          <ul class="flex flex-col gap-0.5 border-l border-border">
            {
              toc.map((item) => (
                <li>
                  <a href={`#${item.id}`} class="toc-link -ml-px block border-l-2 border-transparent py-1.5 pl-4 text-sm text-muted-foreground transition-colors hover:text-foreground">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </aside>

    <div class="min-w-0">
      <section id="token" class="py-16 sm:py-20">
        <header class="flex max-w-2xl flex-col gap-4">
          <p class="text-sm font-semibold text-brand">
            <span class="font-serif">01</span>
            <span class="mx-1.5 text-brand/40">/</span>
            Get a token
          </p>
          <h2 class="text-balance text-foreground">Start in Settings.</h2>
          <p class="text-lg text-pretty text-muted-foreground">
            The MCP server and the REST API take the same API token. It acts as
            you: it opens the canvases you can open, and no others.
          </p>
        </header>

        <ol class="mt-10 flex max-w-2xl flex-col gap-5">
          <li class="flex gap-4">
            <span class="font-serif text-lg text-brand/60">1.</span>
            <p>
              In the app, open <strong>Settings → MCP & API tokens</strong>{" "}
              and click <strong>New token</strong>.
            </p>
          </li>
          <li class="flex gap-4">
            <span class="font-serif text-lg text-brand/60">2.</span>
            <p>
              Name it, then pick a permission. <strong>Read</strong> lists,
              reads and searches, and is all the REST API needs.{" "}
              <strong>Write</strong> also creates and edits blocks, on the
              canvases where you are editor or owner.
            </p>
          </li>
          <li class="flex gap-4">
            <span class="font-serif text-lg text-brand/60">3.</span>
            <p>
              Copy the token (it starts with <code>nlnr_</code>). It is shown
              once: we only keep a digest of it. The same dialog gives you the
              exact endpoint URL and a ready-to-paste Claude Code command.
            </p>
          </li>
        </ol>

        <div class="mt-8 flex max-w-2xl gap-3 rounded-2xl border border-border bg-surface p-5">
          <Icon name="lucide:shield" class="mt-0.5 h-5 w-5 shrink-0 text-brand" />
          <p class="text-[0.95rem] text-pretty text-muted-foreground">
            Treat a token like a password. If one leaks, revoke it from the same
            page: every tool using it loses access at once. The list shows when
            each token was last used.
          </p>
        </div>

        <div class="mt-8">
          <Button href={APP_API_TOKENS_URL}>
            Create a token
            <Icon name="lucide:arrow-right" class="h-4 w-4" />
          </Button>
        </div>
      </section>

      <section id="mcp" class="border-t border-border py-16 sm:py-20">
        <header class="flex max-w-2xl flex-col gap-4">
          <p class="text-sm font-semibold text-brand">
            <span class="font-serif">02</span>
            <span class="mx-1.5 text-brand/40">/</span>
            Connect over MCP
          </p>
          <h2 class="text-balance text-foreground">A second Nolë, in the tool you already use.</h2>
          <p class="text-lg text-pretty text-muted-foreground">
            Nolënor speaks the Model Context Protocol over streamable HTTP. Give
            your client the endpoint and the token, and it can work on your
            canvases.
          </p>
        </header>

        <dl class="mt-10 max-w-2xl border-t border-border">
          <div class="grid gap-x-6 gap-y-1 border-b border-border py-4 sm:grid-cols-[9rem_minmax(0,1fr)]">
            <dt class="font-semibold text-foreground">Endpoint</dt>
            <dd class="min-w-0 break-all"><code>{MCP_ENDPOINT}</code></dd>
          </div>
          <div class="grid gap-x-6 gap-y-1 border-b border-border py-4 sm:grid-cols-[9rem_minmax(0,1fr)]">
            <dt class="font-semibold text-foreground">Transport</dt>
            <dd class="text-muted-foreground">Streamable HTTP, stateless, <code>POST</code> only</dd>
          </div>
          <div class="grid gap-x-6 gap-y-1 border-b border-border py-4 sm:grid-cols-[9rem_minmax(0,1fr)]">
            <dt class="font-semibold text-foreground">Auth header</dt>
            <dd class="text-muted-foreground">
              <code>Authorization: Bearer nlnr_...</code>, or{" "}
              <code>x-api-key: nlnr_...</code>
            </dd>
          </div>
        </dl>

        <div class="mt-12 flex flex-col gap-10">
          <div class="flex flex-col gap-4">
            <div class="flex items-center gap-3">
              <h3 class="text-foreground">Claude Code</h3>
              <Badge tone="brand">One line</Badge>
            </div>
            <p class="max-w-2xl text-pretty text-muted-foreground">
              Paste this in a terminal. The token dialog in Settings prints the
              same command with your token already in it.
            </p>
            <CodeBlock code={claudeCodeCommand} filename="terminal" />
          </div>

          <div class="flex flex-col gap-4">
            <h3 class="text-foreground">Claude Desktop</h3>
            <p class="max-w-2xl text-pretty text-muted-foreground">
              Add a custom connector with the endpoint URL. Claude Desktop only
              offers preset header names, with no <code>Authorization</code>:
              pick <code>x-api-key</code> and paste the raw token as its value.
            </p>
            <CodeBlock code={claudeDesktopConfig} filename="Custom connector" />
          </div>

          <div class="flex flex-col gap-4">
            <h3 class="text-foreground">Cursor and other clients</h3>
            <p class="max-w-2xl text-pretty text-muted-foreground">
              Any client that reads an <code>mcpServers</code> JSON file (Cursor's{" "}
              <code>mcp.json</code>, a project <code>.mcp.json</code>…) takes
              this:
            </p>
            <CodeBlock code={mcpJsonConfig} filename="mcp.json" />
          </div>

          <div class="flex flex-col gap-4">
            <h3 class="text-foreground">Point it at a block</h3>
            <p class="max-w-2xl text-pretty text-muted-foreground">
              Right-click a block on the canvas, then <strong>Copy ID → Canvas &
              node ID</strong>. Paste the reference into your conversation, and
              the assistant knows exactly which canvas and block you mean.
            </p>
            <CodeBlock code={idReference} filename="clipboard" />
          </div>
        </div>
      </section>

      <section id="tools" class="border-t border-border py-16 sm:py-20">
        <header class="flex max-w-2xl flex-col gap-4">
          <p class="text-sm font-semibold text-brand">
            <span class="font-serif">03</span>
            <span class="mx-1.5 text-brand/40">/</span>
            MCP tools
          </p>
          <h2 class="text-balance text-foreground">The same hands as Nolë.</h2>
          <p class="text-lg text-pretty text-muted-foreground">
            A read token sees the first two tools, a write token sees them all.
            Every tool but <code>list_canvases</code> takes a{" "}
            <code>canvasId</code>, and every edit goes through your rights on
            that canvas.
          </p>
        </header>

        <div class="mt-12 grid gap-4 xl:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)]">
          <div class="rounded-2xl border border-border bg-surface px-5 pt-4 pb-2" data-reveal>
            <div class="mb-1 flex items-center justify-between gap-3">
              <h3 class="font-sans text-sm font-bold tracking-wide text-brand uppercase">Read</h3>
              <Badge>Read or write token</Badge>
            </div>
            <dl>
              {
                mcpReadTools.map((tool) => (
                  <div class="flex flex-col gap-1 border-t border-border/70 py-3 first:border-t-0">
                    <dt><code class="text-[0.9rem] font-semibold text-foreground">{tool.name}</code></dt>
                    <dd class="text-[0.95rem] text-pretty text-muted-foreground">{tool.body}</dd>
                  </div>
                ))
              }
            </dl>
          </div>

          <div class="rounded-2xl border border-border bg-surface px-5 pt-4 pb-2" data-reveal>
            <div class="mb-1 flex items-center justify-between gap-3">
              <h3 class="font-sans text-sm font-bold tracking-wide text-brand uppercase">Write</h3>
              <Badge tone="highlight">Write token</Badge>
            </div>
            <dl class="grid sm:grid-cols-2 sm:gap-x-6">
              {
                mcpWriteTools.map((tool) => (
                  <div class="flex flex-col gap-1 border-t border-border/70 py-3">
                    <dt><code class="text-[0.9rem] font-semibold text-foreground">{tool.name}</code></dt>
                    <dd class="text-[0.95rem] text-pretty text-muted-foreground">{tool.body}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>

        <p class="mt-8 max-w-2xl text-pretty text-muted-foreground">
          What it can't do: browse the web, generate images, transcribe audio,
          use Nolë's memory or skills, or touch your settings and sharing.
          Its edits appear as “Agent” in a block's <strong>Versions</strong>, so
          you can always take one back.
        </p>
      </section>

      <section id="rest" class="border-t border-border py-16 sm:py-20">
        <header class="flex max-w-2xl flex-col gap-4">
          <p class="text-sm font-semibold text-brand">
            <span class="font-serif">04</span>
            <span class="mx-1.5 text-brand/40">/</span>
            REST API
          </p>
          <h2 class="text-balance text-foreground">Read blocks from your own code.</h2>
          <p class="text-lg text-pretty text-muted-foreground">
            One endpoint for now: the content of up to 100 blocks of a canvas,
            in one call. Send the token with every request.
          </p>
        </header>

        <dl class="mt-10 max-w-2xl border-t border-border">
          <div class="grid gap-x-6 gap-y-1 border-b border-border py-4 sm:grid-cols-[9rem_minmax(0,1fr)]">
            <dt class="font-semibold text-foreground">Base URL</dt>
            <dd class="min-w-0 break-all"><code>{REST_API_BASE}</code></dd>
          </div>
          <div class="grid gap-x-6 gap-y-1 border-b border-border py-4 sm:grid-cols-[9rem_minmax(0,1fr)]">
            <dt class="font-semibold text-foreground">Auth header</dt>
            <dd class="text-muted-foreground">
              <code>Authorization: Bearer nlnr_...</code> (or <code>x-api-key</code>)
            </dd>
          </div>
          <div class="grid gap-x-6 gap-y-1 border-b border-border py-4 sm:grid-cols-[9rem_minmax(0,1fr)]">
            <dt class="font-semibold text-foreground">Permission</dt>
            <dd class="text-muted-foreground">A read token is enough</dd>
          </div>
        </dl>

        <div class="mt-12 flex flex-col gap-10">
          <div class="flex flex-col gap-4">
            <div class="flex flex-wrap items-center gap-3">
              <Badge tone="brand">GET</Badge>
              <h3 class="font-mono text-lg text-foreground">/api/v1/node-datas</h3>
            </div>
            <div class="max-w-2xl overflow-x-auto">
              <table class="w-full text-left text-[0.95rem]">
                <thead>
                  <tr class="border-b border-border text-sm text-muted-foreground">
                    <th class="py-2 pr-4 font-semibold">Parameter</th>
                    <th class="py-2 font-semibold">Description</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="border-b border-border/70">
                    <td class="py-3 pr-4 align-top"><code>canvasId</code></td>
                    <td class="py-3 text-pretty text-muted-foreground">Required. The canvas id.</td>
                  </tr>
                  <tr class="border-b border-border/70">
                    <td class="py-3 pr-4 align-top"><code>nodeIds</code></td>
                    <td class="py-3 text-pretty text-muted-foreground">
                      Required. 1 to 100 node ids, comma-separated
                      (<code>nodeIds=a,b</code>) or repeated
                      (<code>nodeIds=a&nodeIds=b</code>).
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p class="max-w-2xl text-pretty text-muted-foreground">
              Both ids come from <strong>Copy ID → Canvas & node ID</strong> in
              the app. Node ids are the short ids of that reference.
            </p>
            <CodeBlock code={curlGet} filename="terminal" />
          </div>

          <div class="flex flex-col gap-4">
            <div class="flex flex-wrap items-center gap-3">
              <Badge tone="brand">POST</Badge>
              <h3 class="font-mono text-lg text-foreground">/api/v1/node-datas</h3>
            </div>
            <p class="max-w-2xl text-pretty text-muted-foreground">
              The same read, with the parameters in a JSON body, for lists too
              long for a URL. Nothing is written.
            </p>
            <CodeBlock code={curlPost} filename="terminal" />
            <CodeBlock code={fetchExample} filename="read-blocks.js" />
          </div>

          <div class="flex flex-col gap-4">
            <h3 class="text-foreground">Response</h3>
            <p class="max-w-2xl text-pretty text-muted-foreground">
              <code>200 OK</code>, with the blocks found and the ids that
              weren't: unknown, on another canvas, or in the trash. Those don't
              fail the request. An id asked twice comes back once.
            </p>
            <CodeBlock code={responseExample} filename="200 OK" />
            <dl class="max-w-2xl border-t border-border">
              {
                nodeDataFields.map((field) => (
                  <div class="grid gap-x-6 gap-y-1 border-b border-border py-3 sm:grid-cols-[9rem_minmax(0,1fr)]">
                    <dt><code class="text-[0.9rem] font-semibold text-foreground">{field.name}</code></dt>
                    <dd class="text-[0.95rem] text-pretty text-muted-foreground">{field.body}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </section>

      <section id="errors" class="border-t border-border py-16 sm:py-20">
        <header class="flex max-w-2xl flex-col gap-4">
          <p class="text-sm font-semibold text-brand">
            <span class="font-serif">05</span>
            <span class="mx-1.5 text-brand/40">/</span>
            Errors
          </p>
          <h2 class="text-balance text-foreground">One shape for every error.</h2>
          <p class="text-lg text-pretty text-muted-foreground">
            A status code, a stable <code>code</code> to branch on, and a
            message meant for a human.
          </p>
        </header>

        <div class="mt-10 flex flex-col gap-8">
          <CodeBlock code={errorExample} filename="400 Bad Request" />
          <dl class="max-w-3xl border-t border-border">
            {
              apiErrors.map((error) => (
                <div class="grid gap-x-6 gap-y-1.5 border-b border-border py-4 sm:grid-cols-[3.5rem_11rem_minmax(0,1fr)] sm:items-baseline">
                  <dt class="font-serif text-lg text-brand">{error.status}</dt>
                  <dd><code class="text-[0.9rem] font-semibold text-foreground">{error.code}</code></dd>
                  <dd class="text-[0.95rem] text-pretty text-muted-foreground">{error.body}</dd>
                </div>
              ))
            }
          </dl>
          <p class="max-w-2xl text-pretty text-muted-foreground">
            The MCP endpoint answers <code>401</code> to a missing or revoked
            token too, and <code>405</code> to anything but <code>POST</code>.
          </p>
        </div>
      </section>
    </div>
  </Container>

  <section class="pb-20 sm:pb-28">
    <Container>
      <div
        class="flex flex-col items-start gap-6 rounded-3xl border border-border bg-surface px-6 py-10 sm:flex-row sm:items-center sm:justify-between sm:px-12 sm:py-12"
        data-reveal
        data-reveal-variant="zoom"
      >
        <div class="flex max-w-xl flex-col gap-2">
          <h2 class="text-balance text-foreground">Building something?</h2>
          <p class="text-pretty text-muted-foreground">
            Missing an endpoint, or a tool your agent needs? Nolënor is open
            source: open an issue, or read how it works.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <Button href={`${GITHUB_REPO_URL}/issues`} variant="ghost" class="border border-border">
            <Icon name="lucide:github" class="h-4 w-4" />
            Open an issue
          </Button>
          <Button href={APP_API_TOKENS_URL}>
            Create a token
            <Icon name="lucide:arrow-right" class="h-4 w-4" />
          </Button>
        </div>
      </div>
    </Container>
  </section>
</Layout>

<script>
  // help.ts carries the sticky table of contents shared with /help; its
  // keyboard-platform switch finds no buttons here and does nothing.
  import "@/scripts/help";
</script>

<style>
  /* Inline code sits in running text: a step smaller, to match its x-height. */
  :not(pre) > code {
    font-size: 0.875em;
  }

  .toc-link[data-active] {
    border-color: var(--brand);
    color: var(--foreground);
    font-weight: 600;
  }
</style>
