---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";

/*
 * The host serves one 404 page for every missing URL, whatever its
 * language. It renders in English; the inline script below swaps in the
 * French copy when the missing URL was under /fr/. The French strings sit
 * in data attributes so the swap needs no lookup table.
 */
---

<Layout title="Page not found">
  <Container class="flex min-h-[60vh] flex-col items-center justify-center gap-6 py-24 text-center">
    <span class="text-sm font-semibold uppercase tracking-wide text-brand">404</span>
    <h1 class="text-3xl font-semibold tracking-tight" data-fr="Ce canevas n’existe pas.">
      This canvas doesn't exist.
    </h1>
    <p
      class="max-w-md text-muted-foreground"
      data-fr="La page que vous cherchez a été déplacée, renommée, ou n’a jamais existé."
    >
      The page you're looking for was moved, renamed, or never existed.
    </p>
    <Button href="/">
      <span data-fr="Retour à l’accueil" data-fr-href="/fr/">Back to home</span>
    </Button>
  </Container>
</Layout>

<script is:inline>
  if (/^\/fr(\/|$)/.test(location.pathname)) {
    document.documentElement.lang = "fr";
    document.title = "Page introuvable";
    document.querySelectorAll("[data-fr]").forEach(function (el) {
      el.textContent = el.getAttribute("data-fr");
      var href = el.getAttribute("data-fr-href");
      var link = el.closest("a");
      if (href && link) link.setAttribute("href", href);
    });
  }
</script>
