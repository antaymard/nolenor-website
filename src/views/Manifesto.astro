---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/site/PageHero.astro";
import Section from "@/components/site/Section.astro";
import Prose from "@/components/site/Prose.astro";
import DataTable from "@/components/site/DataTable.astro";
import CheckList from "@/components/site/CheckList.astro";
import NewsletterBlock from "@/components/site/NewsletterBlock.astro";
import ClosingCta from "@/components/site/ClosingCta.astro";
import { manifesto } from "@/data/pages/manifesto";
import { getLang } from "@/i18n";
import { md, typo } from "@/lib/md";

const lang = getLang(Astro.currentLocale);
const c = manifesto[lang];
const page = "manifesto";
---

<Layout title={c.meta.title} description={c.meta.description}>
  <PageHero eyebrow={c.hero.eyebrow} title={c.hero.title} lede={c.hero.lede} page={page} showCta={false} />

  <Section id="text" narrow>
    <Prose>
      {
        c.chapters.map((ch) => (
          <>
            <h2>{typo(ch.title, lang)}</h2>
            {ch.paragraphs.map((p) => <p set:html={md(p, lang)} />)}
          </>
        ))
      }
    </Prose>
  </Section>

  <Section id="workshop" tone="light">
    <DataTable headers={c.table.headers} rows={c.table.rows} rowHeaders={false} highlight={1} />
  </Section>

  <Section id="principles" layout="split" title={c.principles.title}>
    <CheckList items={c.principles.items} />
    <p class="sec__kicker">{c.signature}</p>
  </Section>

  <NewsletterBlock title={c.newsletter.title} text={c.newsletter.text} placement="manifesto" />

  <ClosingCta title={c.close.title} page={page} secondary={{ label: c.close.secondary, href: "/about" }} signature={false} />
</Layout>
