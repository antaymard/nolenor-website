const copy = { en, fr }[lang];

const mcpReadTools = mcpReadToolsByLang[lang];
const mcpWriteTools = mcpWriteToolsByLang[lang];
const nodeDataFields = nodeDataFieldsByLang[lang];
const apiErrors = apiErrorsByLang[lang];

const toc = (["token", "mcp", "tools", "rest", "errors"] as const).map((id) => ({
  id,
  label: copy.toc[id],
}));

const claudeCodeCommand = `claude mcp add --transport http nolenor \\
  ${MCP_ENDPOINT} \\
  --header "Authorization: Bearer nlnr_..." \\
  --scope user`;

const mcpJsonConfig = `{
  "mcpServers": {
    "nolenor": {
      "type": "http",
      "url": "${MCP_ENDPOINT}",
      "headers": { "Authorization": "Bearer nlnr_..." }
    }
  }
}`;

const claudeDesktopConfig = `URL      ${MCP_ENDPOINT}
Header   x-api-key: nlnr_...`;

