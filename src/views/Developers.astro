        </span>
        <h2 class="font-sans text-lg font-bold text-foreground">{copy.mcpCard.title}</h2>
        <p class="text-pretty text-muted-foreground">
          {copy.mcpCard.body}
        </p>
        <code class="mt-auto w-fit rounded-md bg-muted px-2 py-1 text-xs text-foreground/80">POST /mcp</code>
      </a>
      <a
        href="#rest"
        class="flex flex-col gap-3 rounded-2xl border border-border bg-surface p-6 transition-colors duration-200 hover:border-brand/30"
        data-reveal
      >
        <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-muted text-brand">
          <Icon name="lucide:braces" class="h-5 w-5" />
        </span>
        <h2 class="font-sans text-lg font-bold text-foreground">{copy.restCard.title}</h2>
        <p class="text-pretty text-muted-foreground">
          {copy.restCard.bodyBefore}{" "}
          <code class="text-sm">/api/v1</code>{copy.restCard.bodyAfter}
        </p>
        <code class="mt-auto w-fit rounded-md bg-muted px-2 py-1 text-xs text-foreground/80">GET /api/v1/node-datas</code>
      </a>
    </Container>
  </section>

  <hr class="border-border" />

  <Container class="grid gap-12 lg:grid-cols-[11rem_minmax(0,1fr)] lg:gap-16">
    <aside class="hidden lg:block">
      <div class="sticky top-28 py-20">
        <nav aria-label={copy.onThisPage} data-help-toc>
          <p class="mb-3 text-xs font-semibold tracking-wide text-muted-foreground uppercase">
            {copy.onThisPage}
          </p>
          <ul class="flex flex-col gap-0.5 border-l border-border">
            {
              toc.map((item) => (
                <li>
                  <a href={`#${item.id}`} class="toc-link -ml-px block border-l-2 border-transparent py-1.5 pl-4 text-sm text-muted-foreground transition-colors hover:text-foreground">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </aside>

    <div class="min-w-0">
      <section id="token" class="py-16 sm:py-20">
        <header class="flex max-w-2xl flex-col gap-4">
          <p class="text-sm font-semibold text-brand">
            <span class="font-serif">01</span>
            <span class="mx-1.5 text-brand/40">/</span>
            {copy.toc.token}
          </p>
          <h2 class="text-balance text-foreground">{copy.token.heading}</h2>
          <p class="text-lg text-pretty text-muted-foreground">
            {copy.token.lede}
          </p>
        </header>

        <ol class="mt-10 flex max-w-2xl flex-col gap-5">
          {
            copy.token.steps.map((step, index) => (
              <li class="flex gap-4">
                <span class="font-serif text-lg text-brand/60">{index + 1}.</span>
                <p>
                  {rich(step).map((s) => s.tag === "code" ? <code>{s.text}</code> : s.tag === "strong" ? <strong>{s.text}</strong> : s.text)}
                </p>
              </li>
            ))
          }
        </ol>

        <div class="mt-8 flex max-w-2xl gap-3 rounded-2xl border border-border bg-surface p-5">
          <Icon name="lucide:shield" class="mt-0.5 h-5 w-5 shrink-0 text-brand" />
          <p class="text-[0.95rem] text-pretty text-muted-foreground">
            {copy.token.warning}
          </p>
        </div>

        <div class="mt-8">
          <Button href={APP_API_TOKENS_URL}>
            {copy.token.cta}
            <Icon name="lucide:arrow-right" class="h-4 w-4" />
          </Button>
        </div>
      </section>

      <section id="mcp" class="border-t border-border py-16 sm:py-20">
        <header class="flex max-w-2xl flex-col gap-4">
          <p class="text-sm font-semibold text-brand">
            <span class="font-serif">02</span>
            <span class="mx-1.5 text-brand/40">/</span>
            {copy.toc.mcp}
          </p>
          <h2 class="text-balance text-foreground">{copy.mcp.heading}</h2>
          <p class="text-lg text-pretty text-muted-foreground">
            {copy.mcp.lede}
          </p>
        </header>

        <dl class="mt-10 max-w-2xl border-t border-border">
          <div class="grid gap-x-6 gap-y-1 border-b border-border py-4 sm:grid-cols-[9rem_minmax(0,1fr)]">
            <dt class="font-semibold text-foreground">{copy.mcp.endpoint}</dt>
            <dd class="min-w-0 break-all"><code>{MCP_ENDPOINT}</code></dd>
          </div>
          <div class="grid gap-x-6 gap-y-1 border-b border-border py-4 sm:grid-cols-[9rem_minmax(0,1fr)]">
            <dt class="font-semibold text-foreground">{copy.mcp.transport}</dt>
            <dd class="text-muted-foreground">{rich(copy.mcp.transportValue).map((s) => s.tag === "code" ? <code>{s.text}</code> : s.tag === "strong" ? <strong>{s.text}</strong> : s.text)}</dd>
          </div>
          <div class="grid gap-x-6 gap-y-1 border-b border-border py-4 sm:grid-cols-[9rem_minmax(0,1fr)]">
            <dt class="font-semibold text-foreground">{copy.mcp.authHeader}</dt>
            <dd class="text-muted-foreground">
              {rich(copy.mcp.authValue).map((s) => s.tag === "code" ? <code>{s.text}</code> : s.tag === "strong" ? <strong>{s.text}</strong> : s.text)}
            </dd>
          </div>
