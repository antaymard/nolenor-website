          <div class="grid gap-x-6 gap-y-1 border-b border-border py-4 sm:grid-cols-[9rem_minmax(0,1fr)]">
            <dt class="font-semibold text-foreground">{copy.mcp.endpoint}</dt>
            <dd class="min-w-0 break-all"><code>{MCP_ENDPOINT}</code></dd>
          </div>
          <div class="grid gap-x-6 gap-y-1 border-b border-border py-4 sm:grid-cols-[9rem_minmax(0,1fr)]">
            <dt class="font-semibold text-foreground">{copy.mcp.transport}</dt>
            <dd class="text-muted-foreground">{rich(copy.mcp.transportValue).map((s) => s.tag === "code" ? <code>{s.text}</code> : s.tag === "strong" ? <strong>{s.text}</strong> : s.text)}</dd>
          </div>
          <div class="grid gap-x-6 gap-y-1 border-b border-border py-4 sm:grid-cols-[9rem_minmax(0,1fr)]">
            <dt class="font-semibold text-foreground">{copy.mcp.authHeader}</dt>
