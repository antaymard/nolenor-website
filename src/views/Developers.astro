/*
 * Developers: connecting an AI tool over MCP, and calling the REST API.
 *
 * Same one-page shape as /help, for the same reason: there isn't enough
 * surface yet to justify a docs site, and everything a developer needs
 * before the first call fits on one scroll. Order is the order of need —
 * a token first, since both paths start there, then MCP (what most
 * readers came for), then the REST API.
 */

const lang = getLang(Astro.currentLocale);

// Strings that carry inline markup mark `code` with backticks and **bold**
// with double stars; rich() splits them so the template renders real
// <code>/<strong> elements, which (unlike set:html content) pick up this
// file's scoped styles.
function rich(text: string) {
  return text
    .split(/(`[^`]+`|\*\*[^*]+\*\*)/)
    .filter(Boolean)
    .map((part) =>
      part.startsWith("`")
        ? { tag: "code", text: part.slice(1, -1) }
        : part.startsWith("**")
          ? { tag: "strong", text: part.slice(2, -2) }
          : { tag: "", text: part },
    );
}

