const curlGet = `curl "${REST_API_BASE}/node-datas?canvasId=k17abc...&nodeIds=n1a2b3,n4c5d6" \\
  -H "Authorization: Bearer $NOLENOR_TOKEN"`;

const curlPost = `curl -X POST "${REST_API_BASE}/node-datas" \\
  -H "Authorization: Bearer $NOLENOR_TOKEN" \\
  -H "Content-Type: application/json" \\
  -d '{ "canvasId": "k17abc...", "nodeIds": ["n1a2b3", "n4c5d6"] }'`;

const fetchExample = `const res = await fetch("${REST_API_BASE}/node-datas", {
  method: "POST",
  headers: {
    Authorization: \`Bearer \${process.env.NOLENOR_TOKEN}\`,
    "Content-Type": "application/json",
  },
  body: JSON.stringify({ canvasId: "k17abc...", nodeIds: ["n1a2b3"] }),
});
if (!res.ok) throw new Error((await res.json()).error.message);
const { nodeDatas, notFound } = await res.json();`;

