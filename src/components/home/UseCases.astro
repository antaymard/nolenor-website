---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getLang } from "@/i18n";
import { SHOWCASE_CANVAS_URLS } from "@/lib/constants";
import Edge from "@/components/home/Edge.astro";
import monitorEn from "@/assets/img/home/s04-monitorer-en.webp";
import monitorFr from "@/assets/img/home/s04-monitorer-fr.webp";
import refsEn from "@/assets/img/home/s03a-creer-inspiration-en.webp";
import refsFr from "@/assets/img/home/s03a-creer-inspiration-fr.webp";
import itersEn from "@/assets/img/home/s03b-creer-iterations-en.webp";
import itersFr from "@/assets/img/home/s03b-creer-iterations-fr.webp";
import companyEn from "@/assets/img/home/s01-structurer-en.webp";
import companyFr from "@/assets/img/home/s01-structurer-fr.webp";
import pdfEn from "@/assets/img/home/s02a-comprendre-depot-en.webp";
import pdfFr from "@/assets/img/home/s02a-comprendre-depot-fr.webp";
import sheetsEn from "@/assets/img/home/s02b-comprendre-fiches-en.webp";
import sheetsFr from "@/assets/img/home/s02b-comprendre-fiches-fr.webp";
import teamEn from "@/assets/img/home/s09-collaborer-en.webp";
import teamFr from "@/assets/img/home/s09-collaborer-fr.webp";

const lang = getLang(Astro.currentLocale);

type Profile = "builders" | "small" | "consultants" | "midsize";

const profiles: Record<Profile, { en: string; fr: string }> = {
  builders: { en: "Builders", fr: "Builders" },
  small: { en: "Small businesses", fr: "Petites entreprises" },
  consultants: { en: "Consultants", fr: "Consultants" },
  midsize: { en: "Mid-size companies", fr: "ETI" },
};

const en = {
  title: "What you can do with it.",
  lede: "Five real projects, one tab each.",
  tabs: "Projects",
  open: "Open this canvas",
  cases: [
    {
      profiles: ["builders", "midsize"],
      canvas: "Brume · tracking",
      tile: "#0d9488",
      title: "Your numbers, wired to your own APIs.",
      body: "Wishlists, crashes, builds: mini-apps read your APIs and update themselves. Ask a question, and Nolë cross-checks the sources.",
      shots: [{ img: monitorEn, tab: "", alt: "A small game studio’s tracking canvas: Steam wishlists over seven weeks, crashes per day with a red spike, Discord members, crash-free sessions and the list of builds. Nolë explains the spike from the build list." }],
      href: SHOWCASE_CANVAS_URLS.builders,
    },
    {
      profiles: ["builders"],
      canvas: "Brume · art direction",
      tile: "#7c3aed",
      title: "From references to the approved version.",
      body: "Lay down your references and your brief, generate first directions, and keep every version on the canvas with the note that moved it on.",
      shots: [
        { img: refsEn, tab: "References", alt: "Character references, links and an art-direction brief attached to Nolë, which generates three key-art directions from them." },
        { img: itersEn, tab: "Iterations", alt: "Four versions of a key art in a row, each with the note that led to the next one, the last marked approved." },
      ],
      href: SHOWCASE_CANVAS_URLS.builders,
    },
    {
      profiles: ["small"],
      canvas: "Atelier Kervern",
      tile: "#0284c7",
      title: "The whole business on one surface.",
      body: "One sub-canvas per part of the business, the processes, the clients and the reference files, kept where you can see them. On your own, or with an integrator who sets it up for you.",
      shots: [{ img: companyEn, tab: "", alt: "A joinery workshop’s canvas: one sub-canvas per area of the business, the quoting process, the active clients table and the reference files." }],
      href: SHOWCASE_CANVAS_URLS.business,
    },
    {
      profiles: ["consultants"],
      canvas: "Renazine · clinical file",
      tile: "#ea580c",
      title: "Five hundred pages, nine summaries.",
      body: "Drop in the PDF. Nolë draws one card per study from it, with the page each time, which you correct and complete.",
      shots: [
        { img: pdfEn, tab: "The PDF", alt: "A 512-page clinical file dropped on the canvas; Nolë reads it and starts one card per study." },
        { img: sheetsEn, tab: "The cards", alt: "Nine study cards (patients, effect, page number), a summary table and an effect chart, all linked to the source PDF." },
      ],
      href: SHOWCASE_CANVAS_URLS.documents,
    },
    {
      profiles: ["small", "midsize"],
      canvas: "Leroux kitchen · site",
      tile: "#db2777",
      title: "The whole team on the same canvas.",
      body: "Photos, plans, site notes and the build tracker: everyone sees who is working where, and opens the document they need.",
      shots: [{ img: teamEn, tab: "", alt: "A kitchen-fitting canvas with three people on it: the site photo, the plans, the site notes and the build tracker, with the quote terms open in a window." }],
      href: SHOWCASE_CANVAS_URLS.business,
    },
  ],
  aside: "Buying a home, negotiating a salary, planning a long trip: it works for those too.",
};
const fr: typeof en = {
  title: "Ce que vous pouvez en faire.",
  lede: "Cinq vrais projets, un onglet chacun.",
  tabs: "Projets",
  open: "Ouvrir ce canvas",
  cases: [
    {
      profiles: ["builders", "midsize"],
      canvas: "Brume · suivi",
      tile: "#0d9488",
      title: "Vos chiffres, branchés sur vos API.",
      body: "Wishlists, crashs, builds : des mini-apps lisent vos API et se mettent à jour seules. Une question, et Nolë croise les sources.",
      shots: [{ img: monitorFr, tab: "", alt: "Le canvas de suivi d’un petit studio de jeu : wishlists Steam sur sept semaines, crashs par jour avec un pic en rouge, membres Discord, sessions sans crash et liste des builds. Nolë explique le pic à partir des builds." }],
      href: SHOWCASE_CANVAS_URLS.builders,
    },
    {
      profiles: ["builders"],
      canvas: "Brume · direction artistique",
      tile: "#7c3aed",
      title: "Des références à la version validée.",
      body: "Posez vos références et votre brief, générez des pistes, et gardez chaque version sur le canvas avec la remarque qui l’a fait évoluer.",
      shots: [
        { img: refsFr, tab: "Références", alt: "Des références de personnages, des liens et un brief de direction artistique joints à Nolë, qui en tire trois pistes de key art." },
        { img: itersFr, tab: "Itérations", alt: "Quatre versions d’un key art à la suite, chacune avec la remarque qui a mené à la suivante, la dernière validée." },
      ],
      href: SHOWCASE_CANVAS_URLS.builders,
    },
    {
      profiles: ["small"],
      canvas: "Atelier Kervern",
      tile: "#0284c7",
      title: "Toute l’entreprise sur une seule surface.",
      body: "Un sous-canvas par pan de l’entreprise, les process, les clients et les documents de référence, rangés là où on les voit. Seul, ou avec un intégrateur qui le paramètre pour vous.",
      shots: [{ img: companyFr, tab: "", alt: "Le canvas d’un atelier de menuiserie : un sous-canvas par pan de l’entreprise, le process de devis, la table des clients actifs et les documents de référence." }],
      href: SHOWCASE_CANVAS_URLS.business,
    },
    {
      profiles: ["consultants"],
      canvas: "Rénazine · dossier clinique",
      tile: "#ea580c",
      title: "Cinq cents pages, neuf fiches.",
      body: "Déposez le PDF. Nolë en tire une fiche par étude, avec la page à chaque fois, que vous corrigez et complétez.",
      shots: [
        { img: pdfFr, tab: "Le PDF", alt: "Un dossier clinique de 512 pages déposé sur le canvas ; Nolë le lit et commence une fiche par étude." },
        { img: sheetsFr, tab: "Les fiches", alt: "Neuf fiches d’études (patients, effet, numéro de page), une table de synthèse et un graphique des effets, tous reliés au PDF source." },
      ],
      href: SHOWCASE_CANVAS_URLS.documents,
    },
    {
      profiles: ["small", "midsize"],
      canvas: "Chantier Leroux · cuisine",
      tile: "#db2777",
      title: "Toute l’équipe sur le même canvas.",
      body: "Photos, plans, notes de chantier et suivi de fabrication : chacun voit qui travaille où, et ouvre le document dont il a besoin.",
      shots: [{ img: teamFr, tab: "", alt: "Le canvas d’un chantier de cuisine avec trois personnes dessus : la photo du chantier, les plans, les notes de chantier et le suivi de fabrication, les conditions du devis ouvertes dans une fenêtre." }],
      href: SHOWCASE_CANVAS_URLS.business,
    },
  ],
  aside: "Et pour un achat immobilier, une négociation de salaire ou un grand voyage, ça marche aussi.",
};
const copy = { en, fr }[lang];

/*
 * One window, the way the app docks one: a tab per project (its canvas
 * tile and name), one screen at a time, builders first. The project's own
 * document node sits over the corner of its screen, like a note dropped on
 * the canvas, with the link to the canvas itself (a public one, still to be
 * prepared: see SHOWCASE_CANVAS_URLS). A project told in two steps carries
 * two step tabs on its screen.
 */
---

<section id="use-cases" class="cases" aria-labelledby="cases-title">
  <div class="wrap">
    <h2 id="cases-title" class="title-node cases__title">{copy.title}</h2>
    <div class="node doc cases__lede"><p>{copy.lede}</p></div>

    <div class="node win bleed-both" data-cases>
      <div class="win__tabs" role="tablist" aria-label={copy.tabs}>
        {
          copy.cases.map((c, i) => (
            <button type="button" role="tab" id={`case-tab-${i}`} aria-controls={`case-panel-${i}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-case-tab={i}>
              <span class="win__tile" style={`background:${c.tile}`}>{c.canvas[0]}</span>
              {c.canvas}
            </button>
          ))
        }
      </div>
      {
        copy.cases.map((c, i) => (
          <div class="win__panel" role="tabpanel" id={`case-panel-${i}`} aria-labelledby={`case-tab-${i}`} hidden={i > 0} data-case-panel={i}>
            <div class="win__screen media">
              {c.shots.map((shot, j) => (
                <Image src={shot.img} alt={shot.alt} widths={[960, 1440, 1920]} sizes="(min-width: 60rem) 85vw, 100vw" data-shot={j} hidden={j > 0} />
              ))}
            </div>
            <div class="win__foot">
            <div class="doc win__note">
              <h3>{c.title}</h3>
              <p>{c.body}</p>
              <p class="win__profiles">
                {c.profiles.map((p) => (
                  <span>{profiles[p as Profile][lang]}</span>
                ))}
              </p>
              <a href={c.href} class="win__open" rel="noopener noreferrer">
                {copy.open}
                <Icon name="lucide:arrow-up-right" />
              </a>
            </div>
            {c.shots.length > 1 && (
              <div class="win__steps">
                {c.shots.map((shot, j) => (
                  <button type="button" aria-pressed={j === 0 ? "true" : "false"} data-step={j}>
                    <span>{j + 1}</span>
                    {shot.tab}
                  </button>
                ))}
              </div>
            )}
            </div>
          </div>
        ))
      }
    </div>

    <div class="node doc cases__aside"><p>{copy.aside}</p></div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-cases]").forEach((win) => {
    const tabs = [...win.querySelectorAll<HTMLButtonElement>("[data-case-tab]")];
    const panels = [...win.querySelectorAll<HTMLElement>("[data-case-panel]")];
    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        tab.setAttribute("aria-selected", String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
      });
      panels.forEach((panel, i) => (panel.hidden = i !== index));
      if (focus) tabs[index].focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i));
      tab.addEventListener("keydown", (event) => {
        if (event.key === "ArrowRight") select((i + 1) % tabs.length, true);
        if (event.key === "ArrowLeft") select((i - 1 + tabs.length) % tabs.length, true);
      });
    });
    panels.forEach((panel) => {
      const steps = [...panel.querySelectorAll<HTMLButtonElement>("[data-step]")];
      const shots = [...panel.querySelectorAll<HTMLImageElement>("[data-shot]")];
      steps.forEach((step) =>
        step.addEventListener("click", () => {
          steps.forEach((s) => s.setAttribute("aria-pressed", String(s === step)));
          shots.forEach((shot) => (shot.hidden = shot.dataset.shot !== step.dataset.step));
        }),
      );
    });
  });
</script>

<style>
  .cases {
    padding-block: var(--section-gap-s);
  }

  .cases__title {
    margin: 0 0 var(--space-md) -8px;
    font-size: var(--text-section);
    line-height: 1.08;
  }

  .cases__lede {
    max-width: 30rem;
    margin-bottom: var(--space-xl);
    font-size: var(--text-lead);
  }

  .win {
    overflow: hidden;
  }

  /* The window's tab strip (WindowDock): one tab per project. */
  .win__tabs {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    padding: 6px;
    border-bottom: 1px solid oklch(0.929 0.013 255.508);
    background: oklch(0.984 0.003 247.858);
    scrollbar-width: none;
  }

  .win__tabs button,
  .win__steps button {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 0 12px 0 8px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: none;
    font: 600 14px / 1 var(--font-body);
    white-space: nowrap;
    color: #64748b;
    cursor: pointer;
  }

  .win__tabs button:hover,
  .win__steps button:hover {
    color: var(--color-ink);
  }

  .win__tabs button[aria-selected="true"] {
    border-color: oklch(0.929 0.013 255.508);
    background: #fff;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.06);
    color: var(--color-ink);
  }

  .win__tile {
    display: inline-flex;
    width: 20px;
    height: 20px;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    color: #fff;
  }

  .win__panel {
    position: relative;
  }

  .win__panel[hidden] {
    display: none;
  }

  .win__screen {
    position: relative;
  }

  .win__screen :global(img[hidden]) {
    display: none;
  }

  /* Under the screen, never over it: the project's note, and its steps. */
  .win__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-xl);
    border-top: 1px solid oklch(0.929 0.013 255.508);
  }

  .win__steps {
    display: flex;
    gap: 4px;
    padding: 12px 14px;
  }

  .win__steps button {
    padding-left: 6px;
  }

  .win__steps button[aria-pressed="true"] {
    background: #f1f5f9;
    color: var(--color-ink);
  }

  .win__steps button span {
    display: inline-flex;
    width: 18px;
    height: 18px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #e2e8f0;
    font-size: 11px;
    font-weight: 800;
  }

  .win__note {
    max-width: 44rem;
  }

  .win__note h3 {
    font-size: 1.25em;
    font-weight: 700;
  }

  .win__profiles {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .win__profiles span {
    padding: 1px 8px;
    border-radius: 6px;
    background: #f1f5f9;
    font-size: 12px;
    font-weight: 600;
    color: #475569;
  }

  .win__open {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
  }

  .win__open:hover {
    text-decoration: underline;
  }

  .win__open svg {
    width: 16px;
    height: 16px;
  }

  .cases__aside {
    max-width: 34rem;
    margin-top: var(--space-xl);
    color: var(--color-ink-2);
  }

</style>
