---
import { Image } from "astro:assets";
import { getLang } from "@/i18n";
import { SHOWCASE_CANVAS_URLS } from "@/lib/constants";
import gameEn from "@/assets/img/home/s04-monitorer-en.webp";
import gameFr from "@/assets/img/home/s04-monitorer-fr.webp";
import companyEn from "@/assets/img/home/s01-structurer-en.webp";
import companyFr from "@/assets/img/home/s01-structurer-fr.webp";
import studiesEn from "@/assets/img/home/s02b-comprendre-fiches-en.webp";
import studiesFr from "@/assets/img/home/s02b-comprendre-fiches-fr.webp";

const lang = getLang(Astro.currentLocale);

const en = {
  title: "One canvas per project.",
  lede: "Three real canvases, open to anyone. Step in, look around, make a copy.",
  open: "Open this canvas",
  aside: "Buying a home, negotiating a salary, planning a long trip: it works for those too.",
  cards: [
    {
      who: "Builders",
      title: "Your product, from idea to launch.",
      body: "Market watch, specs, beta feedback and screenshots in one place. Your coding agent reads the spec straight from the canvas.",
      img: gameEn,
      alt: "A small game studio’s tracking canvas: Steam wishlists over seven weeks, crashes per day with one red spike, Discord members, crash-free sessions and the list of builds.",
      href: SHOWCASE_CANVAS_URLS.builders,
    },
    {
      who: "Small businesses",
      title: "The whole business on one surface.",
      body: "Clients, processes, projects and documents, kept where you can see them. On your own, or with an integrator who sets it up for you.",
      img: companyEn,
      alt: "A joinery workshop’s canvas: one sub-canvas per area of the business (clients, workshop, purchasing, admin, team, marketing), the quoting process, the active clients table, and the reference files.",
      href: SHOWCASE_CANVAS_URLS.business,
    },
    {
      who: "Buried in documents",
      title: "Five hundred pages, nine summaries.",
      body: "Drop in the PDF. Each study becomes a clear card with its sources, which you correct and complete.",
      img: studiesEn,
      alt: "A 500-page clinical file turned into nine study cards (patients, effect, page number), a summary table and an effect chart, all linked to the source PDF.",
      href: SHOWCASE_CANVAS_URLS.documents,
    },
  ],
};
const fr: typeof en = {
  title: "Un canvas par projet.",
  lede: "Trois vrais canvas, ouverts à tous. Entrez, regardez, faites-en une copie.",
  open: "Ouvrir ce canvas",
  aside: "Et pour un achat immobilier, une négociation de salaire ou un grand voyage, ça marche aussi.",
  cards: [
    {
      who: "Builders",
      title: "Votre produit, de l’idée au lancement.",
      body: "La veille, la spec, les retours de bêta et les captures au même endroit. Votre agent de code lit la spec directement sur le canvas.",
      img: gameFr,
      alt: "Le canvas de suivi d’un petit studio de jeu vidéo : wishlists Steam sur sept semaines, crashs par jour avec un pic en rouge, membres Discord, sessions sans crash et liste des builds.",
      href: SHOWCASE_CANVAS_URLS.builders,
    },
    {
      who: "Petites entreprises",
      title: "Toute l’entreprise sur une seule surface.",
      body: "Les clients, les process, les projets et les documents, rangés là où on les voit. Seul, ou avec un intégrateur qui le paramètre pour vous.",
      img: companyFr,
      alt: "Le canvas d’un atelier de menuiserie : un sous-canvas par pan de l’entreprise (clients, atelier, achats, admin, équipe, marketing), le process de devis, la table des clients actifs et les documents de référence.",
      href: SHOWCASE_CANVAS_URLS.business,
    },
    {
      who: "Noyés sous les documents",
      title: "Cinq cents pages, neuf fiches.",
      body: "Déposez le PDF. Chaque étude devient une fiche claire, avec ses sources, que vous corrigez et complétez.",
      img: studiesFr,
      alt: "Un dossier clinique de 500 pages transformé en neuf fiches d’études (patients, effet, numéro de page), une table de synthèse et un graphique des effets, tous reliés au PDF source.",
      href: SHOWCASE_CANVAS_URLS.documents,
    },
  ],
};
const copy = { en, fr }[lang];

/*
 * Three people, three real canvases. Each card is a link to a public,
 * duplicable canvas (still to be prepared: see SHOWCASE_CANVAS_URLS), so the
 * page shows instead of telling. The links read as links, not buttons: the
 * page keeps one button.
 */
---

<section id="use-cases" class="projects" aria-labelledby="projects-title">
  <div class="wrap">
    <header class="projects__head">
      <h2 id="projects-title">{copy.title}</h2>
      <p>{copy.lede}</p>
    </header>

    <div class="projects__grid">
      {
        copy.cards.map((card) => (
          <article class="card" data-reveal>
            <figure class="card__shot">
              <Image src={card.img} alt={card.alt} widths={[480, 720, 960]} sizes="(min-width: 60rem) 30vw, 100vw" />
            </figure>
            <div class="card__text">
              <p class="card__who">{card.who}</p>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
              <a href={card.href} class="text-link card__link" rel="noopener noreferrer">
                {copy.open}
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <p class="projects__aside">{copy.aside}</p>
  </div>
</section>

<style>
  .projects {
    padding-block: var(--section-gap);
    background: var(--color-paper-3);
    border-block: var(--rule-hair) solid var(--color-rule);
  }

  .projects__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 40rem;
    margin-bottom: var(--space-2xl);
  }

  .projects__head h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-section);
    line-height: 1.08;
    letter-spacing: var(--tracking-display);
  }

  .projects__head p {
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--color-ink-2);
  }

  .projects__grid {
    display: grid;
    gap: var(--space-xl) var(--gap-columns);
  }

  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-card);
    background: var(--color-paper);
  }

  .card__shot {
    margin: 0;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--color-rule);
  }

  .card__shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
  }

  .card__text {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--space-lg);
  }

  .card__who {
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .card h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-title);
    line-height: 1.25;
    color: var(--color-ink);
    text-wrap: balance;
  }

  .card__text > p:not(.card__who) {
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--color-ink-2);
  }

  .card__link {
    margin-top: auto;
    padding-top: var(--space-sm);
  }

  .projects__aside {
    margin-top: var(--space-xl);
    font-size: var(--text-md);
    color: var(--color-muted);
  }

  @media (min-width: 60rem) {
    .projects__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
