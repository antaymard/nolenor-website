---
import { Image } from "astro:assets";
import { getLang } from "@/i18n";
import askEn from "@/assets/img/home/s02c-comprendre-questions-en.webp";
import askFr from "@/assets/img/home/s02c-comprendre-questions-fr.webp";

const lang = getLang(Astro.currentLocale);

const en = {
  title: "One agent, many trades.",
  lede: "Nolë is Nolënor’s agent. It works on the canvas alongside you, and only when you ask.",
  skills: [
    ["Read", "PDFs, recordings, videos, images."],
    ["Search", "the web, with its sources cited."],
    ["Structure", "databases, views, cards made to measure."],
    ["Calculate", "figures that update themselves."],
    ["Code", "the mini-app or chart you were missing."],
    ["Create", "images from your own references."],
    ["Connect", "to the tools you already use."],
  ],
  img: askEn,
  alt: "Nolë answers a question about a 500-page clinical file: it quotes the page it relies on, adds the point to the study card, and the PDF opens in a window at that exact page, the passage highlighted.",
};
const fr: typeof en = {
  title: "Un agent, beaucoup de métiers.",
  lede: "Nolë, c’est l’agent de Nolënor. Il travaille sur le canvas avec vous, et seulement quand vous le lui demandez.",
  skills: [
    ["Lire", "des PDF, des enregistrements, des vidéos, des images."],
    ["Chercher", "sur le web, avec les sources citées."],
    ["Structurer", "des bases de données, des vues, des fiches sur mesure."],
    ["Calculer", "des chiffres qui se recalculent seuls."],
    ["Coder", "la mini-app ou le graphique qui manque."],
    ["Créer", "des images à partir de vos références."],
    ["Se connecter", "à vos outils existants."],
  ],
  img: askFr,
  alt: "Nolë répond à une question sur un dossier clinique de 500 pages : il cite la page sur laquelle il s’appuie, ajoute le point à la fiche de l’étude, et le PDF s’ouvre dans une fenêtre à cette page précise, le passage surligné.",
};
const copy = { en, fr }[lang];

/*
 * A list of verbs, not a feature grid: each line is one trade, the verb in
 * the reader's hand, its object after it. The screen beside it shows one of
 * them for real (reading, with the source one click away).
 */
---

<section id="nole" class="agent" aria-labelledby="agent-title">
  <div class="wrap agent__grid">
    <div class="agent__text">
      <h2 id="agent-title" class="title-node agent__title">{copy.title}</h2>
      <div class="node doc agent__list">
        <p>{copy.lede}</p>
        <ul>
          {
            copy.skills.map(([verb, what]) => (
              <li>
                <strong>{verb}</strong> {what}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <figure class="node agent__shot bleed-right" data-reveal>
      <Image src={copy.img} alt={copy.alt} widths={[720, 1080, 1440]} sizes="(min-width: 60rem) 55vw, 100vw" />
    </figure>
  </div>
</section>

<style>
  .agent {
    padding-block: var(--section-gap-s);
  }

  .agent__grid {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }

  .agent__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .agent__title {
    margin: 0 0 0 -8px;
    font-size: var(--text-section);
    line-height: 1.08;
  }

  .agent__list {
    max-width: 30rem;
    font-size: 16px;
  }

  .agent__list ul {
    margin-top: 0.8em;
  }

  .agent__shot {
    margin-block: 0;
    overflow: hidden;
  }

  .agent__shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 60rem) {
    .agent__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-3xl);
    }
  }
</style>
