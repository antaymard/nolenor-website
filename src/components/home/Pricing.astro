---
import { APP_SIGNUP_URL } from "@/lib/constants";
import { getLang } from "@/i18n";

const lang = getLang(Astro.currentLocale);

const en = {
  title: "Free during the beta.",
  body: "All of Nolënor, AI included, with no credit card. And for what comes next, commitments in writing:",
  // Each line is a public commitment: keep only the ones we hold to.
  promises: [
    "A free plan that stays.",
    "Thirty days’ notice before any price change.",
    "Your data, exportable at any time, for free.",
    "The cost of an AI request shown before you run it.",
  ],
  cta: "Open a canvas",
  valueLabel: "During the beta",
  promisesTitle: "Our commitments",
};
const fr: typeof en = {
  title: "Gratuit pendant la bêta.",
  body: "Tout Nolënor, IA comprise, sans carte bancaire. Et pour la suite, des engagements écrits :",
  promises: [
    "Une formule gratuite qui reste.",
    "Trente jours de préavis avant tout changement de prix.",
    "Vos données exportables à tout moment, gratuitement.",
    "Le coût d’une demande à l’IA affiché avant de la lancer.",
  ],
  cta: "Ouvrir un canvas",
  valueLabel: "Pendant la bêta",
  promisesTitle: "Nos engagements",
};
const copy = { en, fr }[lang];

/*
 * The price as a Value node (the app's ValueFace: label, figure, unit), the
 * commitments as a checklist in a document node, all of them ticked: each
 * one is a promise already made.
 */
---

<section id="pricing" class="pricing" aria-labelledby="pricing-title">
  <div class="wrap pricing__grid">
    <div class="pricing__text">
      <h2 id="pricing-title" class="title-node pricing__title">{copy.title}</h2>
      <div class="pricing__row">
        <div class="node value-node" aria-label={`${copy.valueLabel} : 0 €`}>
          <span class="value-node__label">{copy.valueLabel}</span>
          <span class="value-node__figure">0<small>€</small></span>
        </div>
        <div class="node doc pricing__body"><p>{copy.body}</p></div>
      </div>
      <a href={APP_SIGNUP_URL} class="btn" rel="noopener noreferrer">{copy.cta}</a>
    </div>
    <div class="node doc pricing__promises">
      <h3>{copy.promisesTitle}</h3>
      <ul class="check">
        {copy.promises.map((promise) => <li data-checked>{promise}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .pricing {
    padding-block: var(--section-gap-s);
  }

  .pricing__grid {
    display: grid;
    gap: var(--space-2xl) var(--gap-columns);
    align-items: center;
  }

  .pricing__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-lg);
  }

  .pricing__title {
    margin: 0 0 0 -8px;
    font-size: var(--text-section);
    line-height: 1.08;
  }

  .pricing__row {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: var(--space-md);
  }

  .value-node {
    display: flex;
    min-width: 11rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 14px 20px;
  }

  .value-node__label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #64748b;
  }

  .value-node__figure {
    font-size: 36px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .value-node__figure small {
    margin-left: 4px;
    font-size: 16px;
    font-weight: 600;
    color: #64748b;
  }

  .pricing__body {
    flex: 1;
    min-width: 14rem;
    max-width: 24rem;
    display: flex;
    align-items: center;
  }

  .pricing__promises {
    font-size: 17px;
  }

  .pricing__promises h3 {
    font-weight: 700;
  }

  .pricing__promises li + li {
    margin-top: 0.7em;
  }

  @media (min-width: 60rem) {
    .pricing__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
</style>
