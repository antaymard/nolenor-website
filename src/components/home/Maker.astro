---
import { CONTACT_URL } from "@/lib/constants";
import { Icon } from "astro-icon/components";
import { getLang, localizePath } from "@/i18n";

const lang = getLang(Astro.currentLocale);

const en = {
  title: "A craftsman, not a factory.",
  body: "Nolënor is built by Antoine, on his own, in Brittany. Trained as a pharmacist, a developer for ten years, formerly a product manager.",
  missingTitle: "Not there yet",
  missing: ["Importing from Notion and Airtable.", "Automations.", "A real mobile version."],
  manifesto: "Read the manifesto",
  contact: "Contact me",
};
const fr: typeof en = {
  title: "Un artisan, pas une usine.",
  body: "Nolënor est construit par Antoine, seul, en Bretagne. Pharmacien de formation, développeur depuis dix ans, ancien responsable produit.",
  missingTitle: "Ce qui n’existe pas encore",
  missing: ["L’import depuis Notion et Airtable.", "Les automatisations.", "Une vraie version mobile."],
  manifesto: "Lire le manifeste",
  contact: "Me contacter",
};
const copy = { en, fr }[lang];

/*
 * Who is behind it in a document node, the two links as Link nodes, and
 * what is missing as a to-do list: unchecked, because it isn't done yet.
 */
---

<section id="about" class="maker" aria-labelledby="maker-title">
  <div class="wrap maker__grid">
    <div class="maker__text">
      <h2 id="maker-title" class="title-node maker__title">{copy.title}</h2>
      <div class="node doc maker__doc">
        <p>{copy.body}</p>
        {/* Antoine’s own sentence on why he builds Nolënor goes here (a <blockquote>), written by him. */}
      </div>
      <div class="maker__links">
        <a href={localizePath("/manifesto", lang)} class="node link-node"><Icon name="lucide:file-text" />{copy.manifesto}</a>
        <a href={CONTACT_URL} class="node link-node"><Icon name="lucide:mail" />{copy.contact}</a>
      </div>
    </div>

    <div class="node doc maker__missing">
      <h3>{copy.missingTitle}</h3>
      <ul class="check">
        {copy.missing.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .maker {
    padding-block: var(--section-gap-s) var(--section-gap);
  }

  .maker__grid {
    display: grid;
    gap: var(--space-2xl) var(--gap-columns);
    align-items: end;
  }

  .maker__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .maker__title {
    margin: 0 0 0 -8px;
    font-size: var(--text-section);
    line-height: 1.08;
  }

  .maker__doc {
    max-width: 36rem;
    font-size: 17px;
  }

  .maker__doc blockquote {
    font-weight: 600;
    color: var(--color-ink);
  }

  .maker__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .maker__missing h3 {
    font-weight: 700;
  }

  .maker__missing li + li {
    margin-top: 0.5em;
  }

  @media (min-width: 60rem) {
    .maker__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: var(--space-3xl);
    }
  }
</style>
