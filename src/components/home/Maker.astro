---
import { CONTACT_URL } from "@/lib/constants";
import { getLang, localizePath } from "@/i18n";

const lang = getLang(Astro.currentLocale);

const en = {
  title: "A craftsman, not a factory.",
  body: "Nolënor is built by Antoine, on his own, in Brittany. Trained as a pharmacist, a developer for ten years, formerly a product manager.",
  // DRAFT: Antoine's own sentence on why he builds Nolënor goes here.
  quote: "I wanted somewhere to think without a tool doing the thinking for me. I couldn’t find it, so I’m building it.",
  missingTitle: "Not there yet",
  missing: ["Importing from Notion and Airtable.", "Automations.", "A real mobile version."],
  manifesto: "Read the manifesto",
  contact: "Contact me",
};
const fr: typeof en = {
  title: "Un artisan, pas une usine.",
  body: "Nolënor est construit par Antoine, seul, en Bretagne. Pharmacien de formation, développeur depuis dix ans, ancien responsable produit.",
  // BROUILLON : la phrase d’Antoine sur le pourquoi du projet.
  quote: "Je voulais un endroit où réfléchir sans qu’un outil le fasse à ma place. Je ne l’ai pas trouvé, alors je le construis.",
  missingTitle: "Ce qui n’existe pas encore",
  missing: ["L’import depuis Notion et Airtable.", "Les automatisations.", "Une vraie version mobile."],
  manifesto: "Lire le manifeste",
  contact: "Me contacter",
};
const copy = { en, fr }[lang];

/*
 * Who is behind it, said plainly, and what is missing, said just as
 * plainly: the list of what doesn't exist yet is part of the promise.
 */
---

<section id="about" class="maker" aria-labelledby="maker-title">
  <div class="wrap maker__grid">
    <div class="maker__text">
      <h2 id="maker-title">{copy.title}</h2>
      <p>{copy.body}</p>
      <blockquote>{copy.quote}</blockquote>
      <p class="maker__links">
        <a href={localizePath("/manifesto", lang)} class="text-link">{copy.manifesto}</a>
        <span aria-hidden="true">·</span>
        <a href={CONTACT_URL} class="text-link">{copy.contact}</a>
      </p>
    </div>

    <aside class="maker__missing" aria-labelledby="missing-title">
      <h3 id="missing-title">{copy.missingTitle}</h3>
      <ul>
        {copy.missing.map((item) => <li>{item}</li>)}
      </ul>
    </aside>
  </div>
</section>

<style>
  .maker {
    padding-block: var(--section-gap);
  }

  .maker__grid {
    display: grid;
    gap: var(--space-2xl) var(--gap-columns);
    align-items: start;
  }

  .maker__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-lg);
  }

  .maker h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-section);
    line-height: 1.08;
    letter-spacing: var(--tracking-display);
  }

  .maker__text > p:not(.maker__links) {
    max-width: 46ch;
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--color-ink-2);
  }

  .maker blockquote {
    max-width: 34ch;
    margin: 0;
    padding-left: var(--space-lg);
    border-left: 2px solid var(--color-highlight);
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-style: italic;
    line-height: 1.35;
    color: var(--color-ink);
  }

  .maker__links {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
    color: var(--color-muted);
  }

  .maker__missing {
    padding: var(--space-lg);
    border: 1px dashed var(--color-rule-2);
    border-radius: var(--radius-card);
  }

  .maker__missing h3 {
    margin-bottom: var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .maker__missing ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .maker__missing li {
    padding-block: var(--space-xs);
    font-size: var(--text-md);
    color: var(--color-ink-2);
  }

  .maker__missing li::before {
    content: "○";
    margin-right: var(--space-xs);
    color: var(--color-rule-2);
  }

  @media (min-width: 60rem) {
    .maker__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: var(--space-3xl);
    }

    .maker__missing {
      margin-top: var(--space-2xl);
    }
  }
</style>
