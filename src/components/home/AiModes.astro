---
import { Icon } from "astro-icon/components";
import { getLang } from "@/i18n";
import Edge from "@/components/home/Edge.astro";

const lang = getLang(Astro.currentLocale);

const en = {
  ai: "AI",
  window: "WMS rollout · budget",
  states: {
    off: {
      label: "Off",
      title: "AI off, it is already a tool.",
      body: "Open a PDF next to your canvas, drop a table in, pull a computed value from it. No AI involved: the canvas does the work, and the numbers follow.",
      alt: "A quote PDF opens in a window docked on the right; a CSV file is dropped onto the canvas and becomes a table; a link dragged from the table creates a computed value, the scanner budget, which follows the table.",
    },
    on: {
      label: "On",
      title: "AI on, it works with you.",
      body: "Ask out loud: “make a chart of the scanners by site, from the table”. Nolë reads the table, builds the chart next to it, and you watch each step happen in violet on the canvas.",
      alt: "The request is dictated in Nolë’s panel; Nolë reads the table (a violet halo surrounds it), then creates a chart node linked to it, its bars rising, with a pulsing violet halo while it writes.",
    },
  },
};
const fr: typeof en = {
  ai: "IA",
  window: "WMS rollout · budget",
  states: {
    off: {
      label: "Éteinte",
      title: "IA éteinte, c’est déjà un outil.",
      body: "Ouvrez un PDF à côté de votre canvas, déposez un tableau, tirez-en une valeur calculée. Sans IA : le canvas fait le travail, et les chiffres suivent.",
      alt: "Un devis PDF s’ouvre dans une fenêtre ancrée à droite ; un fichier CSV déposé sur le canvas devient un tableau ; un lien tiré depuis le tableau crée une valeur calculée, le budget scanners, qui suit le tableau.",
    },
    on: {
      label: "Allumée",
      title: "IA allumée, elle travaille avec vous.",
      body: "Demandez à voix haute : « fais un graphique des scanners par site, à partir du tableau ». Nolë lit le tableau, construit le graphique à côté, et vous voyez chaque étape se faire, en violet, sur le canvas.",
      alt: "La demande est dictée dans le panneau de Nolë ; Nolë lit le tableau (un halo violet l’entoure), puis crée un nœud graphique relié au tableau, dont les barres montent, avec un halo violet qui pulse pendant qu’il écrit.",
    },
  },
};
const copy = { en, fr }[lang];
const modes = ["off", "on"] as const;

/*
 * One section, two states, and the switch between them (the hero's switch
 * drives it too). Each state is a short clip of the app itself, rendered
 * from the product's tutorial kit: off, a PDF opened, a table dropped, a
 * computed value pulled from it; on, a dictated request, Nolë reading the
 * table and drawing the chart, its work shown in violet. Flipping the switch
 * slides one clip out and the other in, and starts it from the beginning.
 */
---

<section id="ai" class="ai" aria-labelledby="ai-title" data-ai-section data-state="off">
  <div class="wrap">
    <div class="ai__head">
      <div class="node ai__switch">
        <button type="button" role="switch" aria-checked="false" class="switch" data-ai-toggle aria-labelledby="ai-title">
          <span class="switch__track"><span class="switch__thumb"></span></span>
          <span class="switch__label">{copy.ai}</span>
        </button>
        <span class="ai__state">
          {modes.map((m) => <span data-for={m}>{copy.states[m].label}</span>)}
        </span>
      </div>

      <div class="ai__texts">
        {
          modes.map((m) => (
            <div class="ai__text" data-for={m} aria-hidden={m === "on" ? "true" : undefined}>
              <h2 id={m === "off" ? "ai-title" : undefined} class="title-node ai__title">
                {copy.states[m].title}
              </h2>
              <div class="node doc ai__body">
                <p>{copy.states[m].body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="node ai__window bleed-both">
      <div class="ai__window-head">
        <Icon name="lucide:layout-dashboard" />
        {copy.window}
        <span class="ai__badge" aria-hidden="true">
          <span class="ai__dot"></span>
          <span class="ai__badge-ai">{copy.ai}</span>
          <span class="ai__badge-states">
            {modes.map((m) => <span data-for={m}>{copy.states[m].label}</span>)}
          </span>
        </span>
      </div>
      <div class="ai__screens">
        {
          modes.map((m) => (
            <video
              class="ai__clip"
              data-for={m}
              src={`/clips/ai-${m}-${lang}.mp4`}
              poster={`/clips/ai-${m}-${lang}.webp`}
              muted
              playsinline
              loop
              preload={m === "off" ? "auto" : "metadata"}
              width="1280"
              height="720"
              aria-label={copy.states[m].alt}
            ></video>
          ))
        }
      </div>
    </div>
    <Edge from={50} to={14} height={72} class="ai__out" />
  </div>
</section>

<script>
  import { prefersReducedMotion } from "@/scripts/reduced-motion";

  document.querySelectorAll<HTMLElement>("[data-ai-section]").forEach((section) => {
    const toggle = section.querySelector<HTMLButtonElement>("[data-ai-toggle]")!;
    const clips = [...section.querySelectorAll<HTMLVideoElement>("video[data-for]")];
    const texts = [...section.querySelectorAll<HTMLElement>(".ai__text")];
    const reduced = prefersReducedMotion();
    let visible = false;

    const play = () => {
      clips.forEach((clip) => {
        const active = clip.dataset.for === section.dataset.state;
        if (active && visible && !reduced) {
          clip.currentTime = 0;
          void clip.play().catch(() => {});
        } else clip.pause();
      });
    };

    const set = (state: "off" | "on", fromHero = false) => {
      if (section.dataset.state === state) return;
      section.dataset.state = state;
      toggle.setAttribute("aria-checked", String(state === "on"));
      texts.forEach((text) => text.setAttribute("aria-hidden", String(text.dataset.for !== state)));
      play();
      if (!fromHero) document.dispatchEvent(new CustomEvent("nolenor:ai", { detail: { state, source: "section" } }));
    };

    toggle.addEventListener("click", () => set(section.dataset.state === "on" ? "off" : "on"));
    // The hero's switch says the same thing: keep the two in step.
    document.addEventListener("nolenor:ai", (event) => {
      const { state, source } = (event as CustomEvent<{ state: "off" | "on"; source: string }>).detail;
      if (source !== "section") set(state, true);
    });

    // Play only while the section is on screen.
    new IntersectionObserver(
      (entries) => {
        visible = entries.some((entry) => entry.isIntersecting);
        if (visible) play();
        else clips.forEach((clip) => clip.pause());
      },
      { threshold: 0.35 },
    ).observe(section.querySelector(".ai__window")!);
  });
</script>

<style>
  .ai {
    padding-block: var(--section-gap-s) 0;
  }

  .ai__head {
    display: grid;
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .ai__switch {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    justify-self: start;
    padding: 4px 16px 4px 6px;
  }

  .switch {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: 48px;
    padding: 0 6px;
    border: 0;
    background: none;
    font: 800 18px / 1 var(--font-body);
    color: var(--color-ink);
    cursor: pointer;
  }

  .switch__track {
    position: relative;
    width: 56px;
    height: 32px;
    border-radius: 999px;
    background: #cbd5e1;
    transition: background-color 380ms var(--ease-out);
  }

  .switch__thumb {
    position: absolute;
    top: 4px;
    left: 4px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 3px rgb(15 23 42 / 0.25);
    transition: transform 380ms var(--ease-out);
  }

  [data-state="on"] .switch__track {
    background: #7c3aed;
  }

  [data-state="on"] .switch__thumb {
    transform: translateX(24px);
  }

  .switch:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: 999px;
  }

  .ai__state,
  .ai__badge-states,
  .ai__texts {
    display: grid;
  }

  .ai__state {
    font-size: 16px;
    font-weight: 700;
    color: #64748b;
  }

  /* Each state's words share one cell and swap: the outgoing ones slide up
     and out, the incoming ones come up from below. */
  .ai__state > span,
  .ai__badge-states > span,
  .ai__text {
    grid-area: 1 / 1;
    transition:
      opacity 380ms var(--ease-out),
      transform 380ms var(--ease-out);
  }

  [data-state="off"] [data-for="on"]:not(video),
  [data-state="on"] [data-for="off"]:not(video) {
    opacity: 0;
    transform: translateY(14px);
    pointer-events: none;
  }

  [data-state="off"] .ai__text[data-for="on"],
  [data-state="on"] .ai__text[data-for="off"] {
    visibility: hidden;
    transition:
      opacity 380ms var(--ease-out),
      transform 380ms var(--ease-out),
      visibility 0s 380ms;
  }

  .ai__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .ai__title {
    margin: 0 0 0 -8px;
    font-size: var(--text-section);
    line-height: 1.08;
  }

  .ai__text[data-for="on"] .ai__title {
    color: #6d28d9;
  }

  .ai__body {
    max-width: 36rem;
    font-size: var(--text-lg);
  }

  .ai__window {
    overflow: hidden;
    transition: box-shadow 380ms var(--ease-out);
  }

  /* With the AI on, the window takes Nolë's violet outline (NoleNodeLayer). */
  [data-state="on"] .ai__window {
    box-shadow:
      0 0 0 2px rgb(124 58 237 / 0.55),
      0 12px 36px -12px rgb(124 58 237 / 0.45);
  }

  .ai__window-head {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 42px;
    padding: 0 14px;
    border-bottom: 1px solid #eef2f6;
    font-size: 14px;
    font-weight: 700;
    color: #475569;
  }

  .ai__window-head svg {
    width: 16px;
    height: 16px;
  }

  .ai__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    padding: 2px 10px;
    border-radius: 999px;
    background: #f1f5f9;
    font-size: 12px;
  }

  .ai__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #94a3b8;
    transition: background-color 380ms var(--ease-out);
  }

  [data-state="on"] .ai__dot {
    background: #7c3aed;
  }

  .ai__screens {
    position: relative;
    display: grid;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #f1f5f9;
  }

  /* The clips: switching on, the "off" clip slides away to the left and the
     "on" clip comes in from the right; switching off, the other way round. */
  .ai__clip {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 520ms var(--ease-out),
      opacity 520ms var(--ease-out);
  }

  [data-state="off"] .ai__clip[data-for="on"] {
    transform: translateX(10%) scale(0.95);
    opacity: 0;
  }

  [data-state="on"] .ai__clip[data-for="off"] {
    transform: translateX(-10%) scale(0.95);
    opacity: 0;
  }

  .ai :global(.ai__out) {
    margin-top: var(--space-md);
  }

  @media (prefers-reduced-motion: reduce) {
    .switch__track,
    .switch__thumb,
    .ai__state > span,
    .ai__badge-states > span,
    .ai__text,
    .ai__clip,
    .ai__window,
    .ai__dot {
      transition: none;
    }
  }
</style>
