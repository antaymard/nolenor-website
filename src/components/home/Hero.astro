---
import { Icon } from "astro-icon/components";
import PagesToCanvas from "@/components/home/PagesToCanvas.astro";
import Edge from "@/components/home/Edge.astro";
import { APP_SIGNUP_URL, PUBLIC_CANVAS_URL } from "@/lib/constants";
import { getLang } from "@/i18n";

const lang = getLang(Astro.currentLocale);

const en = {
  pace: "Your whole project on one canvas.",
  ai: "And AI by your side.",
  lede: "Nolënor is an infinite canvas for deep work. Structure your ideas, explore options with AI, keep your dashboards in one place, plan what comes next.",
  terms: "Open beta. No card, export any time.",
  cta: "Open a canvas",
  second: "See a real canvas",
  note: "From nested documents to a visual, structured space: the same project, with all its depth. Drag to go from one to the other.",
  window: "Unfold your page tree: your whole project at a glance.",
};
const fr: typeof en = {
  pace: "Tout votre projet sur un canvas.",
  ai: "Et l’IA à vos côtés.",
  lede: "Nolënor est un canvas infini pour travailler en profondeur. Structurez vos idées, explorez des pistes avec l’IA, centralisez vos tableaux de bord, planifiez la suite.",
  terms: "Bêta ouverte. Sans carte, export à tout moment.",
  cta: "Ouvrir un canvas",
  second: "Voir un vrai canvas",
  note: "De documents imbriqués à un espace visuel et structuré : le même projet, avec toute sa profondeur. Faites glisser pour passer de l’un à l’autre.",
  window: "Dépliez votre arborescence : tout votre projet, d’un seul regard.",
};
const copy = { en, fr }[lang];

/*
 * The hero is a corner of a canvas. The headline is a Title node, selected;
 * a yellow node beside it points, with a real edge, at the window below,
 * which holds the pages-to-canvas slider. Under it, the pitch is a document
 * node and "See a real canvas" a Link node. The AI switch lives in its own
 * section, further down.
 */
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero__top">
    <h1 id="hero-title" class="title-node title-node--selected hero__title">
      <span>{copy.pace}</span>
      <span class="hero__ai">{copy.ai}</span>
      <span class="handles" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    </h1>
    <div class="node node--yellow doc hero__note">{copy.note}</div>
  </div>

  <div class="wrap">
    <Edge from={87} to={84} height={44} class="hero__edge" />
    <div class="node hero__window bleed-both">
      <div class="hero__window-head">
        <Icon name="lucide:notebook-text" />
        {copy.window}
      </div>
      <PagesToCanvas />
    </div>

    <!-- The pitch and the two ways in, in one brand-coloured block sitting
         across the line where the dark hero meets the light page. -->
    <div class="hero__cta">
      <div class="hero__pitch">
        <p class="hero__lede">{copy.lede}</p>
        <p class="hero__terms">{copy.terms}</p>
      </div>
      <div class="hero__actions">
        <a href={APP_SIGNUP_URL} class="btn btn--inverse" rel="noopener noreferrer">{copy.cta}</a>
        <a href={PUBLIC_CANVAS_URL} class="hero__second" rel="noopener noreferrer">
          <Icon name="lucide:link" />{copy.second}<Icon name="lucide:arrow-up-right" class="hero__ext" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* The app's dark canvas preset (#0f172a, dots): it sets the light grey
     of the slider apart. Nodes stay white, as they do on a dark canvas in
     the app. */
  /* The CTA block hangs below the hero by this much; the hero's margin
     gives it back, so the next section keeps its full gap below the block. */
  .hero {
    --cta-overhang: calc(var(--space-2xl) + 24px);
    margin-bottom: var(--cta-overhang);
    position: relative;
    z-index: 1;
    padding-block: var(--space-3xl) var(--space-2xl);
    background-color: #0f172a;
    background-image: radial-gradient(rgb(255 255 255 / 0.16) 1px, transparent 1.3px);
    background-size: 16px 16px;
  }

  .hero__title {
    color: #f8fafc;
  }

  /* Half on the dark hero, half on the light page below. */
  .hero__cta {
    position: relative;
    display: grid;
    gap: var(--space-lg) var(--space-2xl);
    align-items: center;
    max-width: 62rem;
    margin: var(--space-2xl) auto calc(-1 * var(--cta-overhang));
    padding: var(--space-lg);
    border-radius: 16px;
    background: var(--color-accent);
    box-shadow:
      0 24px 48px -20px rgb(15 23 42 / 0.45),
      0 0 0 1px rgb(255 255 255 / 0.08) inset;
    color: #fff;
  }

  .hero__lede {
    max-width: 36rem;
    font-size: var(--text-lead);
    line-height: 1.5;
    color: #fff;
    text-wrap: pretty;
  }

  .hero__terms {
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    color: oklch(0.87 0.03 276);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-lg);
  }

  .hero__second {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 700;
    color: #fff;
    text-decoration: underline;
    text-decoration-color: rgb(255 255 255 / 0.4);
    text-underline-offset: 0.3em;
  }

  .hero__second:hover {
    text-decoration-color: #fff;
  }

  .hero__second svg {
    width: 17px;
    height: 17px;
  }

  .hero__second :global(.hero__ext) {
    width: 15px;
    height: 15px;
    opacity: 0.7;
  }

  @media (min-width: 60rem) {
    .hero {
      --cta-overhang: calc(var(--space-2xl) + 72px);
    }

    .hero__cta {
      grid-template-columns: minmax(0, 1fr) auto;
      margin-bottom: calc(-1 * var(--cta-overhang));
      padding: var(--space-xl) var(--space-2xl);
    }

    .hero__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero__actions .btn {
      width: 100%;
    }
  }

  .hero__top {
    display: grid;
    gap: var(--space-lg);
    align-items: end;
  }



  .hero__title {
    display: flex;
    flex-direction: column;
    justify-self: start;
    margin: 0 0 0 -8px;
    font-size: min(var(--text-display), 3.4rem);
    line-height: 1.04;
  }

  .hero__ai {
    color: oklch(0.8 0.07 276.514);
  }

  @media (min-width: 60rem) {
    .hero__title > span:not(.handles):not(.cursor) {
      white-space: nowrap;
    }
  }

















  .hero__note {
    max-width: 19rem;
    color: #713f12;
    font-weight: 600;
  }

  .hero__edge {
    display: none;
  }

  /* Wide enough: the title keeps its two set lines, the note sits beside. */
  @media (min-width: 75rem) {
    .hero__top {
      grid-template-columns: max-content minmax(0, 1fr);
      gap: var(--space-2xl);
    }
  }

  .hero__window {
    margin-top: var(--space-xl);
    overflow: hidden;
  }

  .hero__window-head {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 42px;
    padding: 0 14px;
    border-bottom: 1px solid #eef2f6;
    font-size: 14px;
    font-weight: 700;
    color: #475569;
  }

  .hero__window-head svg {
    width: 16px;
    height: 16px;
  }

  @media (min-width: 60rem) {
    .hero__top {
      gap: var(--space-lg);
    }

    .hero__note {
      justify-self: end;
    }

    .hero__edge {
      display: block;
    }

    /* The slider is the hero's proof: it takes the full bleed on both sides. */
    .hero__window {
      margin-top: 0;
      margin-inline: calc(-1 * var(--bleed));
    }


  }

</style>
