---
import { Icon } from "astro-icon/components";
import PagesToCanvas from "@/components/home/PagesToCanvas.astro";
import Edge from "@/components/home/Edge.astro";
import { APP_SIGNUP_URL, PUBLIC_CANVAS_URL } from "@/lib/constants";
import { getLang } from "@/i18n";

const lang = getLang(Astro.currentLocale);

const en = {
  pace: "Think at your own pace.",
  ai: "AI when you want it.",
  you: "You",
  lede: "Nolënor is an infinite canvas for deep work. Structure your ideas, explore options with AI, keep your dashboards in one place, plan what comes next.",
  terms: "Open beta. No card, export any time.",
  cta: "Open a canvas",
  second: "See a real canvas",
  nole: "Nolë",
  aiLabel: "AI",
  off: "Off, it is already a full tool: documents, tables, views and files, all on the canvas.",
  on: "On, Nolë works with you, in small steps you can follow and redirect.",
  note: "The same project, in pages then on a canvas. Drag to go from one to the other.",
  window: "WMS rollout · from pages to canvas",
};
const fr: typeof en = {
  pace: "Pensez à votre rythme.",
  ai: "L’IA, quand vous voulez.",
  you: "Vous",
  lede: "Nolënor est un canvas infini pour travailler en profondeur. Structurez vos idées, explorez des pistes avec l’IA, centralisez vos tableaux de bord, planifiez la suite.",
  terms: "Bêta ouverte. Sans carte, export à tout moment.",
  cta: "Ouvrir un canvas",
  second: "Voir un vrai canvas",
  nole: "Nolë",
  aiLabel: "IA",
  off: "Éteinte, c’est déjà un outil complet : documents, tables, vues et fichiers, tout sur le canvas.",
  on: "Allumée, Nolë travaille avec vous, par petites étapes que vous suivez et redirigez.",
  note: "Le même projet, en pages puis en canvas. Faites glisser pour passer de l’un à l’autre.",
  window: "WMS rollout · des pages au canvas",
};
const copy = { en, fr }[lang];

/*
 * The hero is a corner of a canvas. The headline is a Title node, selected,
 * with your cursor on it; the pitch is a document node; "See a real canvas"
 * is a Link node; the AI switch sits in a node of its own; a yellow node
 * points, with a real edge, at the window below, which holds the
 * pages-to-canvas slider.
 */
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__main">
      <h1 id="hero-title" class="title-node title-node--selected hero__title">
        <span>{copy.pace}</span>
        <span class="hero__ai">{copy.ai}</span>
        <span class="handles" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="cursor hero__cursor" aria-hidden="true">
          <svg width="18" height="20" viewBox="0 0 18 20"><path d="M1 1 L1 16 L5 12 L8 19 L11 18 L8 11 L14 11 Z" fill="#505785" stroke="white" stroke-width="1.5"></path></svg>
          <span style="background:#505785">{copy.you}</span>
        </span>
      </h1>

      <div class="node doc hero__lede">
        <p>{copy.lede}</p>
        <p class="hero__terms">{copy.terms}</p>
      </div>

      <div class="hero__actions">
        <a href={APP_SIGNUP_URL} class="btn" rel="noopener noreferrer">{copy.cta}</a>
        <a href={PUBLIC_CANVAS_URL} class="node link-node" rel="noopener noreferrer">
          <Icon name="lucide:link" />{copy.second}<Icon name="lucide:arrow-up-right" class="hero__ext" />
        </a>
      </div>
    </div>

    <div class="hero__side">
      <div class="node hero__switch" data-ai-switch>
        <div class="hero__switch-head"><span class="hero__tile">N</span>{copy.nole}</div>
        <div class="hero__switch-body">
          <button type="button" role="switch" aria-checked="false" class="switch" aria-describedby="hero-ai-state">
            <span class="switch__track"><span class="switch__thumb"></span></span>
            <span class="switch__label">{copy.aiLabel}</span>
          </button>
          <p id="hero-ai-state" aria-live="polite" data-off={copy.off} data-on={copy.on}>{copy.off}</p>
        </div>
      </div>
      <div class="node node--yellow doc hero__note">{copy.note}</div>
    </div>
  </div>

  <div class="wrap">
    <Edge from={87} to={84} height={56} class="hero__edge" />
    <div class="node hero__window bleed-both">
      <div class="hero__window-head">
        <Icon name="lucide:notebook-text" />
        {copy.window}
      </div>
      <PagesToCanvas />
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-ai-switch]").forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>('[role="switch"]')!;
    const state = root.querySelector<HTMLElement>("#hero-ai-state")!;
    button.addEventListener("click", () => {
      const on = button.getAttribute("aria-checked") !== "true";
      button.setAttribute("aria-checked", String(on));
      state.textContent = (on ? state.dataset.on : state.dataset.off) ?? "";
    });
  });
</script>

<style>
  .hero {
    padding-block: var(--space-2xl) var(--section-gap-s);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }

  .hero__main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-lg);
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    margin: 0 0 var(--space-sm) -8px;
    font-size: clamp(2.4rem, 4vw + 0.6rem, 4.25rem);
    line-height: 1.02;
  }

  .hero__ai {
    color: var(--color-accent);
  }

  @media (min-width: 60rem) {
    .hero__title > span:not(.handles):not(.cursor) {
      white-space: nowrap;
    }
  }

  .hero__cursor {
    right: 12%;
    bottom: -26px;
  }

  .hero__lede {
    max-width: 38rem;
    font-size: var(--text-lg);
  }

  .hero__terms {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
  }

  .hero__ext {
    width: 15px !important;
    height: 15px !important;
    color: var(--color-muted);
  }

  .hero__side {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .hero__switch-head {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 14px;
    border-bottom: 1px solid #eef2f6;
    font-size: 14px;
    font-weight: 700;
    color: #475569;
  }

  .hero__tile {
    display: inline-flex;
    width: 20px;
    height: 20px;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    background: #7c3aed;
    font-size: 11px;
    font-weight: 800;
    color: #fff;
  }

  .hero__switch-body {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 12px 14px 14px 8px;
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--color-ink-2);
  }

  .hero__switch-body p {
    min-height: 2.9em;
    display: flex;
    align-items: center;
  }

  .switch {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--space-xs);
    min-height: 44px;
    padding: 0 6px;
    border: 0;
    background: none;
    font: 800 var(--text-sm) / 1 var(--font-body);
    color: var(--color-ink);
    cursor: pointer;
  }

  .switch__track {
    position: relative;
    width: 40px;
    height: 24px;
    border-radius: 999px;
    background: #cbd5e1;
    transition: background-color var(--dur-short) var(--ease-out);
  }

  .switch__thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.2);
    transition: transform var(--dur-short) var(--ease-out);
  }

  .switch[aria-checked="true"] .switch__track {
    background: var(--color-accent);
  }

  .switch[aria-checked="true"] .switch__thumb {
    transform: translateX(16px);
  }

  .switch:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: 999px;
  }

  .hero__note {
    max-width: 20rem;
    color: #713f12;
    font-weight: 600;
  }

  .hero__edge {
    display: none;
  }

  .hero__window {
    margin-top: var(--space-xl);
    overflow: hidden;
  }

  .hero__window-head {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 42px;
    padding: 0 14px;
    border-bottom: 1px solid #eef2f6;
    font-size: 14px;
    font-weight: 700;
    color: #475569;
  }

  .hero__window-head svg {
    width: 16px;
    height: 16px;
  }

  @media (min-width: 60rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      gap: var(--space-2xl);
    }

    .hero__grid {
      align-items: stretch;
    }

    .hero__side {
      padding-top: var(--space-lg);
      align-items: flex-end;
      justify-content: space-between;
    }

    .hero__switch {
      width: 100%;
      max-width: 22rem;
    }

    .hero__edge {
      display: block;
    }

    .hero__window {
      margin-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .switch__track,
    .switch__thumb {
      transition: none;
    }
  }
</style>
