---
import { Icon } from "astro-icon/components";
import PagesToCanvas from "@/components/home/PagesToCanvas.astro";
import { APP_SIGNUP_URL, PUBLIC_CANVAS_URL } from "@/lib/constants";
import { getLang } from "@/i18n";

const lang = getLang(Astro.currentLocale);

const en = {
  pace: "Your whole project on one canvas.",
  ai: "With or without AI.",
  lede: "An infinite canvas to think, organise and run your projects, with AI when you need it.",
  terms: "Open beta. No card, export any time.",
  madeIn: "",
  cta: "Open a canvas",
  second: "See a real canvas",
};
const fr: typeof en = {
  pace: "Tout votre projet sur un canvas.",
  ai: "Avec ou sans IA.",
  lede: "Un canvas infini pour penser, organiser et piloter vos projets, avec l’IA quand vous en avez besoin.",
  terms: "Bêta ouverte. Sans carte, export à tout moment.",
  madeIn: "Made in France",
  cta: "Ouvrir un canvas",
  second: "Voir un vrai canvas",
};
const copy = { en, fr }[lang];

/*
 * The hero is a corner of a canvas on lavender. The headline is a Title node,
 * selected; beside it, the pitch and the
 * two ways in. Below, the window holds the pages-to-canvas slider.
 */
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <!-- An edge from the title down to the animation, curving between the
       pitch and the buttons (drawn by the script below, wide screens). -->
  <svg class="hero__edge" aria-hidden="true"></svg>
  <div class="wrap hero__top">
    <div class="hero__head">
      <h1 id="hero-title" class="title-node title-node--selected hero__title">
        <span>{copy.pace}</span>
        <span class="hero__ai">{copy.ai}</span>
        <span class="handles" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      </h1>
    </div>

    <div class="hero__aside">
      <p class="hero__lede">{copy.lede}</p>
      <div class="hero__go">
      <div class="hero__actions">
        <a href={APP_SIGNUP_URL} class="btn" rel="noopener noreferrer">{copy.cta}</a>
        <a href={PUBLIC_CANVAS_URL} class="node link-node hero__second" rel="noopener noreferrer">
          <Icon name="lucide:layout-grid" />{copy.second}<Icon name="lucide:arrow-up-right" class="hero__ext" />
        </a>
      </div>
      <p class="hero__terms">{copy.terms}{copy.madeIn && <span class="hero__made"> · {copy.madeIn}</span>}</p>
      </div>
    </div>
  </div>

  <div class="wrap">
    <div class="node hero__window bleed-both">
      <PagesToCanvas />
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-hero]").forEach((hero) => {
    const svg = hero.querySelector<SVGSVGElement>(".hero__edge")!;
    const title = hero.querySelector<HTMLElement>(".hero__title")!;
    const lede = hero.querySelector<HTMLElement>(".hero__lede")!;
    const actions = hero.querySelector<HTMLElement>(".hero__actions")!;
    const win = hero.querySelector<HTMLElement>(".hero__window")!;
    const draw = () => {
      svg.innerHTML = "";
      if (!window.matchMedia("(min-width: 60rem)").matches) return;
      const o = hero.getBoundingClientRect();
      const r = (el: Element) => {
        const b = el.getBoundingClientRect();
        return { l: b.left - o.left, t: b.top - o.top, r: b.right - o.left, b: b.bottom - o.top };
      };
      const range = document.createRange();
      range.selectNodeContents(lede);
      const text = r(range);
      const t = r(title);
      const a = r(actions);
      const w = r(win);
      // From the title's bottom handle, out to the gap between the pitch's
      // words and the buttons, then down into the top of the window.
      const sx = (t.l + t.r) / 2;
      const sy = t.b + 5;
      const gx = (text.r + a.l) / 2;
      const ex = gx;
      const ey = w.t - 4;
      // One smooth curve, vertical at both ends: down out of the title,
      // across to the gap between the words and the buttons, down into the
      // window.
      const d = `M ${sx} ${sy} C ${sx} ${sy + 70}, ${ex} ${sy - 10}, ${ex} ${ey}`;
      svg.innerHTML = `<path d="${d}"/><polyline points="${ex - 6},${ey - 7.5} ${ex},${ey} ${ex + 6},${ey - 7.5}"/>`;
    };
    new ResizeObserver(draw).observe(hero);
    window.addEventListener("load", draw);
    document.fonts?.ready.then(draw);
  });
</script>

<style>
  .hero__edge {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .hero__edge :global(path),
  .hero__edge :global(polyline) {
    fill: none;
    stroke: #64748b;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* A corner of a canvas on lavender, the brand's indigo turned light,
     with its dots. Nodes stay white. */
  .hero {
    position: relative;
    z-index: 1;
    padding-block: var(--space-3xl) var(--section-gap-s);
    background-color: #c9cde6;
    background-image: radial-gradient(rgb(80 87 133 / 0.28) 1.1px, transparent 1.3px);
    background-size: 18px 18px;
  }



  .hero__top {
    display: grid;
    gap: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }

  .hero__head {
    position: relative;
    justify-self: start;
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    margin: 0 0 0 -14px;
    /* A title node on a white ground, as on the canvas, still selected. */
    padding: 8px 14px 10px;
    border-radius: 8px;
    background: #fff;
    font-size: min(var(--text-display), 3.4rem);
    line-height: 1.04;
  }

  .hero__ai {
    color: var(--color-accent);
  }

  .hero__aside {
    display: grid;
    gap: var(--space-lg) var(--space-2xl);
    align-items: start;
  }

  .hero__lede {
    max-width: 34rem;
  }

  .hero__lede {
    font-size: var(--text-lead);
    line-height: 1.5;
    color: #1e293b;
    text-wrap: pretty;
  }

  /* Phones: the title node sits inside the gutter (its handles clear the
     screen's edge), and the pitch follows closer. */
  @media (max-width: 39.99rem) {
    .hero {
      padding-block: var(--space-2xl) var(--space-2xl);
    }

    .hero__top {
      gap: var(--space-lg);
      margin-bottom: var(--space-xl);
    }

    .hero__title {
      margin-left: 0;
      font-size: clamp(2rem, 9vw, 2.5rem);
    }
  }

  /* Both ways in, the same size. */
  .hero__actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
  }

  .hero__actions > a {
    justify-content: center;
    height: 48px;
    min-height: 48px;
    margin: 0;
    padding: 0 18px;
    white-space: nowrap;
  }

  @media (max-width: 26rem) {
    .hero__actions {
      grid-template-columns: 1fr;
    }
  }

  /* "See a real canvas" is a Link node. */
  .hero__second {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 14px;
    font-weight: 700;
    color: var(--color-ink);
  }

  .hero__second :global(.hero__ext) {
    width: 15px;
    height: 15px;
    opacity: 0.6;
  }

  .hero__terms {
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    color: #475569;
  }

  .hero__made {
    white-space: nowrap;
    font-weight: 700;
    color: var(--color-ink);
  }

  .hero__window {
    overflow: hidden;
  }


  @media (min-width: 60rem) {
    .hero__title > span:not(.handles) {
      white-space: nowrap;
    }

    /* The slider is the hero's proof: it takes the full bleed on both sides. */
    .hero__window {
      margin-inline: calc(-1 * var(--bleed));
    }
  }

  /* Wide enough: the pitch on the left, the ways in on the right. */
  @media (min-width: 60rem) {
    .hero__aside {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
</style>
