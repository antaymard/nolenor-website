---
import { Icon } from "astro-icon/components";
import { APP_SIGNUP_URL, PUBLIC_CANVAS_URL } from "@/lib/constants";
import { getLang } from "@/i18n";

const lang = getLang(Astro.currentLocale);

const en = {
  pace: "Your whole project on one canvas.",
  ai: "And AI by your side.",
  lede: "Nolënor is an infinite canvas for deep work. Structure your ideas, explore options with AI, keep your dashboards in one place, plan what comes next.",
  terms: "Open beta. No card, export any time.",
  madeIn: "",
  cta: "Open a canvas",
  second: "See a real canvas",
  window: "A crêperie opening: tasks, figures, photos and the schedule, on one canvas.",
  alt: "A crêperie’s opening canvas: sub-canvases for the works, the menu and the team, a task board, photos, and two values computed from the board. A card is dragged to Done and the values follow; then, Alt held, a request is dictated with the board attached, and Nolë draws the opening schedule beside it.",
};
const fr: typeof en = {
  pace: "Tout votre projet sur un canvas.",
  ai: "Et l’IA à vos côtés.",
  lede: "Nolënor est un canvas infini pour travailler en profondeur. Structurez vos idées, explorez des pistes avec l’IA, centralisez vos tableaux de bord, planifiez la suite.",
  terms: "Bêta ouverte. Sans carte, export à tout moment.",
  madeIn: "Made in France",
  cta: "Ouvrir un canvas",
  second: "Voir un vrai canvas",
  window: "Une crêperie qui ouvre : tâches, chiffres, photos et planning, sur un seul canvas.",
  alt: "Le canvas d’ouverture d’une crêperie : des sous-canvas pour les travaux, la carte et l’équipe, un tableau de tâches, des photos et deux valeurs calculées à partir du tableau. Une carte passe en « Fait » et les valeurs suivent ; puis, Alt maintenu, une demande est dictée avec le tableau joint, et Nolë trace le planning d’ouverture à côté.",
};
const copy = { en, fr }[lang];

/*
 * The hero is a corner of a canvas. The headline is a Title node, selected;
 * the window below plays a short clip of a canvas at work (a card moved by
 * hand, values that follow, a dictated request Nolë answers on the canvas).
 * The pages-to-canvas slider (PagesToCanvas.astro) is kept, unused, in case
 * it comes back. Under it, the pitch is a document
 * node and "See a real canvas" a Link node. The AI switch lives in its own
 * section, further down.
 */
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <h1 id="hero-title" class="title-node title-node--selected hero__title">
      <span>{copy.pace}</span>
      <span class="hero__ai">{copy.ai}</span>
      <span class="handles" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    </h1>
  </div>

  <div class="wrap">
    <div class="node hero__window bleed-both">
      <div class="hero__window-head">
        <Icon name="lucide:layout-dashboard" />
        {copy.window}
      </div>
      <div class="hero__screen">
        <video
          class="hero__clip"
          src={`/clips/hero-${lang}.mp4`}
          poster={`/clips/hero-${lang}.webp`}
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          width="1920"
          height="1080"
          aria-label={copy.alt}
        ></video>
      </div>
    </div>

    <!-- The pitch and the two ways in, in one brand-coloured block sitting
         across the line where the dark hero meets the light page. -->
    <div class="hero__cta">
      <div class="hero__pitch">
        <p class="hero__lede">{copy.lede}</p>
        <p class="hero__terms">{copy.terms}{copy.madeIn && <span class="hero__made"> · {copy.madeIn}</span>}</p>
      </div>
      <div class="hero__actions">
        <a href={APP_SIGNUP_URL} class="btn btn--inverse" rel="noopener noreferrer">{copy.cta}</a>
        <a href={PUBLIC_CANVAS_URL} class="hero__second" rel="noopener noreferrer">
          <Icon name="lucide:link" />{copy.second}<Icon name="lucide:arrow-up-right" class="hero__ext" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* The app's dark canvas preset (#0f172a, dots): it sets the light grey
     of the slider apart. Nodes stay white, as they do on a dark canvas in
     the app. */
  /* The CTA block hangs below the hero by this much; the hero's margin
     gives it back, so the next section keeps its full gap below the block. */
  .hero {
    --cta-overhang: calc(var(--space-2xl) + 24px);
    margin-bottom: var(--cta-overhang);
    position: relative;
    z-index: 1;
    padding-block: var(--space-3xl) var(--space-2xl);
    background-color: #0f172a;
    background-image: radial-gradient(rgb(255 255 255 / 0.16) 1px, transparent 1.3px);
    background-size: 16px 16px;
  }

  .hero__title {
    color: #f8fafc;
  }

  /* Half on the dark hero, half on the light page below. */
  .hero__cta {
    position: relative;
    display: grid;
    gap: var(--space-lg) var(--space-2xl);
    align-items: center;
    max-width: 62rem;
    margin: var(--space-2xl) auto calc(-1 * var(--cta-overhang));
    padding: var(--space-lg);
    border-radius: 16px;
    background: var(--color-accent);
    box-shadow:
      0 24px 48px -20px rgb(15 23 42 / 0.45),
      0 0 0 1px rgb(255 255 255 / 0.08) inset;
    color: #fff;
  }

  .hero__lede {
    max-width: 36rem;
    font-size: var(--text-lead);
    line-height: 1.5;
    color: #fff;
    text-wrap: pretty;
  }

  .hero__made {
    font-weight: 700;
    color: #fff;
  }

  .hero__terms {
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    color: oklch(0.87 0.03 276);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-lg);
  }

  .hero__second {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 700;
    color: #fff;
    text-decoration: underline;
    text-decoration-color: rgb(255 255 255 / 0.4);
    text-underline-offset: 0.3em;
  }

  .hero__second:hover {
    text-decoration-color: #fff;
  }

  .hero__second svg {
    width: 17px;
    height: 17px;
  }

  .hero__second :global(.hero__ext) {
    width: 15px;
    height: 15px;
    opacity: 0.7;
  }

  @media (min-width: 60rem) {
    .hero {
      --cta-overhang: calc(var(--space-2xl) + 72px);
    }

    .hero__cta {
      grid-template-columns: minmax(0, 1fr) auto;
      margin-bottom: calc(-1 * var(--cta-overhang));
      padding: var(--space-xl) var(--space-2xl);
    }

    .hero__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero__actions .btn {
      width: 100%;
    }
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    justify-self: start;
    margin: 0 0 0 -8px;
    font-size: var(--text-display);
    line-height: 1.04;
  }

  .hero__ai {
    color: oklch(0.8 0.07 276.514);
  }

  @media (min-width: 60rem) {
    .hero__title > span:not(.handles):not(.cursor) {
      white-space: nowrap;
    }
  }

  .hero__window {
    margin-top: var(--space-xl);
    overflow: hidden;
  }

  .hero__window-head {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 42px;
    padding: 0 14px;
    border-bottom: 1px solid #eef2f6;
    font-size: 14px;
    font-weight: 700;
    color: #475569;
  }

  .hero__screen {
    padding: 10px;
    background: #f1f5f9;
  }

  .hero__clip {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
  }

  .hero__window-head svg {
    width: 16px;
    height: 16px;
  }

  @media (min-width: 60rem) {
    /* The slider is the hero's proof: it takes the full bleed on both sides. */
    .hero__window {
      margin-inline: calc(-1 * var(--bleed));
    }

  }

</style>
