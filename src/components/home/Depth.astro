---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getLang } from "@/i18n";
import canvasEn from "@/assets/img/home/depth-canvas-en.webp";
import canvasFr from "@/assets/img/home/depth-canvas-fr.webp";
import searchEn from "@/assets/img/home/f-search-en.webp";
import searchFr from "@/assets/img/home/f-search-fr.webp";

const lang = getLang(Astro.currentLocale);

type Title = [before: string, selected: string, after: string];
type Point = { n: number; title: string; body: string };

const en = {
  title: ["Who said canvases were ", "only", " for brainstorming?"] as Title,
  lede: "On a Nolënor canvas, you file, you calculate, you find things again. Things a whiteboard doesn’t do.",
  soon: "Coming soon: automations.",
  canvas: canvasEn,
  canvasAlt: "A joinery workshop’s canvas: three sub-canvases (clients, workshop, purchasing), an open-quotes database seen as a kanban, two values computed from it through dotted ƒ links (weighted pipeline, win rate), and two charts kept up to date: revenue by month and quotes won by month.",
  search: searchEn,
  searchAlt: "The search finds one phrase in a voice memo at 1:12, on page 3 of a PDF and in a site note.",
  points: [
    { n: 1, title: "The detail when you need it, the big picture always.", body: "One canvas per client, per part of the business, per project: go down, come back up." },
    { n: 2, title: "Databases that stand up to the best tools.", body: "Records shaped to your needs, typed fields, and every view: table, kanban, calendar, gallery, timeline or list." },
    { n: 3, title: "Numbers that update themselves.", body: "A value computes from a table, a field or another node. A source changes, everything follows." },
    { n: 4, title: "Your metrics up to date, without copying them over.", body: "Mini-apps read your data and your tools, and keep themselves current." },
    { n: 5, title: "Find anything, even inside a voice memo.", body: "Documents, PDFs, images, recordings: one query, every match, at its page or its minute." },
  ] as Point[],
};
const fr: typeof en = {
  title: ["Qui a dit que les canvas, c’était ", "seulement", " pour brainstormer ?"] as Title,
  lede: "Sur un canvas Nolënor, on range, on calcule, on retrouve. Ce qu’un tableau blanc ne fait pas.",
  soon: "Bientôt : les automatisations.",
  canvas: canvasFr,
  canvasAlt: "Le canvas d’un atelier de menuiserie : trois sous-canvas (clients, atelier, achats), une base des devis en cours vue en kanban, deux valeurs calculées à partir d’elle par des liens ƒ en pointillés (pipeline pondéré, taux de signature), et deux graphiques tenus à jour : chiffre d’affaires par mois et devis signés par mois.",
  search: searchFr,
  searchAlt: "La recherche trouve une expression dans un mémo vocal à 1:12, à la page 3 d’un PDF et dans une note de chantier.",
  points: [
    { n: 1, title: "Le détail quand il faut, la vue d’ensemble toujours.", body: "Un canvas par client, par pan de l’entreprise, par projet : on descend, on remonte." },
    { n: 2, title: "Des bases de données à la hauteur des meilleurs outils.", body: "Des fiches sur mesure, des champs typés, et toutes les vues : table, kanban, calendrier, galerie, timeline ou liste." },
    { n: 3, title: "Des chiffres qui se mettent à jour tout seuls.", body: "Une valeur se calcule à partir d’un tableau, d’un champ ou d’un autre nœud. Une source change, tout suit." },
    { n: 4, title: "Vos indicateurs à jour, sans rien recopier.", body: "Des mini-apps lisent vos données et vos outils, et se tiennent à jour seules." },
    { n: 5, title: "Tout se retrouve, même dans un mémo vocal.", body: "Documents, PDF, images, enregistrements : une requête, chaque passage, à sa page ou à sa minute." },
  ] as Point[],
};
const copy = { en, fr }[lang];

/** Where each numbered pin sits on the canvas screen (% of its width and height). */
const PINS: Record<number, { x: number; y: number }> = {
  1: { x: 10.2, y: 11.1 },
  2: { x: 10.2, y: 31.8 },
  3: { x: 10.2, y: 72.5 },
  4: { x: 64.8, y: 11.1 },
};

/*
 * The answer to "a canvas is a whiteboard": one real canvas, rendered from
 * the app's own components at a single scale (sub-canvases, a database in a
 * view, values computed from it, a dashboard), with numbered pins, the
 * search panel laid over its corner, and the five benefits as a legend.
 * Automations, not built yet, get a small yellow note and no pin.
 */
---

<section id="depth" class="depth" aria-labelledby="depth-title">
  <div class="wrap">
    <h2 id="depth-title" class="depth__title">
      {copy.title[0]}<span class="title-node title-node--selected depth__word">{copy.title[1]}<span class="handles" aria-hidden="true"><i></i><i></i><i></i><i></i></span></span>{copy.title[2]}
    </h2>
    <div class="node doc depth__lede"><p>{copy.lede}</p></div>

    <div class="depth__stage">
      <figure class="node media depth__canvas">
        <div class="media__in">
          <Image src={copy.canvas} alt={copy.canvasAlt} widths={[720, 1080, 1440, 1920]} sizes="(min-width: 75rem) 1100px, 100vw" />
          {
            Object.entries(PINS).map(([n, p]) => (
              <span class="pin" style={`left:${p.x}%;top:${p.y}%`} aria-hidden="true">
                {n}
              </span>
            ))
          }
        </div>
      </figure>
      <figure class="node media depth__search">
        <div class="media__in">
          <Image src={copy.search} alt={copy.searchAlt} widths={[480, 720, 960]} sizes="(min-width: 60rem) 420px, 100vw" />
          <span class="pin" style="left:0;top:0" aria-hidden="true">5</span>
        </div>
      </figure>
    </div>

    <ol class="depth__legend">
      {
        copy.points.map((p) => (
          <li>
            <span class="pin pin--static" aria-hidden="true">{p.n}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="node node--yellow depth__soon">
      <Icon name="lucide:workflow" />
      {copy.soon}
    </div>
  </div>
</section>

<style>
  .depth {
    padding-block: var(--section-gap) 0;
  }

  .depth__title {
    max-width: 20ch;
    margin: 0 0 var(--space-lg);
    font-size: var(--text-section);
    font-weight: var(--weight-display);
    line-height: 1.15;
    letter-spacing: var(--tracking-display);
  }

  /* "seulement" / "only", the word that turns the question, is a selected
     Title node inside the sentence. */
  .depth__word {
    padding: 0 6px;
    margin: 0 2px;
    font-size: inherit;
    line-height: inherit;
    color: #2563eb;
  }

  .depth__lede {
    display: inline-block;
    max-width: 34rem;
    margin-bottom: var(--space-2xl);
    font-size: var(--text-lead);
  }

  .depth__stage {
    position: relative;
  }

  .depth__canvas,
  .depth__search {
    margin: 0;
  }

  .media__in {
    position: relative;
  }

  .depth__search {
    width: min(100%, 26rem);
    margin: var(--space-lg) 0 0 auto;
  }

  /* A numbered pin, the app's selection blue. */
  .pin {
    position: absolute;
    display: inline-flex;
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    align-items: center;
    justify-content: center;
    border: 2px solid #fff;
    border-radius: 50%;
    background: #2563eb;
    box-shadow: 0 2px 6px rgb(15 23 42 / 0.25);
    font-size: 13px;
    font-weight: 800;
    color: #fff;
  }

  .pin--static {
    position: static;
    margin: 0;
    flex-shrink: 0;
  }

  .depth__legend {
    display: grid;
    gap: var(--space-lg) var(--space-xl);
    margin: var(--space-2xl) 0 0;
    padding: 0;
    list-style: none;
  }

  .depth__legend li {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 4px 12px;
    align-content: start;
  }

  .depth__legend h3 {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-ink);
  }

  .depth__legend p {
    grid-column: 2;
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-ink-2);
  }

  .depth__soon {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: var(--space-xl);
    padding: 10px 16px;
    font-size: 14px;
    font-weight: 600;
    color: #713f12;
  }

  .depth__soon svg {
    width: 16px;
    height: 16px;
  }

  @media (min-width: 40rem) {
    .depth__legend {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 60rem) {
    /* The search panel is laid over the canvas's lower right corner, and
       runs past it, like a window opened on top. */
    .depth__stage {
      margin-right: 3rem;
      margin-bottom: 4rem;
    }

    .depth__search {
      position: absolute;
      right: -3rem;
      bottom: -4rem;
      width: 34%;
      margin: 0;
      box-shadow:
        0 24px 48px -16px rgb(15 23 42 / 0.3),
        0 1px 2px rgb(15 23 42 / 0.06);
    }

    .depth__legend {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-xl) var(--space-2xl);
    }
  }
</style>
