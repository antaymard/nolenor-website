        </>
      )
    }

    {
      name === "create" && (
        <>
          <g class="card ghost">
            <rect class="n" x="34" y="34" width="150" height="96" rx="12" />
            <rect class="ic" x="48" y="48" width="18" height="18" rx="5" />
            <rect class="t" x="74" y="53" width="70" height="8" rx="4" />
            <rect class="l" x="48" y="82" width="116" height="6" rx="3" />
            <rect class="l" x="48" y="96" width="90" height="6" rx="3" />
            <rect class="l" x="48" y="110" width="104" height="6" rx="3" />
          </g>

          <g class="card pop">
            <rect class="n sel" x="262" y="104" width="190" height="132" rx="12" />
            <rect class="ic" x="278" y="120" width="20" height="20" rx="5" />
