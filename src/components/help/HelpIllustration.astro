            <rect class="b caret" x="278" y="158" width="2" height="14" rx="1" />
            <rect class="l" x="278" y="184" width="150" height="6" rx="3" />
            <rect class="l" x="278" y="198" width="126" height="6" rx="3" />
            <rect class="l" x="278" y="212" width="140" height="6" rx="3" />
