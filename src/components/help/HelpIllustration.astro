          {copy.keys.map(([key, label], i) => (
            <g class={key === "D" ? "key key-active press" : "key"}>
              <rect class="key-base" x={34 + i * 50} y="245" width="40" height="40" rx="9" />
              <rect class="key-top" x={34 + i * 50} y="242" width="40" height="40" rx="9" />
              <text class="key-label" x={54 + i * 50} y="268" text-anchor="middle">
                {key}
              </text>
              <text class="caption" x={54 + i * 50} y="304" text-anchor="middle">
                {label}
              </text>
            </g>
          ))}
        </>
      )
    }

    {
      name === "open" && (
        <>
          <path class="beam" d="M150 198 L178 32 M150 280 L178 286" />

          <g class="card">
            <rect class="n sel" x="30" y="198" width="120" height="82" rx="12" />
            <rect class="ic" x="44" y="212" width="16" height="16" rx="4" />
            <rect class="t" x="66" y="216" width="56" height="7" rx="3.5" />
            <rect class="l" x="44" y="244" width="90" height="5" rx="2.5" />
            <rect class="l" x="44" y="256" width="70" height="5" rx="2.5" />
          </g>
          <circle class="ripple" cx="90" cy="239" r="12" />
          <circle class="ripple ripple-late" cx="90" cy="239" r="12" />

          <g class="card">
            <rect class="n" x="178" y="30" width="272" height="256" rx="14" />
            <path class="divider" d="M178 66 H450" />
            <rect class="ic" x="194" y="40" width="16" height="16" rx="4" />
            <rect class="t" x="218" y="44" width="92" height="8" rx="4" />
            <path class="glyph" d="M398 48 H406 M418 44 V52 M414 48 H422 M430 44 L438 52 M438 44 L430 52" />
            <rect class="t" x="198" y="86" width="150" height="12" rx="6" />
            <rect class="l" x="198" y="112" width="228" height="7" rx="3.5" />
            <rect class="l" x="198" y="126" width="206" height="7" rx="3.5" />
            <rect class="l" x="198" y="140" width="218" height="7" rx="3.5" />
            <rect class="l" x="198" y="154" width="146" height="7" rx="3.5" />
            <rect class="hl-soft" x="198" y="174" width="232" height="44" rx="8" />
            <rect class="hl-line" x="212" y="188" width="150" height="6" rx="3" />
            <rect class="hl-line" x="212" y="200" width="104" height="6" rx="3" />
            <rect class="l" x="198" y="236" width="200" height="7" rx="3.5" />
            <rect class="l" x="198" y="250" width="170" height="7" rx="3.5" />
          </g>
        </>
      )
    }

    {
      name === "connect" && (
        <>
          <path class="edge" d="M174 86 C 236 86, 240 80, 302 80" />
