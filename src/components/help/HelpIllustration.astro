---
import type { IllustrationName } from "@/data/help";
import { getLang } from "@/i18n";

interface Props {
  name: IllustrationName;
  alt: string;
  class?: string;
}

const { name, alt, class: className = "" } = Astro.props;

/*
 * Hand-drawn diagrams of the gestures the help page teaches, in the site's
 * own palette rather than screenshots.
 *
 * Screenshots go stale with every UI tweak and are unreadable at this size;
 * a diagram only has to show the one thing the paragraph next to it says.
 * Each one reuses the same vocabulary — a white card with an icon square, a
 * title bar and grey lines is a node, the brand colour is "what you just
 * did" — so after the first two, the reader stops decoding them.
 *
 * Everything draws from the CSS tokens, so a palette change reaches the
 * diagrams too. Motion is decorative and only runs when the reader hasn't
 * asked for reduced motion.
 */

// Words drawn inside the diagrams. The SVG boxes around them have fixed
// widths, so a couple of widths travel with the copy where French runs longer.
const en = {
  keys: [
    ["T", "Title"],
    ["D", "Doc"],
    ["A", "Table"],
    ["I", "Image"],
    ["L", "Link"],
  ],
  linkLabel: "supports",
  altClick: "Alt + click",
  marketStudy: "Market study",
  interviews: "Interviews",
  typing: "@Inter",
  chipWidth: 98,
  done: "Done",
  working: "Working",
  queued: "Queued",
  placeholder: "Ask Nolë anything, @ to mention a node",
  historyTitle: "Version history",
  history: [
    { who: "you", name: "You", what: "added a table", when: "Today, 16:20" },
    { who: "nole", name: "Nolë", what: "rewrote the intro", when: "Today, 15:02" },
    { who: "you", name: "You", what: "edited 3 paragraphs", when: "Yesterday" },
    { who: "nole", name: "Nolë", what: "created the document", when: "Last week" },
  ],
  restore: "Restore",
  restoreWidth: 60,
};

const fr: typeof en = {
  keys: [
    ["T", "Titre"],
    ["D", "Doc"],
    ["A", "Tableau"],
    ["I", "Image"],
    ["L", "Lien"],
  ],
  linkLabel: "soutient",
  altClick: "Alt + clic",
  marketStudy: "Étude de marché",
  interviews: "Entretiens",
  typing: "@Entre",
  chipWidth: 120,
  done: "Terminé",
  working: "En cours",
  queued: "En attente",
  placeholder: "Demandez à Nolë, @ pour mentionner un nœud",
  historyTitle: "Historique des versions",
  history: [
    { who: "you", name: "Vous", what: "avez ajouté un tableau", when: "Aujourd’hui, 16:20" },
    { who: "nole", name: "Nolë", what: "a réécrit l’intro", when: "Aujourd’hui, 15:02" },
    { who: "you", name: "Vous", what: "avez modifié 3 paragraphes", when: "Hier" },
    { who: "nole", name: "Nolë", what: "a créé le document", when: "La semaine dernière" },
  ],
  restore: "Restaurer",
  restoreWidth: 70,
};

const copy = { en, fr }[getLang(Astro.currentLocale)];
const historyRows = [96, 146, 196, 246];
---

<div class={`help-canvas relative overflow-hidden rounded-2xl border border-border ${className}`}>
  <svg viewBox="0 0 480 320" role="img" aria-label={alt} class="block h-auto w-full">
    {
      name === "navigate" && (
        <>
          <g class="drift">
            <g class="card">
              <rect class="n" x="36" y="40" width="140" height="92" rx="12" />
              <rect class="ic" x="50" y="54" width="18" height="18" rx="5" />
              <rect class="t" x="76" y="59" width="70" height="8" rx="4" />
              <rect class="l" x="50" y="88" width="110" height="6" rx="3" />
              <rect class="l" x="50" y="102" width="88" height="6" rx="3" />
              <rect class="l" x="50" y="116" width="100" height="6" rx="3" />
            </g>
            <g class="card">
              <rect class="n" x="306" y="30" width="146" height="100" rx="12" />
              <rect class="ic" x="320" y="44" width="18" height="18" rx="5" />
              <rect class="t" x="346" y="49" width="64" height="8" rx="4" />
              <rect class="hl-soft" x="320" y="74" width="118" height="42" rx="7" />
            </g>
            <g class="card">
              <rect class="n" x="58" y="204" width="132" height="82" rx="12" />
              <rect class="ic" x="72" y="218" width="18" height="18" rx="5" />
              <rect class="t" x="98" y="223" width="60" height="8" rx="4" />
              <rect class="l" x="72" y="250" width="100" height="6" rx="3" />
              <rect class="l" x="72" y="264" width="76" height="6" rx="3" />
            </g>
            <g class="card">
              <rect class="n" x="316" y="192" width="134" height="92" rx="12" />
              <rect class="ic" x="330" y="206" width="18" height="18" rx="5" />
              <rect class="t" x="356" y="211" width="58" height="8" rx="4" />
              <path class="grid" d="M330 238 H436 M330 254 H436 M330 270 H436 M366 232 V276 M402 232 V276" />
            </g>
          </g>

          <circle class="orbit" cx="240" cy="152" r="62" />
          <path class="arrow" d="M231 99 L240 90 L249 99" />
          <path class="arrow" d="M231 205 L240 214 L249 205" />
          <path class="arrow" d="M187 143 L178 152 L187 161" />
          <path class="arrow" d="M293 143 L302 152 L293 161" />

          <g class="card">
            <rect class="mouse" x="221" y="122" width="38" height="60" rx="19" />
            <path class="mouse-line" d="M240 122 V147" />
            <rect class="b wheel" x="236" y="130" width="8" height="14" rx="4" />
          </g>

          <g class="card">
            <rect class="n" x="388" y="264" width="68" height="32" rx="16" />
