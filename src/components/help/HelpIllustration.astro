            <rect class="ic" x="48" y="58" width="18" height="18" rx="5" />
            <rect class="t" x="74" y="63" width="66" height="8" rx="4" />
            <rect class="l" x="48" y="92" width="106" height="6" rx="3" />
            <rect class="l" x="48" y="106" width="80" height="6" rx="3" />
          </g>
          <g class="card">
            <rect class="n" x="302" y="32" width="146" height="98" rx="12" />
            <rect class="ic" x="316" y="46" width="18" height="18" rx="5" />
            <rect class="t" x="342" y="51" width="70" height="8" rx="4" />
            <rect class="l" x="316" y="80" width="114" height="6" rx="3" />
            <rect class="l" x="316" y="94" width="96" height="6" rx="3" />
            <rect class="l" x="316" y="108" width="104" height="6" rx="3" />
          </g>
          <g class="card">
            <rect class="n sel" x="166" y="206" width="152" height="84" rx="12" />
            <rect class="ic" x="180" y="220" width="18" height="18" rx="5" />
            <rect class="t" x="206" y="225" width="70" height="8" rx="4" />
            <rect class="l" x="180" y="254" width="118" height="6" rx="3" />
            <rect class="l" x="180" y="268" width="86" height="6" rx="3" />
          </g>

          <circle class="handle" cx="174" cy="86" r="4.5" />
          <circle class="handle" cx="302" cy="80" r="4.5" />
          <circle class="handle" cx="104" cy="128" r="4.5" />
          <circle class="handle" cx="375" cy="130" r="4.5" />

          <g class="card">
            <rect class="pill" x="204" y="71" width="70" height="24" rx="12" />
            <text class="pill-label" x="239" y="87" text-anchor="middle">{copy.linkLabel}</text>
          </g>
        </>
      )
    }

    {
      name === "context" && (
        <>
          <path class="edge edge-dashed flow" d="M190 88 C 232 88, 234 236, 274 236" />

          <rect class="halo" x="26" y="36" width="168" height="104" rx="15" />
          <g class="card">
            <rect class="n sel" x="30" y="40" width="160" height="96" rx="12" />
            <rect class="ic" x="44" y="54" width="18" height="18" rx="5" />
            <text class="label" x="70" y="67">{copy.marketStudy}</text>
            <rect class="l" x="44" y="88" width="124" height="6" rx="3" />
            <rect class="l" x="44" y="102" width="100" height="6" rx="3" />
            <rect class="l" x="44" y="116" width="112" height="6" rx="3" />
          </g>
          <g class="card">
            <rect class="n" x="30" y="184" width="160" height="96" rx="12" />
            <rect class="ic" x="44" y="198" width="18" height="18" rx="5" />
            <text class="label" x="70" y="211">{copy.interviews}</text>
            <rect class="l" x="44" y="232" width="118" height="6" rx="3" />
            <rect class="l" x="44" y="246" width="96" height="6" rx="3" />
          </g>

          <path
            class="cursor"
            transform="translate(150 104)"
            d="M0 0 L0 19 L5 14.5 L8.6 22 L11.8 20.5 L8.3 13.2 L14.6 13.2 Z"
          />
          <g>
            <rect class="tag" x="168" y="126" width="72" height="22" rx="11" />
            <text class="tag-label" x="204" y="141" text-anchor="middle">{copy.altClick}</text>
          </g>

          <g class="card">
            <rect class="n" x="250" y="24" width="206" height="272" rx="14" />
            <circle class="b" cx="272" cy="46" r="8" />
            <text class="label" x="288" y="50">Nolë</text>
            <rect class="bubble" x="324" y="68" width="116" height="30" rx="12" />
            <rect class="bubble-line" x="336" y="80" width="88" height="6" rx="3" />
            <rect class="l" x="266" y="114" width="164" height="6" rx="3" />
            <rect class="l" x="266" y="128" width="140" height="6" rx="3" />
            <rect class="l" x="266" y="142" width="152" height="6" rx="3" />

            <rect class="composer" x="262" y="214" width="182" height="70" rx="12" />
            <rect class="chip" x="272" y="225" width={copy.chipWidth} height="22" rx="11" />
            <rect class="b" x="280" y="232" width="8" height="8" rx="2" />
            <text class="chip-label" x="294" y="240">{copy.marketStudy}</text>
            <text class="label" x="274" y="270">{copy.typing}</text>
            <rect class="b caret" x="312" y="259" width="1.6" height="14" rx="0.8" />
          </g>

          <g class="card">
            <rect class="n" x="292" y="160" width="140" height="46" rx="10" />
            <rect class="chip" x="298" y="166" width="128" height="18" rx="6" />
            <text class="chip-label" x="306" y="179">{copy.interviews}</text>
            <rect class="l" x="306" y="192" width="82" height="5" rx="2.5" />
          </g>
        </>
      )
    }

    {
      name === "tasks" && (
        <>
          <g class="card ghost">
            <rect class="n" x="34" y="28" width="132" height="80" rx="12" />
            <rect class="ic" x="48" y="42" width="16" height="16" rx="4" />
            <rect class="t" x="72" y="46" width="60" height="7" rx="3.5" />
            <rect class="l" x="48" y="72" width="100" height="6" rx="3" />
            <rect class="l" x="48" y="86" width="74" height="6" rx="3" />
          </g>
          <g class="card ghost">
            <rect class="n" x="182" y="40" width="120" height="68" rx="12" />
            <rect class="ic" x="196" y="54" width="16" height="16" rx="4" />
            <rect class="t" x="220" y="58" width="54" height="7" rx="3.5" />
            <rect class="l" x="196" y="84" width="88" height="6" rx="3" />
          </g>
          <g class="card pop pop-slow">
            <rect class="n sel" x="322" y="26" width="128" height="88" rx="12" />
            <rect class="ic" x="336" y="40" width="16" height="16" rx="4" />
            <path class="spark" d="M344 43 L345.6 46.4 L349 48 L345.6 49.6 L344 53 L342.4 49.6 L339 48 L342.4 46.4 Z" />
            <rect class="t" x="360" y="44" width="60" height="7" rx="3.5" />
            <rect class="bar" x="336" y="84" width="14" height="18" rx="3" />
            <rect class="bar" x="356" y="72" width="14" height="30" rx="3" />
            <rect class="bar bar-strong" x="376" y="64" width="14" height="38" rx="3" />
            <rect class="bar" x="396" y="78" width="14" height="24" rx="3" />
          </g>

          <g class="card">
            <rect class="n" x="90" y="128" width="300" height="30" rx="15" />
            <circle class="b" cx="108" cy="143" r="8" />
            <path class="check" d="M104 143 L107 146 L112.5 140" />
            <rect class="t" x="124" y="139" width="150" height="7" rx="3.5" />
            <text class="caption" x="372" y="147" text-anchor="end">{copy.done}</text>
          </g>
          <g class="card">
            <rect class="n" x="90" y="166" width="300" height="30" rx="15" />
            <circle class="track" cx="108" cy="181" r="7" />
            <path class="spin" d="M108 174 A 7 7 0 0 1 115 181" />
            <rect class="t" x="124" y="177" width="120" height="7" rx="3.5" />
            <text class="caption" x="372" y="185" text-anchor="end">{copy.working}</text>
          </g>
          <g class="card">
            <rect class="n" x="90" y="204" width="300" height="30" rx="15" />
            <circle class="dot" cx="102" cy="219" r="2.2" />
            <circle class="dot" cx="108" cy="219" r="2.2" />
            <circle class="dot" cx="114" cy="219" r="2.2" />
            <rect class="t" x="124" y="215" width="96" height="7" rx="3.5" />
            <text class="caption" x="372" y="223" text-anchor="end">{copy.queued}</text>
          </g>

          <g class="card">
            <rect class="n omnibar" x="56" y="250" width="368" height="46" rx="23" />
            <text class="placeholder" x="80" y="277">{copy.placeholder}</text>
            <circle class="b" cx="400" cy="273" r="15" />
            <path class="send" d="M400 280 V266 M394 272 L400 266 L406 272" />
          </g>
        </>
      )
    }

    {
      name === "history" && (
        <>
          <g class="card">
            <rect class="n" x="56" y="22" width="368" height="276" rx="14" />
            <text class="heading" x="80" y="54">{copy.historyTitle}</text>
            <path class="divider" d="M56 70 H424" />
            <path class="rail" d="M96 96 V280" />

            {copy.history.map((row, i) => ({ ...row, y: historyRows[i], active: i === 1 })).map((entry) => (
              <g>
                {entry.active && <rect class="row-active" x="114" y={entry.y - 18} width="294" height="44" rx="10" />}
                <circle class={entry.who === "nole" ? "b" : "avatar-you"} cx="96" cy={entry.y + 4} r="11" />
                <text
                  class={entry.who === "nole" ? "avatar-label" : "avatar-label avatar-label-you"}
                  x="96"
                  y={entry.y + 8}
                  text-anchor="middle"
                >
                  {entry.name[0]}
                </text>
                <text class="label" x="126" y={entry.y + 1}>
                  <tspan class="strong">{entry.name}</tspan> {entry.what}
                </text>
                <text class="caption" x="126" y={entry.y + 17}>{entry.when}</text>
                {entry.active && (
                  <g>
                    <rect class="b" x={368 - copy.restoreWidth / 2} y={entry.y - 7} width={copy.restoreWidth} height="22" rx="11" />
                    <text class="restore" x="368" y={entry.y + 8} text-anchor="middle">{copy.restore}</text>
                  </g>
                )}
              </g>
            ))}
          </g>
        </>
      )
    }
  </svg>
</div>

<style>
  .help-canvas {
    background-color: color-mix(in srgb, var(--background) 45%, #ffffff);
    background-image: radial-gradient(
      color-mix(in srgb, var(--foreground) 16%, transparent) 1px,
      transparent 1.3px
    );
    background-size: 18px 18px;
    background-position: 9px 9px;
  }

  svg {
    font-family: var(--font-sans);
  }

  .card {
    filter: drop-shadow(0 6px 14px rgb(47 54 83 / 0.07));
  }

  .ghost {
    opacity: 0.45;
  }

  .n {
    fill: var(--surface);
    stroke: var(--border);
    stroke-width: 1.5;
  }

  .sel {
    stroke: var(--brand);
    stroke-width: 2;
  }

  .halo {
    fill: none;
    stroke: var(--brand);
    stroke-width: 6;
    opacity: 0.14;
  }

  .ic {
    fill: color-mix(in srgb, var(--brand) 16%, #ffffff);
  }

  .t {
    fill: var(--foreground);
    opacity: 0.78;
  }

  .l {
    fill: var(--muted);
  }

  .b {
    fill: var(--brand);
  }

  .hl-soft {
    fill: color-mix(in srgb, var(--highlight) 30%, #ffffff);
  }

  .hl-line {
    fill: color-mix(in srgb, var(--highlight) 70%, #ffffff);
  }

  .grid,
  .divider,
  .rail {
    fill: none;
    stroke: var(--border);
    stroke-width: 1.5;
  }

  .rail {
    stroke-width: 2;
  }

  .glyph,
  .doc {
    fill: none;
    stroke: var(--muted-foreground);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .doc {
    stroke: var(--brand);
    stroke-width: 1.5;
  }

  .orbit {
    fill: none;
    stroke: var(--brand);
    stroke-width: 1.5;
    stroke-dasharray: 3 6;
    opacity: 0.35;
  }

  .arrow {
    fill: none;
    stroke: var(--brand);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mouse {
    fill: var(--surface);
    stroke: var(--foreground);
    stroke-width: 2;
  }

