---
import { getLang } from "@/i18n";
import { md } from "@/lib/md";

interface Props {
  headers: string[];
  rows: string[][];
  caption?: string;
  /** Highlights one column (0-based), e.g. Nolënor's in a comparison. */
  highlight?: number;
  /** First cell of each row is a row header. */
  rowHeaders?: boolean;
  /** Highlights one row (0-based). */
  highlightRow?: number;
}

const { headers, rows, caption, highlight, rowHeaders = true, highlightRow } = Astro.props;
const lang = getLang(Astro.currentLocale);
/*
 * A real <table> on wide screens. Under 48rem each row becomes a card,
 * every cell labelled by its column header (data-label), so nothing has to
 * scroll sideways on a phone.
 */
---

<div class="dtable-wrap">
  <table class="dtable">
    {caption && <caption>{caption}</caption>}
    <thead>
      <tr>
        {headers.map((h, i) => <th scope="col" class:list={[i === highlight && "is-hl"]}>{h}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row, r) => (
          <tr class:list={[r === highlightRow && "is-hl-row"]}>
            {row.map((cell, i) =>
              i === 0 && rowHeaders ? (
                <th scope="row" data-label={headers[0]} set:html={md(cell, lang)} />
              ) : (
                <td data-label={headers[i]} class:list={[i === highlight && "is-hl"]} set:html={md(cell, lang)} />
              ),
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
