---
import { Icon } from "astro-icon/components";
import Container from "@/components/ui/Container.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";

const steps = [
  {
    icon: "lucide:layout-grid",
    title: "Create a canvas",
    description:
      "Start blank, or drop in a doc, a link, a PDF — whatever you're already working with.",
  },
  {
    icon: "lucide:sparkles",
    title: "Bring in Nolë",
    description:
      "Chat, @mention nodes, and let Nolë build structured blocks — not walls of text.",
  },
  {
    icon: "lucide:git-branch",
    title: "Keep moving",
    description:
      "Sub-agents work in the background while you stay focused on what matters most.",
  },
];
---

<section id="how-it-works" class="scroll-mt-20 py-24 sm:py-32">
  <Container class="flex flex-col gap-14">
    <SectionHeading
      align="center"
      eyebrow="How it works"
      title="From blank canvas to working session in three steps."
      class="mx-auto"
    />

    <div class="grid gap-10 sm:grid-cols-3" data-reveal>
      {
        steps.map((step, index) => (
          <div class="flex flex-col items-center gap-4 text-center">
            <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-brand/10 text-brand">
              <Icon name={step.icon} class="h-6 w-6" />
            </span>
            <div class="flex items-center gap-2 text-sm font-semibold text-muted-foreground">
              Step {index + 1}
            </div>
            <h3 class="text-lg font-semibold">{step.title}</h3>
            <p class="max-w-xs text-sm text-muted-foreground text-pretty">
              {step.description}
            </p>
          </div>
        ))
      }
    </div>
  </Container>
</section>
