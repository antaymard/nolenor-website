---
import MarketMap from "@/components/use-cases/MarketMap.astro";
import { flagship, vignettes } from "@/data/useCases";
import { getLang, localizePath } from "@/i18n";

/*
 * The home page's one concrete scene, right before "Is it for you?": a
 * reader deciding whether they're the audience gets to see a person at
 * work first. The full scenario and the other crafts live on /use-cases;
 * this only has to make the split visible: your nodes, Nolë's nodes.
 */
const lang = getLang(Astro.currentLocale);

const en = {
  title: "You lead. Nolë does the legwork. You check.",
  body: "A consultant meets a new market. They set out their own frame on the canvas, Nolë hangs the research on it, and every figure stays one click from its source. At the end, the map is theirs, and they can explain every part of it.",
  craftsLabel: "Crafts shown in the use cases",
  link: "See how each craft works with Nolë",
};
const fr: typeof en = {
  title: "Vous menez. Nolë défriche. Vous vérifiez.",
  body: "Un consultant découvre un nouveau marché. Il pose son propre cadre sur le canevas, Nolë y accroche les recherches, et chaque chiffre reste à un clic de sa source. À la fin, la carte est la sienne, et il peut en expliquer chaque partie.",
  craftsLabel: "Métiers présentés dans les cas d’usage",
  link: "Voir comment chaque métier travaille avec Nolë",
};
const copy = { en, fr }[lang];

const crafts = [flagship[lang].craft, ...vignettes[lang].map((vignette) => vignette.craft)];
---

<section id="use-cases" class="practice" aria-labelledby="practice-title">
  <div class="wrap practice__grid">
    <div class="practice__text">
      <h2 id="practice-title">{copy.title}</h2>
      <p>{copy.body}</p>
      <ul class="practice__crafts" aria-label={copy.craftsLabel}>
        {crafts.map((craft) => <li>{craft}</li>)}
      </ul>
      <a href={localizePath("/use-cases", lang)} class="text-link">{copy.link}</a>
    </div>

    <div class="practice__map">
      <MarketMap />
    </div>
  </div>
</section>

<style>
  .practice {
    padding-block: var(--section-gap);
  }

  .practice__grid {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }

  .practice__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-lg);
  }

  .practice__text h2 {
    max-width: 14ch;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-section);
    line-height: 1.08;
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
    overflow-wrap: break-word;
    min-width: 0;
  }

  .practice__text p {
    max-width: 46ch;
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-ink-2);
  }

  .practice__crafts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    margin: 0;
    padding: var(--space-md) 0 0;
    border-top: var(--rule-hair) solid var(--color-rule);
    list-style: none;
    font-size: var(--text-sm);
    color: var(--color-ink);
  }

  .practice__map {
    min-width: 0;
  }

  @media (min-width: 60rem) {
    .practice__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-3xl);
    }
  }
</style>
