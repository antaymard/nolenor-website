---
import ChatFlattening from "@/components/visuals/ChatFlattening.astro";
import HiddenWork from "@/components/visuals/HiddenWork.astro";
import LostThread from "@/components/visuals/LostThread.astro";
import { problemItems } from "@/data/problem";
import { getLang } from "@/i18n";

const lang = getLang(Astro.currentLocale);

/*
 * The three problems as a switcher: the operator's three chores across the
 * top (File it. Type it. Review it.), the one picked shown below with its
 * scene. The tabs are the old headline taken apart, so the section says
 * the escalation by its controls alone.
 *
 * Every panel carries its own tab and body (problem-accordion.ts moves
 * data-open between them). Wide, the panels dissolve into one grid: tabs on
 * the first row, the open body across the second. Narrow, they stack as an
 * accordion. Without scripting every body shows, in order.
 *
 * A closed panel's body is display:none rather than merely hidden, which is
 * what makes each illustration's IntersectionObserver reset it, so a panel
 * always opens on the first frame of its scene, never mid-run.
 */

const en = {
  title: "Our tools made us operators.",
  lead: "Thinking has a shape. Our tools flatten it into a line, and at every step they take a little more of the work away from you.",
  chores: [
    { verb: "File it.", role: "First, the archivist" },
    { verb: "Type it.", role: "Then, the typist" },
    { verb: "Review it.", role: "Then, the proofreader" },
  ],
};

const fr: typeof en = {
  title: "Nos outils ont fait de nous des opérateurs.",
  lead: "La pensée a une forme. Nos outils l’écrasent en une ligne, et à chaque étape, ils vous dépossèdent un peu plus de votre travail.",
  chores: [
    { verb: "Classer.", role: "D’abord, l’archiviste" },
    { verb: "Taper.", role: "Puis, le dactylo" },
    { verb: "Relire.", role: "Puis, le correcteur" },
  ],
};

const copy = { en, fr }[lang];
const { chores } = copy;
---

<section class="problem" aria-labelledby="problem-title">
  <div class="wrap">
    <div class="problem__head">
      <h2 id="problem-title">{copy.title}</h2>
      <p class="problem__lead">{copy.lead}</p>
    </div>

    <div class="pb-rail" data-problem-rail>
      {
        problemItems[lang].map((item, i) => (
          <article class="pb-panel" data-panel data-open={i === 0 ? "" : undefined}>
            <button
              type="button"
              class="pb-tab"
              data-panel-tab
              aria-expanded={i === 0 ? "true" : "false"}
              aria-controls={`problem-body-${i}`}
            >
              <span class="pb-tab__verb">{chores[i].verb}</span>
              <span class="pb-tab__role">{chores[i].role}</span>
            </button>

            <div class="pb-body" id={`problem-body-${i}`}>
              <div class="pb-copy">
                <h3>{item.title}</h3>
                <p>{item.subtitle}</p>
              </div>

              <div class="pb-visual">
                {item.visual === "chat-flattening" ? (
                  <ChatFlattening />
                ) : item.visual === "hidden-work" ? (
                  <HiddenWork />
                ) : (
                  <LostThread />
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .problem {
    padding-block: var(--section-gap-s) var(--section-gap);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .problem__head {
    display: grid;
    gap: var(--space-lg);
    margin-bottom: var(--space-2xl);
  }

  .problem__head h2 {
    max-width: 14ch;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-section);
    line-height: 1.08;
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
    overflow-wrap: break-word;
    min-width: 0;
  }

  .problem__lead {
    max-width: 44ch;
    font-size: var(--text-lead);
    line-height: 1.5;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }

  .pb-rail {
    display: flex;
    flex-direction: column;
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .pb-panel {
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .pb-tab {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2xs);
    width: 100%;
    min-height: 44px;
    padding: var(--space-lg) 0;
    border: 0;
    background: none;
    color: var(--color-ink-2);
    text-align: left;
    cursor: pointer;
    transition: color var(--dur-short) var(--ease-out);
  }

  .pb-tab:hover,
  .pb-tab[aria-expanded="true"] {
    color: var(--color-ink);
  }

  .pb-tab:active {
    color: var(--color-accent);
  }

  .pb-tab:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: -2px;
    transition: none;
  }

  .pb-tab__verb {
    font-family: var(--font-display);
    font-size: var(--text-title);
    line-height: 1.15;
  }

  .pb-tab__role {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .pb-body {
    display: grid;
    gap: var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  :global(.js) .pb-panel:not([data-open]) .pb-body {
    display: none;
  }

  .pb-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .pb-copy h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-title);
    line-height: 1.2;
    text-wrap: balance;
    overflow-wrap: break-word;
    min-width: 0;
  }

  .pb-copy p {
    max-width: 40ch;
    line-height: 1.6;
    color: var(--color-ink-2);
  }

  .pb-visual {
    min-width: 0;
  }

  .pb-visual > :global(*) {
    width: 100%;
  }

  @media (min-width: 60rem) {
    .problem__head {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      gap: var(--gap-columns);
      align-items: end;
    }

    /* One grid: the tabs share the first row, the open body takes the
       second across all three columns. */
    .pb-rail {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--gap-columns);
      border-top: 0;
    }

    .pb-panel {
      display: contents;
    }

    .pb-tab {
      grid-row: 1;
      padding-top: var(--space-md);
      border-top: 2px solid var(--color-rule);
      transition:
        color var(--dur-short) var(--ease-out),
        border-color var(--dur-short) var(--ease-out);
    }

    .pb-panel:nth-child(1) .pb-tab { grid-column: 1; }
    .pb-panel:nth-child(2) .pb-tab { grid-column: 2; }
    .pb-panel:nth-child(3) .pb-tab { grid-column: 3; }

    .pb-tab[aria-expanded="true"] {
      border-top-color: var(--color-accent);
      cursor: default;
    }

    .pb-tab__verb {
      font-size: clamp(1.75rem, 1.2vw + 1.2rem, 2.5rem);
    }

    .pb-body {
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: var(--gap-columns);
      align-items: center;
      min-height: 30rem;
      padding-block: var(--space-2xl) 0;
    }

    .pb-copy {
      padding-right: var(--space-xl);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pb-tab {
      transition: none;
    }
  }
</style>
