---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { nodeTypes } from "@/data/nodeTypes";

/*
 * The nine materials as one grid of tinted wells on the page's own paper:
 * no white sheet behind them, no card inside a card. Each well is a name,
 * one line, and a peek into the node, cropped by the well's bottom edge on
 * purpose (see MEDIA_BRIEF.md). The one type that does not ship yet is set
 * in type alone, outlined rather than filled.
 */
const shipped = nodeTypes.filter((node) => !node.soon);
const soon = nodeTypes.filter((node) => node.soon);
---

<section id="nodes" class="nodes" aria-labelledby="nodes-title">
  <div class="wrap">
    <div class="nodes__head">
      <h2 id="nodes-title">Every material, on the same workbench</h2>
      <p class="nodes__lead">
        Each node can be read, edited and searched, by you and by Nolë. PDFs,
        images, audio and video are transcribed and indexed, so nothing you lay
        down gets lost in the pile.
      </p>
    </div>

    <ul class="nodes__grid">
      {
        shipped.map((node) => (
          <li class="node">
            <h3>
              <Icon name={node.icon} class="node__icon" aria-hidden="true" />
              {node.name}
            </h3>
            <p>{node.description}</p>
            <div class="node__peek" data-media-id={node.media?.id}>
              {node.media?.src && (
                <Image src={node.media.src} alt={node.media.alt} loading="lazy" />
              )}
            </div>
          </li>
        ))
      }
      {
        soon.map((node) => (
          <li class="node node--soon">
            <h3>
              <Icon name={node.icon} class="node__icon" aria-hidden="true" />
              {node.name}
            </h3>
            <p>{node.description}</p>
            <p class="node__when">Coming soon</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .nodes {
    padding-block: var(--section-gap);
  }

  .nodes__head {
    display: grid;
    gap: var(--space-lg);
    margin-bottom: var(--space-2xl);
  }

  .nodes__head h2 {
    max-width: 16ch;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-section);
    line-height: 1.08;
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
    overflow-wrap: break-word;
    min-width: 0;
  }

  .nodes__lead {
    max-width: 48ch;
    font-size: var(--text-lead);
    line-height: 1.5;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }

  .nodes__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap-columns);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .node {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    min-height: 26rem;
    padding: var(--space-xl) var(--space-xl) 0;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-paper-2);
  }

  .node h3 {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-title);
    line-height: 1.2;
    text-wrap: balance;
    overflow-wrap: break-word;
    min-width: 0;
  }

  .node__icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: var(--color-accent);
  }

  .node p {
    line-height: 1.55;
    color: var(--color-ink-2);
  }

  .node__peek {
    flex: 1;
    min-height: 0;
    margin-top: var(--space-md);
  }

  .node__peek :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-inner) var(--radius-inner) 0 0;
    outline: 1px solid var(--color-shade);
    outline-offset: -1px;
  }

  .node--soon {
    padding-bottom: var(--space-xl);
    background: transparent;
    outline: 1px dashed var(--color-rule-2);
    outline-offset: -1px;
  }

  .node__when {
    margin-top: auto;
    font-size: var(--text-sm);
  }

  @media (min-width: 40rem) {
    .nodes__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 60rem) {
    .nodes__head {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      gap: var(--gap-columns);
      align-items: end;
    }

    .nodes__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
