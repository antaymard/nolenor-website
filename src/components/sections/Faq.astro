---
import { Icon } from "astro-icon/components";
import { faqEntries } from "@/data/faq";

/*
 * Native <details> rather than a scripted accordion: it works before any
 * JavaScript runs, answers to the keyboard for free, and several answers can
 * be open at once — which is what someone comparing tools actually wants.
 *
 * The open and close are animated through ::details-content where the
 * browser has it, and snap open where it doesn't. Nothing depends on it.
 */

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqEntries.map((entry) => ({
    "@type": "Question",
    name: entry.question,
    acceptedAnswer: { "@type": "Answer", text: entry.answer },
  })),
};
---

<!-- No scroll-mt here: html { scroll-padding-top } in global.css already
     clears the sticky bar. -->
<section id="faq" class="faq" aria-labelledby="faq-title">
  <div class="wrap faq__grid">
    <div class="faq__head">
      <h2 id="faq-title">Questions</h2>
    </div>

    <div class="faq-list">
      {
        faqEntries.map((entry) => (
          <details class="faq-item">
            <summary class="faq-q">
              <span>{entry.question}</span>
              <span class="faq-mark">
                <Icon name="lucide:plus" class="faq-icon" />
              </span>
            </summary>
            <div class="faq-a">
              <p>{entry.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline
></script>

<style>
  .faq {
    padding-block: var(--section-gap);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .faq__grid {
    display: grid;
    gap: var(--space-xl);
  }

  .faq__head h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-section);
    line-height: 1.08;
    letter-spacing: var(--tracking-display);
    overflow-wrap: break-word;
    min-width: 0;
  }

  .faq-list {
    width: 100%;
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .faq-item {
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .faq-q {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-lg);
    padding: var(--space-lg) 0;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: var(--text-title);
    line-height: 1.3;
    text-align: left;
    text-wrap: pretty;
    color: var(--color-ink);
    list-style: none;
    transition: color var(--dur-short) var(--ease-out);
  }

  .faq-q::-webkit-details-marker {
    display: none;
  }

  .faq-q:hover {
    color: var(--color-accent);
  }

  .faq-q:active {
    color: var(--color-accent-2);
  }

  .faq-q:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    transition: none;
  }

  .faq-mark {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-pill);
    background: var(--color-paper-2);
    color: var(--color-accent);
    transition:
      transform var(--dur-long) var(--ease-out),
      background-color var(--dur-short) var(--ease-out);
  }

  .faq-q:hover .faq-mark {
    background: var(--color-rule);
  }

  /* A plus turned an eighth of a turn is a cross: open, without a second icon. */
  .faq-item[open] .faq-mark {
    transform: rotate(135deg);
  }

  .faq-icon {
    width: 16px;
    height: 16px;
  }

  .faq-a p {
    margin: 0;
    padding: 0 0 var(--space-lg);
    max-width: 62ch;
    line-height: 1.65;
    text-align: left;
    text-wrap: pretty;
    color: var(--color-ink-2);
  }

  @media (min-width: 60rem) {
    .faq__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: var(--gap-columns);
      align-items: start;
    }

    .faq__head {
      position: sticky;
      top: calc(var(--nav-height) + var(--space-xl));
    }
  }

  /* Progressive enhancement: browsers with ::details-content can animate the
     panel from nothing to its own height. The rest simply open. */
  @supports selector(::details-content) {
    .faq-list {
      interpolate-size: allow-keywords;
    }

    .faq-item::details-content {
      block-size: 0;
      overflow: hidden;
      transition:
        block-size var(--dur-long) var(--ease-out),
        content-visibility var(--dur-long) allow-discrete;
    }

    .faq-item[open]::details-content {
      block-size: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-mark,
    .faq-q {
      transition: none !important;
    }

    .faq-item::details-content {
      transition: none !important;
    }
  }
</style>
