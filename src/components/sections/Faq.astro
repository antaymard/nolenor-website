---
import { Icon } from "astro-icon/components";
import Container from "@/components/ui/Container.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { faqEntries } from "@/data/faq";
---

<section id="faq" class="scroll-mt-20 py-24 sm:py-32">
  <Container class="flex flex-col gap-12">
    <SectionHeading
      align="center"
      eyebrow="FAQ"
      title="Questions, answered honestly."
      class="mx-auto"
    />

    <div class="mx-auto flex w-full max-w-2xl flex-col divide-y divide-border" data-reveal>
      {
        faqEntries.map((entry) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-medium marker:content-none">
              {entry.question}
              <Icon
                name="lucide:chevron-down"
                class="h-4 w-4 shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180"
              />
            </summary>
            <p class="mt-3 text-sm text-muted-foreground text-pretty">
              {entry.answer}
            </p>
          </details>
        ))
      }
    </div>
  </Container>
</section>
