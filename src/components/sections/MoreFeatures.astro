---
import MediaFrame from "@/components/ui/MediaFrame.astro";
import { featureHighlights, featureNotes } from "@/data/moreFeatures";
import { getLang } from "@/i18n";

const lang = getLang(Astro.currentLocale);

const en = {
  title: "Built to keep you in step with the work",
  lead: "The details that let you follow what the agent did, find what you laid down, and keep your work your own.",
  notes: "And also",
};
const fr: typeof en = {
  title: "Pour ne jamais perdre le fil",
  lead: "Des détails, oui, mais ce sont eux qui vous laissent suivre ce qu’a fait l’agent, retrouver ce que vous avez posé et rester maître de votre travail.",
  notes: "Et aussi",
};
const copy = { en, fr }[lang];

/*
 * The depth section: proof there is a real product here, read at speed.
 *
 * Not another even grid, since a grid gives every item the same weight. The
 * version history leads, large, beside its words; search and sharing sit
 * under it as a pair; then the features that need no picture at all, as
 * ruled rows. The hierarchy is the layout.
 */
const [lead, ...pair] = featureHighlights[lang];
---

<section class="depth" aria-labelledby="depth-title">
  <div class="wrap">
    <div class="depth__head">
      <h2 id="depth-title">{copy.title}</h2>
      <p class="depth__lead">{copy.lead}</p>
    </div>

    <div class="depth__feature depth__feature--lead">
      <MediaFrame
        id={lead.media.id}
        kind="image"
        src={lead.media.src}
        alt={lead.media.alt}
        aspectRatio="16/9"
      />
      <div class="depth__copy">
        <h3>{lead.title}</h3>
        <p>{lead.description}</p>
      </div>
    </div>

    <div class="depth__pair">
      {
        pair.map((feature) => (
          <div class="depth__feature">
            <MediaFrame
              id={feature.media.id}
              kind="image"
              src={feature.media.src}
              alt={feature.media.alt}
              aspectRatio="16/9"
            />
            <div class="depth__copy">
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="depth__notes">
      <h3>{copy.notes}</h3>
      <dl>
        {
          featureNotes[lang].map((note) => (
            <div class="depth__note">
              <dt>{note.title}</dt>
              <dd>{note.description}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .depth {
    padding-block: var(--section-gap-l) var(--section-gap);
  }

  .depth__head {
    display: grid;
    gap: var(--space-lg);
    margin-bottom: var(--space-2xl);
  }

  .depth__head h2 {
    max-width: 18ch;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-section);
    line-height: 1.08;
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
    overflow-wrap: break-word;
    min-width: 0;
  }

  .depth__lead {
    max-width: 44ch;
    font-size: var(--text-lead);
    line-height: 1.5;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }

  .depth__feature {
    display: grid;
    gap: var(--space-lg);
    align-content: start;
  }

  .depth__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .depth__copy h3,
  .depth__notes h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-title);
    line-height: 1.2;
    text-wrap: balance;
    overflow-wrap: break-word;
    min-width: 0;
  }

  .depth__copy p {
    max-width: 52ch;
    line-height: 1.6;
    color: var(--color-ink-2);
  }

  .depth__pair {
    display: grid;
    gap: var(--space-2xl) var(--gap-columns);
    margin-top: var(--space-2xl);
  }

  .depth__notes {
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-3xl);
  }

  .depth__notes dl {
    margin: 0;
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .depth__note {
    display: grid;
    gap: var(--space-2xs);
    padding-block: var(--space-md);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .depth__note dt {
    font-weight: 700;
    color: var(--color-ink);
  }

  .depth__note dd {
    margin: 0;
    line-height: 1.55;
    color: var(--color-ink-2);
  }

  @media (min-width: 60rem) {
    .depth__head {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      gap: var(--gap-columns);
      align-items: end;
    }

    .depth__feature--lead {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      gap: var(--gap-columns);
      align-items: end;
    }

    .depth__pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .depth__notes {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: var(--gap-columns);
    }

    .depth__note {
      grid-template-columns: minmax(0, 3fr) minmax(0, 5fr);
      gap: var(--gap-columns);
      align-items: baseline;
    }
  }
</style>
