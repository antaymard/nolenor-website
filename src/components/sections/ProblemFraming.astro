---
import { Icon } from "astro-icon/components";
import Container from "@/components/ui/Container.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";

const cards = [
  {
    icon: "lucide:message-square",
    title: "Linear chat",
    description:
      "One thread holds everything. Ask a follow-up three messages later and the context you needed is already buried.",
    tone: "problem" as const,
  },
  {
    icon: "lucide:box",
    title: "Autonomous agents",
    description:
      "You hand off a task and wait. No visibility into what's happening, no way to step in until it's already done — right or wrong.",
    tone: "problem" as const,
  },
  {
    icon: "lucide:layout-dashboard",
    title: "Nolenor",
    description:
      "Every action lands as a visible, structured block. Watch it happen. Jump in on any node, any time, without stopping the rest.",
    tone: "answer" as const,
  },
];
---

<section class="py-24 sm:py-32">
  <Container class="flex flex-col gap-12">
    <SectionHeading
      align="center"
      eyebrow="The interface problem"
      title="Chat hides context. Agents hide everything."
      description="Neither is built for trust. Nolenor shows you exactly what's happening — every time."
      class="mx-auto"
    />

    <div class="grid gap-6 sm:grid-cols-3" data-reveal>
      {
        cards.map((card) => (
          <div
            class={`flex flex-col gap-4 rounded-2xl border p-6 ${
              card.tone === "answer"
                ? "border-brand/30 bg-brand/5"
                : "border-border bg-muted/40"
            }`}
          >
            <span
              class={`flex h-10 w-10 items-center justify-center rounded-full ${
                card.tone === "answer"
                  ? "bg-brand text-brand-foreground"
                  : "bg-background text-muted-foreground"
              }`}
            >
              <Icon name={card.icon} class="h-5 w-5" />
            </span>
            <h3 class="text-lg font-semibold">{card.title}</h3>
            <p class="text-sm text-muted-foreground text-pretty">
              {card.description}
            </p>
          </div>
        ))
      }
    </div>
  </Container>
</section>
