---
import { Icon } from "astro-icon/components";
import Container from "@/components/ui/Container.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";

const cards = [
  {
    icon: "lucide:message-square",
    title: "Linear chat",
    description:
      "One thread, one thing at a time. Context gets lost in a wall of text, and you can't work on two ideas at once.",
    tone: "problem" as const,
  },
  {
    icon: "lucide:box",
    title: "Autonomous agents",
    description:
      "You hand off a task and hope. No visibility into intermediate steps, no way to correct course until it's done — or wrong.",
    tone: "problem" as const,
  },
  {
    icon: "lucide:layout-dashboard",
    title: "Nolenor",
    description:
      "A visual surface where AI works in structured, visible blocks — and you can jump in on any node, any time, without stopping the rest.",
    tone: "answer" as const,
  },
];
---

<section class="py-24 sm:py-32">
  <Container class="flex flex-col gap-12">
    <SectionHeading
      align="center"
      eyebrow="The interface problem"
      title="Chat is too linear. Autonomous agents are a black box."
      description="Neither is the right interface for working with AI — the same way a single document was never the right interface for a team."
      class="mx-auto"
    />

    <div class="grid gap-6 sm:grid-cols-3" data-reveal>
      {
        cards.map((card) => (
          <div
            class={`flex flex-col gap-4 rounded-2xl border p-6 ${
              card.tone === "answer"
                ? "border-brand/30 bg-brand/5"
                : "border-border bg-muted/40"
            }`}
          >
            <span
              class={`flex h-10 w-10 items-center justify-center rounded-full ${
                card.tone === "answer"
                  ? "bg-brand text-brand-foreground"
                  : "bg-background text-muted-foreground"
              }`}
            >
              <Icon name={card.icon} class="h-5 w-5" />
            </span>
            <h3 class="text-lg font-semibold">{card.title}</h3>
            <p class="text-sm text-muted-foreground text-pretty">
              {card.description}
            </p>
          </div>
        ))
      }
    </div>
  </Container>
</section>
