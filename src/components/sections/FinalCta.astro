---
import { Icon } from "astro-icon/components";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import { APP_URL } from "@/lib/constants";
---

<section class="py-24 sm:py-32">
  <Container>
    <div
      class="flex flex-col items-center gap-6 rounded-3xl border border-brand/20 bg-brand/5 px-6 py-16 text-center sm:px-16"
      data-reveal
      data-reveal-variant="zoom"
    >
      <h2 class="max-w-xl text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
        Stop guessing what your AI is doing.
      </h2>
      <p class="max-w-lg text-lg text-muted-foreground text-pretty">
        Every action visible. Every block editable. Nothing ever blocking
        you. Start building on a canvas that shows its work.
      </p>
      <Button href={APP_URL} size="lg">
        Start free trial
        <Icon name="lucide:arrow-right" class="h-4 w-4" />
      </Button>
    </div>
  </Container>
</section>
