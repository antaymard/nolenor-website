---
import { APP_SIGNUP_URL } from "@/lib/constants";
import { getLang } from "@/i18n";

const lang = getLang(Astro.currentLocale);

const en = {
  title: "Let’s not be operators. Let’s stay artisans.",
  body: "Nolënor is in open beta and free to use while we build it with early users. The workshop is open.",
  cta: "Try it for free",
};
const fr: typeof en = {
  title: "Ne soyons pas des opérateurs. Restons des artisans.",
  body: "Nolënor est en bêta ouverte, et gratuit pendant que nous le construisons avec ses premiers utilisateurs. L’atelier est ouvert.",
  cta: "Essayer gratuitement",
};
const copy = { en, fr }[lang];

/*
 * The close: the one place the brand colour is used as a field, edge to
 * edge, so the page opens on cream and closes on indigo. The line on the
 * left, the way in on the right.
 *
 * The beta line is not a sales flourish: it is the same claim the FAQ
 * makes ("open beta and free to use while we build it with early users"),
 * kept in one voice so the two never contradict each other.
 */
---

<section class="close" aria-labelledby="close-title">
  <div class="wrap close__grid">
    <h2 id="close-title">{copy.title}</h2>

    <div class="close__act">
      <p>{copy.body}</p>
      <a href={APP_SIGNUP_URL} class="btn btn--inverse" rel="noopener noreferrer">{copy.cta}</a>
    </div>
  </div>
</section>

<style>
  .close {
    padding-block: var(--section-gap-s);
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .close__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: end;
  }

  .close h2 {
    max-width: 16ch;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-display-s);
    line-height: 1.05;
    letter-spacing: var(--tracking-display);
    color: var(--color-accent-ink);
    text-wrap: balance;
    overflow-wrap: break-word;
    min-width: 0;
  }

  .close__act {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-lg);
  }

  .close__act p {
    max-width: 38ch;
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--color-accent-ink-2);
  }

  @media (min-width: 60rem) {
    .close__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--gap-columns);
    }
  }
</style>
