---
import Container from "@/components/ui/Container.astro";
import Badge from "@/components/ui/Badge.astro";

interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  description: string;
  bullets?: string[];
  reverse?: boolean;
  featured?: boolean;
}

const {
  id,
  eyebrow,
  title,
  description,
  bullets = [],
  reverse = false,
  featured = false,
} = Astro.props;
---

<section id={id} class="py-16 sm:py-20">
  <Container>
    <div
      class={`grid min-w-0 items-center gap-12 lg:gap-16 ${
        featured
          ? "lg:grid-cols-[0.85fr_1.15fr]"
          : "lg:grid-cols-2"
      }`}
    >
      <div
        class={`flex min-w-0 flex-col gap-5 ${reverse ? "lg:order-2" : ""}`}
        data-reveal
        data-reveal-variant="fade"
      >
        <Badge tone="brand">{eyebrow}</Badge>
        <h3 class="text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
          {title}
        </h3>
        <p class="text-base text-muted-foreground text-pretty sm:text-lg">
          {description}
        </p>
        {
          bullets.length > 0 && (
            <ul class="mt-2 flex flex-col gap-2.5">
              {bullets.map((bullet) => (
                <li class="flex items-start gap-2.5 text-sm text-muted-foreground">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand" />
                  {bullet}
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div
        class={`min-w-0 ${reverse ? "lg:order-1" : ""}`}
        data-reveal
        data-reveal-variant="zoom"
      >
        <slot />
      </div>
    </div>
  </Container>
</section>
