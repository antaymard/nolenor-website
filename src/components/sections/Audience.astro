---
import { Icon } from "astro-icon/components";
import Container from "@/components/ui/Container.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import { audienceFit, audienceMisfit } from "@/data/audience";

/*
 * Who this is for, and — the part that gives the first list its weight —
 * who it isn't for. Two columns rather than one accordion: a reader should
 * be able to disqualify themselves at a glance, without opening anything.
 *
 * The two cards are deliberately not styled as good and bad. One is a white
 * card, the other sits recessed on the page's own cream: "not for you" is an
 * honest answer, not a warning.
 */
---

<section id="who-its-for" class="py-20 sm:py-28">
  <Container class="flex flex-col items-center gap-5 text-center">
    <SectionLabel>Is it for you?</SectionLabel>

    <h2 class="text-balance text-foreground">Who is Nolënor for?</h2>
    <p class="max-w-2xl text-lg text-pretty text-muted-foreground">
      Nolënor is for people who want to stay involved in their thinking while
      using AI.
    </p>
  </Container>

  <Container class="mt-12 sm:mt-14">
    <div class="grid gap-5 lg:grid-cols-2" data-reveal>
      <div class="au-card au-card--fit">
        <h3 class="text-foreground">{audienceFit.title}</h3>
        <ul class="au-list">
          {
            audienceFit.items.map((item) => (
              <li class="au-item">
                <span class="au-mark au-mark--yes">
                  <Icon name="lucide:check" class="au-icon" />
                </span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="au-card au-card--misfit">
        <h3 class="text-foreground">{audienceMisfit.title}</h3>
        <ul class="au-list">
          {
            audienceMisfit.items.map((item) => (
              <li class="au-item">
                <span class="au-mark au-mark--no">
                  <Icon name="lucide:minus" class="au-icon" />
                </span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Container>

  <Container class="mt-14 sm:mt-16">
    <p class="au-close" data-reveal>
      Nolënor is for people who want AI to move their thinking forward — not
      replace it.
    </p>
  </Container>
</section>

<style>
  .au-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-2xl);
    text-align: left;
  }

  .au-card--fit {
    background: var(--surface);
    box-shadow: 0 18px 50px -30px rgba(47, 54, 83, 0.45);
  }

  /* Recessed rather than warned about: it sits on the page's own colour. */
  .au-card--misfit {
    background: color-mix(in srgb, var(--muted) 40%, transparent);
  }

  .au-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .au-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 1rem;
    line-height: 1.55;
    text-wrap: pretty;
    color: var(--foreground);
  }

  .au-card--misfit .au-item {
    color: var(--muted-foreground);
  }

  .au-mark {
    flex: none;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    margin-top: 2px;
    border-radius: 999px;
  }

  .au-mark--yes {
    background: color-mix(in srgb, var(--brand) 14%, transparent);
    color: var(--brand);
  }

  .au-mark--no {
    background: color-mix(in srgb, var(--muted-foreground) 12%, transparent);
    color: var(--muted-foreground);
  }

  .au-icon {
    width: 14px;
    height: 14px;
  }

  .au-close {
    max-width: 44rem;
    margin: 0 auto;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    line-height: 1.35;
    text-align: center;
    text-wrap: balance;
    color: var(--foreground);
  }

  @media (min-width: 640px) {
    .au-close {
      font-size: 1.75rem;
    }
  }
</style>
