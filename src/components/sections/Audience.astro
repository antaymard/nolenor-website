---
import { Icon } from "astro-icon/components";
import { audienceFit, audienceMisfit } from "@/data/audience";
import { getLang, localizePath } from "@/i18n";

const lang = getLang(Astro.currentLocale);
const fit = audienceFit[lang];
const misfit = audienceMisfit[lang];

const en = {
  title: "For people with a craft",
  lead: "Developers, designers, researchers, consultants, strategists: people who want AI to amplify their craft, not do it for them. A precise tool for precise people, so here is who it isn’t for, too.",
  statement: "An apprentice to work beside you, not a replacement whose work you review after.",
  moreLead: "Not sure?",
  moreLink: "See it at work in four crafts",
};
const fr: typeof en = {
  title: "Pour les gens de métier",
  lead: "Développeurs, designers, chercheurs, consultants, stratèges : des personnes qui veulent que l’IA amplifie leur savoir-faire, pas qu’elle l’exerce à leur place. Un outil précis pour des gens précis ; voici donc aussi pour qui il n’est pas fait.",
  statement: "Un apprenti qui travaille à vos côtés, pas un remplaçant dont vous relisez le travail après coup.",
  moreLead: "Vous hésitez ?",
  moreLink: "Voyez-le à l’œuvre dans quatre métiers",
};
const copy = { en, fr }[lang];

/*
 * Who this is for, and (the part that gives the first list its weight) who
 * it isn't for. Two ruled columns side by side, so a reader can disqualify
 * themselves at a glance without opening anything. Neither is styled as
 * good or bad: "not for you" is an honest answer, not a warning, so the
 * second column is only a shade quieter.
 *
 * It closes on the page's thesis, set as a statement.
 */
---

<section id="who-its-for" class="audience" aria-labelledby="audience-title">
  <div class="wrap">
    <div class="audience__head">
      <h2 id="audience-title">{copy.title}</h2>
      <p class="audience__lead">{copy.lead}</p>
    </div>

    <div class="audience__lists">
      <div class="audience__col">
        <h3>{fit.title}</h3>
        <ul>
          {
            fit.items.map((item) => (
              <li>
                <Icon name="lucide:check" class="audience__icon" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="audience__col audience__col--misfit">
        <h3>{misfit.title}</h3>
        <ul>
          {
            misfit.items.map((item) => (
              <li>
                <Icon name="lucide:minus" class="audience__icon" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="audience__close">
      <p class="audience__statement">{copy.statement}</p>
      <p class="audience__more">
        {copy.moreLead} <a href={localizePath("/use-cases", lang)} class="text-link">{copy.moreLink}</a>.
      </p>
    </div>
  </div>
</section>

<style>
  .audience {
    padding-block: var(--section-gap-s) var(--section-gap-l);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .audience__head {
    display: grid;
    gap: var(--space-lg);
    margin-bottom: var(--space-2xl);
  }

  .audience__head h2 {
    max-width: 14ch;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-section);
    line-height: 1.08;
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
    overflow-wrap: break-word;
    min-width: 0;
  }

  .audience__lead {
    max-width: 48ch;
    font-size: var(--text-lead);
    line-height: 1.5;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }

  .audience__lists {
    display: grid;
    gap: var(--space-2xl) var(--gap-columns);
  }

  .audience__col h3 {
    padding-bottom: var(--space-md);
    border-bottom: 2px solid var(--color-accent);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-title);
    line-height: 1.2;
    text-wrap: balance;
    overflow-wrap: break-word;
    min-width: 0;
  }

  .audience__col--misfit h3 {
    border-bottom-color: var(--color-rule-2);
  }

  .audience__col ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .audience__col li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding-block: var(--space-md);
    border-bottom: var(--rule-hair) solid var(--color-rule);
    line-height: 1.55;
    color: var(--color-ink);
  }

  .audience__col--misfit li {
    color: var(--color-ink-2);
  }

  .audience__icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    margin-top: 2px;
    color: var(--color-accent);
  }

  .audience__col--misfit .audience__icon {
    color: var(--color-muted);
  }

  .audience__close {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin-top: var(--space-3xl);
  }

  .audience__statement {
    max-width: 24ch;
    font-family: var(--font-display);
    font-size: var(--text-display-s);
    line-height: 1.1;
    letter-spacing: var(--tracking-display);
    color: var(--color-ink);
    text-wrap: balance;
  }

  .audience__more {
    color: var(--color-ink-2);
  }

  @media (min-width: 60rem) {
    .audience__head {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      gap: var(--gap-columns);
      align-items: end;
    }

    .audience__lists {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
