---
import { APP_URL } from "@/lib/constants";

interface Props {
  text: string;
  action: string;
  href?: string;
}

const { text, action, href = APP_URL } = Astro.props;
const isExternal = href.startsWith("http");

/*
 * The quiet CTA: one line between two hairlines, no box, no button.
 *
 * It reads as punctuation in the page's rhythm rather than as an
 * interruption: a chapter break that happens to hold an open door.
 * Anything heavier this far from the end of the page would be nagging.
 */
---

<aside class="aside-cta">
  <div class="wrap aside-cta__inner">
    <p>{text}</p>
    <a
      href={href + "/signin?mode=signup"}
      class="text-link"
      {...isExternal ? { rel: "noopener noreferrer" } : {}}
    >
      {action}
    </a>
  </div>
</aside>

<style>
  .aside-cta {
    border-block: var(--rule-hair) solid var(--color-rule);
  }

  .aside-cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-lg);
    padding-block: var(--space-lg);
  }

  .aside-cta p {
    font-family: var(--font-display);
    font-size: var(--text-lead);
    color: var(--color-ink);
  }
</style>
