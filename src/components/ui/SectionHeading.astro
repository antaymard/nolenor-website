---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  align = "left",
  class: className = "",
} = Astro.props;

const alignment = align === "center" ? "text-center items-center mx-auto" : "text-left items-start";
---

<div class={`flex max-w-2xl flex-col gap-4 ${alignment} ${className}`}>
  {
    eyebrow && (
      <span class="text-sm font-semibold uppercase tracking-wide text-brand">
        {eyebrow}
      </span>
    )
  }
  <h2 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
    {title}
  </h2>
  {
    description && (
      <p class="text-lg text-muted-foreground text-pretty">{description}</p>
    )
  }
</div>
