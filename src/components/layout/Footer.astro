---
import { Icon } from "astro-icon/components";
import Logo from "@/components/ui/Logo.astro";
import { getNav } from "@/data/nav";
import { GITHUB_REPO_URL, SITE_NAME, TAGLINE } from "@/lib/constants";
import { getLang, languages, langs, translatePath, useTranslations } from "@/i18n";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { footerProductLinks, footerAboutLinks, footerLegalLinks } = getNav(lang);
const languageLinks = langs.map((l) => ({
  lang: l,
  label: languages[l],
  href: translatePath(Astro.url.pathname, l),
}));

const year = new Date().getFullYear();

/*
 * Index columns, because the site has a real sitemap (thirteen links over
 * three groups), under the tagline set large as the footer's one line. The
 * product-updates form keeps its ids: wishlist-form.ts finds it by them.
 */
const groups = [
  { title: t("footer.product"), links: footerProductLinks },
  { title: t("footer.about"), links: footerAboutLinks },
  { title: t("footer.legal"), links: footerLegalLinks },
];
---

<footer class="foot">
  <div class="wrap">
    <div class="foot__top">
      <Logo iconClass="h-7 w-7 text-foreground" textClass="text-lg" />
      <p class="foot__line">{TAGLINE[lang]}</p>
    </div>

    <div class="foot__grid">
      {
        groups.map((group) => (
          <nav class="foot__group" aria-label={group.title}>
            <h2>{group.title}</h2>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div class="foot__updates">
        <h2>{t("footer.updates.title")}</h2>
        <p>{t("footer.updates.body")}</p>
        <form
          id="wishlist-form"
          class="foot__form"
          novalidate
          data-msg-sending={t("footer.updates.sending")}
          data-msg-already={t("footer.updates.already")}
          data-msg-success={t("footer.updates.success")}
          data-msg-error={t("footer.updates.error")}
        >
          <label for="wishlist-email" class="sr-only">{t("footer.updates.email")}</label>
          <input
            id="wishlist-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            placeholder={t("footer.updates.placeholder")}
          />
          <button type="submit" class="btn btn--sm">{t("footer.updates.submit")}</button>
        </form>
        <p id="wishlist-form-message" class="foot__status" role="status" aria-live="polite"></p>
      </div>
    </div>

    <div class="foot__legal">
      <p>&copy; {year} {SITE_NAME}. {t("footer.rights")}</p>
      <nav class="foot__langs" aria-label={t("footer.language")}>
        {
          languageLinks.map((link) => (
            <a
              href={link.href}
              hreflang={link.lang}
              lang={link.lang}
              aria-current={link.lang === lang ? "true" : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <a
        href={GITHUB_REPO_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="foot__gh"
        aria-label={t("footer.github")}
      >
        <Icon name="lucide:github" class="foot__gh-icon" aria-hidden="true" />
        GitHub
      </a>
    </div>
  </div>
</footer>

<style>
  .foot {
    padding-top: var(--space-3xl);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .foot__top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
    padding-bottom: var(--space-2xl);
  }

  .foot__line {
    font-family: var(--font-display);
    font-size: var(--text-display-s);
    line-height: 1.05;
    letter-spacing: var(--tracking-display);
    color: var(--color-ink);
  }

  .foot__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl) var(--gap-columns);
    padding-block: var(--space-xl) var(--space-2xl);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .foot h2 {
    margin-bottom: var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-ink);
    text-wrap: balance;
  }

  .foot ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .foot li a,
  .foot__langs a,
  .foot__gh {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
    transition:
      color var(--dur-short) var(--ease-out),
      text-decoration-color var(--dur-short) var(--ease-out);
  }

  .foot li a:hover,
  .foot__langs a:hover,
  .foot__gh:hover {
    color: var(--color-ink);
    text-decoration-color: var(--color-rule-2);
  }

  .foot li a:active,
  .foot__langs a:active,
  .foot__gh:active {
    color: var(--color-accent);
  }

  .foot li a:focus-visible,
  .foot__langs a:focus-visible,
  .foot__gh:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: 2px;
    transition: none;
  }

  .foot__updates {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .foot__updates > p {
    max-width: 32ch;
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }

  .foot__form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    max-width: 24rem;
  }

  .foot__form input {
    flex: 1 1 12rem;
    min-width: 0;
    min-height: 40px;
    padding-inline: var(--space-sm);
    border: 1px solid var(--color-muted);
    border-radius: var(--radius-inner);
    background: var(--color-paper-3);
    color: var(--color-ink);
    font-size: var(--text-md);
  }

  .foot__form input::placeholder {
    color: var(--color-muted);
  }

  .foot__form input:hover {
    border-color: var(--color-ink);
  }

  .foot__form input:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: -2px;
  }

  .foot__form input[aria-invalid="true"] {
    border-color: var(--color-error);
  }

  .foot__form input:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .foot__status {
    min-height: 1lh;
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }

  .foot__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-lg);
    padding-block: var(--space-lg);
    border-top: var(--rule-hair) solid var(--color-rule);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .foot__gh {
    gap: var(--space-xs);
  }

  .foot__langs {
    display: flex;
    gap: var(--space-md);
  }

  .foot__langs a[aria-current] {
    color: var(--color-ink);
    text-decoration-color: var(--color-accent);
  }

  .foot__gh-icon {
    width: 16px;
    height: 16px;
  }

  @media (min-width: 60rem) {
    .foot__grid {
      grid-template-columns: repeat(3, minmax(0, 2fr)) minmax(0, 4fr);
    }

    .foot__updates {
      grid-column: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .foot li a,
    .foot__langs a,
    .foot__gh {
      transition: none;
    }
  }
</style>
