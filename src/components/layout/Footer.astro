---
import { Icon } from "astro-icon/components";
import Container from "@/components/ui/Container.astro";
import { footerProductLinks, footerLegalLinks } from "@/data/nav";
import { GITHUB_REPO_URL, SITE_NAME, TAGLINE } from "@/lib/constants";

const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <Container class="grid gap-12 py-16 md:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
    <div class="flex flex-col gap-3">
      <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
        <img src="/favicon.svg" alt="" width="24" height="24" class="h-6 w-6" />
        <span>{SITE_NAME}</span>
      </a>
      <p class="max-w-xs text-sm text-muted-foreground">{TAGLINE}</p>
      <a
        href={GITHUB_REPO_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 inline-flex w-fit items-center gap-2 rounded-full border border-border px-3 py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:border-foreground/30 hover:text-foreground"
        aria-label="Nolenor on GitHub"
      >
        <Icon name="lucide:github" class="h-4 w-4" />
        GitHub
      </a>
    </div>

    <div class="flex flex-col gap-3">
      <span class="text-sm font-semibold">Product</span>
      {
        footerProductLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm text-muted-foreground transition-colors hover:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="flex flex-col gap-3">
      <span class="text-sm font-semibold">Legal</span>
      {
        footerLegalLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm text-muted-foreground transition-colors hover:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="flex flex-col gap-3">
      <span class="text-sm font-semibold">Get product updates</span>
      <p class="text-sm text-muted-foreground">
        Occasional news about new features. No spam.
      </p>
      <form id="wishlist-form" class="flex flex-col gap-2 sm:flex-row" novalidate>
        <label for="wishlist-email" class="sr-only">Email address</label>
        <input
          id="wishlist-email"
          name="email"
          type="email"
          required
          placeholder="you@company.com"
          class="w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
        />
        <button
          type="submit"
          class="inline-flex shrink-0 items-center justify-center rounded-xl bg-foreground px-4 py-2.5 text-sm font-medium text-background transition-colors hover:bg-foreground/85"
        >
          Subscribe
        </button>
      </form>
      <p
        id="wishlist-form-message"
        class="min-h-[1.25rem] text-sm text-muted-foreground"
        role="status"
        aria-live="polite"
      >
      </p>
    </div>
  </Container>

  <Container class="flex flex-col gap-2 border-t border-border py-6 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
    <p>&copy; {year} {SITE_NAME}. All rights reserved.</p>
  </Container>
</footer>
