---
import Logo from "@/components/ui/Logo.astro";
import { getNav } from "@/data/nav";
import { APP_URL, APP_SIGNUP_URL } from "@/lib/constants";
import { getLang, translatePath, useTranslations } from "@/i18n";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { primaryNavLinks, helpLink } = getNav(lang);

// The switcher names the other language in its own tongue: a reader who
// can't read this page can still find the way out of it.
const otherLang = lang === "fr" ? "en" : "fr";
const switchHref = translatePath(Astro.url.pathname, otherLang);

/*
 * An edge-aligned bar on the page's own paper, not a floating glass pill:
 * the wordmark and the section links on the left, the way in on the right.
 * A hairline underneath is the only thing that separates it from the page.
 *
 * On a phone the section anchors are hidden rather than folded into a
 * burger menu. On a one-page site they are a convenience, not the
 * navigation: the page reads top to bottom, and the footer carries the same
 * four links for anyone who wants to jump. A drawer would cost a focus
 * trap, an escape handler and a scroll lock, and would push the CTA (the
 * one thing that has to stay reachable on a phone) off to the side.
 *
 * Which link is highlighted is set by nav-active.ts; without JS they are
 * still ordinary working anchors, just never highlighted.
 */
---

<header class="bar">
  <div class="wrap bar__inner">
    <div class="bar__left">
      <Logo iconClass="h-7 w-7 text-foreground" textClass="text-lg" />

      <nav aria-label={t("nav.sections")} class="bar__links" data-nav-links>
        {
          primaryNavLinks.map((link) => (
            <a href={link.href} class="nav-link">
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="bar__right">
      <a
        href={helpLink.href}
        class="nav-link nav-link--wide"
        aria-current={Astro.url.pathname.startsWith(helpLink.href) ? "page" : undefined}
      >
        {helpLink.label}
      </a>
      <a href={APP_URL} class="nav-link nav-link--wide">{t("nav.login")}</a>
      <a
        href={switchHref}
        class="nav-link nav-link--lang"
        hreflang={otherLang}
        lang={otherLang}
        aria-label={t("nav.switchTo")}
        title={t("nav.switchTo")}
        data-lang-switch={otherLang}
      >
        {otherLang.toUpperCase()}
      </a>
      <a href={APP_SIGNUP_URL} class="btn btn--sm" rel="noopener noreferrer">{t("nav.cta")}</a>
    </div>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky-nav);
    background: var(--color-paper);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    min-height: var(--nav-height);
  }

  .bar__left,
  .bar__right {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
  }

  .bar__right {
    gap: var(--space-lg);
  }

  .bar__links {
    display: none;
    align-items: center;
    gap: var(--space-lg);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
    transition:
      color var(--dur-short) var(--ease-out),
      text-decoration-color var(--dur-short) var(--ease-out);
  }

  .nav-link:hover {
    color: var(--color-ink);
  }

  .nav-link:active {
    color: var(--color-accent);
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 4px;
    border-radius: 2px;
    transition: none;
  }

  /* The current section (nav-active.ts) or the current page. */
  .nav-link[data-active],
  .nav-link[aria-current="page"] {
    color: var(--color-ink);
    text-decoration-color: var(--color-accent);
  }

  .nav-link--wide {
    display: none;
  }

  .nav-link--lang {
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  @media (min-width: 40rem) {
    .nav-link--wide {
      display: inline-flex;
    }
  }

  @media (min-width: 60rem) {
    .bar__links {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link {
      transition: none;
    }
  }
</style>
