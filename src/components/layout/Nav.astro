---
import Logo from "@/components/ui/Logo.astro";
import { getNav } from "@/data/nav";
import { APP_SIGNIN_URL, signupUrl } from "@/lib/constants";
import { getLang, stripLang, translatePath, useTranslations } from "@/i18n";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { primaryNavLinks } = getNav(lang);

// The switcher names the other language in its own tongue: a reader who
// can't read this page can still find the way out of it.
const otherLang = lang === "fr" ? "en" : "fr";
const switchHref = translatePath(Astro.url.pathname, otherLang);

// A link is current when the page is it, or sits under it
// (/use-cases/founders lights up "Use cases").
const here = stripLang(Astro.url.pathname).replace(/\/$/, "") || "/";
const isCurrent = (href: string) => {
  const target = stripLang(href).replace(/\/$/, "") || "/";
  return here === target || here.startsWith(`${target}/`);
};
const pageKey = here === "/" ? "home" : here.slice(1).replace(/\//g, "-");

/*
 * An edge-aligned bar on the page's own paper: the wordmark and four links
 * on the left, the way in on the right. Under 60rem the links fold into a
 * <details> menu: no script, no focus trap, and the sign-up button stays
 * on screen beside it.
 */
---

<header class="bar">
  <div class="wrap bar__inner">
    <div class="bar__left">
      <Logo iconClass="h-7 w-7 text-foreground" textClass="text-lg" />

      <nav aria-label={t("nav.primary")} class="bar__links">
        {
          primaryNavLinks.map((link) => (
            <a href={link.href} class="nav-link" aria-current={isCurrent(link.href) ? "page" : undefined}>
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="bar__right">
      <a href={APP_SIGNIN_URL} class="nav-link nav-link--wide">{t("nav.login")}</a>
      <a
        href={switchHref}
        class="nav-link nav-link--lang"
        hreflang={otherLang}
        lang={otherLang}
        aria-label={t("nav.switchTo")}
        title={t("nav.switchTo")}
        data-lang-switch={otherLang}
      >
        {otherLang.toUpperCase()}
      </a>
      <a
        href={signupUrl(pageKey, "nav")}
        class="btn btn--sm"
        rel="noopener noreferrer"
        data-cta="signup"
        data-cta-placement="nav"
      >
        <span class="cta-long">{t("nav.cta")}</span><span class="cta-short" aria-hidden="true">{t("nav.ctaShort")}</span>
      </a>

      <details class="menu">
        <summary class="menu__toggle" aria-label={t("nav.menu")}>
          <span class="menu__bars" aria-hidden="true"></span>
        </summary>
        <nav class="menu__panel" aria-label={t("nav.primary")}>
          {
            primaryNavLinks.map((link) => (
              <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
                {link.label}
              </a>
            ))
          }
          <a href={APP_SIGNIN_URL}>{t("nav.login")}</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky-nav);
    background: var(--color-paper);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    min-height: var(--nav-height);
  }

  .bar__left,
  .bar__right {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
  }

  .bar__right {
    gap: var(--space-md);
  }

  .bar__links {
    display: none;
    align-items: center;
    gap: var(--space-lg);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
    transition:
      color var(--dur-short) var(--ease-out),
      text-decoration-color var(--dur-short) var(--ease-out);
  }

  .nav-link:hover {
    color: var(--color-ink);
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 4px;
    border-radius: 2px;
    transition: none;
  }

  .nav-link[aria-current="page"] {
    color: var(--color-ink);
    text-decoration-color: var(--color-accent);
  }

  .nav-link--wide {
    display: none;
  }

  .nav-link--lang {
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .cta-short {
    display: none;
  }

  @media (max-width: 30rem) {
    .cta-long {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .cta-short {
      display: inline;
    }

    .bar__right {
      gap: var(--space-xs);
    }
  }

  /* Mobile menu */
  .menu {
    position: relative;
  }

  .menu__toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-inner);
    cursor: pointer;
    list-style: none;
  }

  .menu__toggle::-webkit-details-marker {
    display: none;
  }

  .menu__toggle:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .menu__bars,
  .menu__bars::before,
  .menu__bars::after {
    display: block;
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-ink);
  }

  .menu__bars {
    position: relative;
  }

  .menu__bars::before,
  .menu__bars::after {
    content: "";
    position: absolute;
    left: 0;
  }

  .menu__bars::before {
    top: -6px;
  }

  .menu__bars::after {
    top: 6px;
  }

  .menu__panel {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-xs));
    display: flex;
    flex-direction: column;
    min-width: 14rem;
    padding: var(--space-xs);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-card);
    background: var(--color-paper-3);
    box-shadow: 0 12px 32px -12px var(--color-shadow);
  }

  .menu__panel a {
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-inner);
    font-weight: 600;
    color: var(--color-ink);
  }

  .menu__panel a:hover,
  .menu__panel a[aria-current="page"] {
    background: var(--color-paper-2);
  }

  @media (min-width: 40rem) {
    .nav-link--wide {
      display: inline-flex;
    }
  }

  @media (min-width: 60rem) {
    .bar__links {
      display: flex;
    }

    .menu {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link {
      transition: none;
    }
  }
</style>
